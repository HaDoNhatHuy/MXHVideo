@model IEnumerable<Web_Video.ViewModels.Playlist.PlaylistDisplayViewModel>

@{
    ViewData["Title"] = "Danh sách phát của bạn";
    ViewData["CurrentPage"] = "Playlist";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="playlists-page">
    <div class="playlists-container">
        <!-- Header Section -->
        <div class="page-header">
            <h1 class="page-title">Danh sách phát</h1>
        </div>

        <!-- Playlists Grid -->
        <div id="playlistsContainer" class="playlists-grid">
            <div class="loading-wrapper" id="loadingIndicator">
                <div class="loading-spinner">
                    <svg class="spinner" viewBox="0 0 50 50">
                        <circle class="path" cx="25" cy="25" r="20" fill="none" stroke-width="4"></circle>
                    </svg>
                </div>
                <p class="loading-text">Đang tải...</p>
            </div>
        </div>
    </div>
</div>

@section Css {
    <style>
        /* Global Styles - YouTube Light Mode */
        .playlists-page {
            background: #FFFFFF;
            min-height: 100vh;
            padding: 24px 24px 48px;
        }

        .playlists-container {
            max-width: 1920px;
            margin: 0 auto;
        }

        /* Header - YouTube Style */
        .page-header {
            margin-bottom: 32px;
            padding: 0 0 24px 0;
            border-bottom: 1px solid #E5E5E5;
        }

        .page-title {
            font-size: 28px;
            font-weight: 400;
            color: #0F0F0F;
            margin: 0;
            letter-spacing: -0.5px;
        }

        /* Grid Layout - YouTube Library Style */
        .playlists-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
            row-gap: 32px;
        }

        /* Playlist Card - YouTube Style */
        .playlist-card {
            cursor: pointer;
            display: flex;
            flex-direction: column;
        }

        /* Thumbnail Container */
        .playlist-thumbnail {
            position: relative;
            width: 100%;
            border-radius: 12px;
            overflow: hidden;
            margin-bottom: 12px;
        }

            .playlist-thumbnail img {
                width: 100%;
                aspect-ratio: 16/9;
                object-fit: cover;
                display: block;
                background: #F1F1F1;
                transition: transform 0.2s ease;
            }

        .playlist-card:hover .playlist-thumbnail img {
            transform: scale(1.05);
        }

        /* Overlay Effects */
        .playlist-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.2s ease;
        }

        .playlist-card:hover .playlist-overlay {
            opacity: 1;
        }

        /* Video Count Badge */
        .playlist-count {
            position: absolute;
            top: 8px;
            right: 8px;
            background: rgba(0, 0, 0, 0.8);
            color: #FFFFFF;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 4px;
            backdrop-filter: blur(4px);
        }

            .playlist-count i {
                font-size: 11px;
            }

        /* Play Overlay - YouTube Style */
        .playlist-hover-info {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
        }

            .playlist-hover-info i {
                font-size: 48px;
                color: #FFFFFF;
            }

            .playlist-hover-info span {
                color: #FFFFFF;
                font-size: 14px;
                font-weight: 500;
                letter-spacing: 0.5px;
            }

        /* Playlist Info */
        .playlist-info {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .playlist-title {
            font-size: 14px;
            font-weight: 500;
            color: #0F0F0F;
            margin: 0;
            line-height: 20px;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            text-overflow: ellipsis;
            min-height: 40px;
        }

            .playlist-title a {
                text-decoration: none;
                color: inherit;
            }

                .playlist-title a:hover {
                    color: #0F0F0F;
                }

        .playlist-meta {
            font-size: 12px;
            color: #606060;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 4px;
            line-height: 18px;
        }

            .playlist-meta span {
                display: inline-block;
            }

        /* Action Button - YouTube Style */
        .view-playlist-btn {
            width: 100%;
            padding: 10px 16px;
            background: #FFFFFF;
            color: #065FD4 !important;
            border: 1px solid #CCCCCC;
            border-radius: 18px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.1s ease;
            margin-top: 8px;
            text-align: center;
        }

            .view-playlist-btn:hover {
                background: #DEF1FF;
                border-color: #065FD4;
            }

            .view-playlist-btn:active {
                background: #CCCCCC;
            }

        /* Loading State */
        .loading-wrapper {
            grid-column: 1 / -1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 80px 20px;
        }

        .loading-spinner {
            width: 48px;
            height: 48px;
            margin-bottom: 16px;
        }

        .spinner {
            animation: rotate 2s linear infinite;
        }

            .spinner .path {
                stroke: #065FD4;
                stroke-linecap: round;
                animation: dash 1.5s ease-in-out infinite;
            }

        @@keyframes rotate {
            100%

        {
            transform: rotate(360deg);
        }

        }

        @@keyframes dash {
            0%

        {
            stroke-dasharray: 1, 150;
            stroke-dashoffset: 0;
        }

        50% {
            stroke-dasharray: 90, 150;
            stroke-dashoffset: -35;
        }

        100% {
            stroke-dasharray: 90, 150;
            stroke-dashoffset: -124;
        }

        }

        .loading-text {
            color: #606060;
            font-size: 14px;
            margin: 0;
            font-weight: 400;
        }

        /* Empty State */
        .empty-state {
            grid-column: 1 / -1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 80px 20px;
        }

            .empty-state i {
                font-size: 64px;
                color: #CCCCCC;
                margin-bottom: 16px;
            }

            .empty-state p {
                color: #606060;
                font-size: 14px;
                margin: 0;
                font-weight: 400;
            }

        /* Error State */
        .error-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 40px 20px;
            background: #FEF2F2;
            border-radius: 8px;
            color: #DC2626;
            font-weight: 400;
            border: 1px solid #FEE2E2;
            font-size: 14px;
        }

            .error-state i {
                display: block;
                font-size: 48px;
                margin-bottom: 12px;
            }

        /* Responsive Design */
        @@media (max-width: 1200px) {
            .playlists-grid

        {
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        }

        }

        @@media (max-width: 992px) {
            .page-title

        {
            font-size: 24px;
        }

        .playlists-grid {
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 12px;
            row-gap: 24px;
        }

        }

        @@media (max-width: 768px) {
            .playlists-page

        {
            padding: 16px 16px 32px;
        }

        .page-header {
            margin-bottom: 24px;
            padding-bottom: 16px;
        }

        .page-title {
            font-size: 20px;
        }

        .playlists-grid {
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        }

        }

        @@media (max-width: 480px) {
            .playlists-grid

        {
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        }

        .page-title {
            font-size: 18px;
        }

        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            loadUserPlaylists();
        });

        function loadUserPlaylists() {
            const container = $('#playlistsContainer');
            const loading = $('#loadingIndicator');

            loading.show();
            container.empty().append(loading);

            $.ajax({
                url: "/Playlist/GetUserPlaylists",
                type: "GET",
                success: function (data) {
                    loading.hide();

                    if (data.isSuccess && data.result.length > 0) {
                        let html = '';

                        data.result.forEach(p => {
                            const videoCountText = p.videoCount === 1 ? '1 video' : `${p.videoCount} videos`;
                            const thumbnailUrl = p.firstVideoThumbnail || '/img/playlist_2.jpg';

                            html += `
                                <div class="playlist-card">
                                    <div class="playlist-thumbnail" onclick="location.href='/Playlist/WatchPlaylist/${p.id}'">
                                        <img src="${thumbnailUrl}" alt="${p.name}">
                                        <div class="playlist-count">
                                            <i class="fas fa-list"></i>
                                            <span>${p.videoCount}</span>
                                        </div>
                                        <div class="playlist-overlay">
                                            <div class="playlist-hover-info">
                                                <i class="fas fa-play-circle"></i>
                                                <span>PHÁT TẤT CẢ</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="playlist-info">
                                        <h3 class="playlist-title">
                                            <a href="/Playlist/WatchPlaylist/${p.id}">${p.name}</a>
                                        </h3>
                                        <p class="playlist-meta">
                                            <span>${videoCountText}</span>
                                            <span>•</span>
                                            <span>${p.createdAtTimeAgo}</span>
                                        </p>
                                        <button class="view-playlist-btn" onclick="event.stopPropagation(); location.href='/Playlist/FullList/${p.id}'">
                                            Xem toàn bộ danh sách
                                        </button>
                                    </div>
                                </div>
                            `;
                        });

                        container.html(html);
                    } else {
                        container.html(`
                            <div class="empty-state">
                                <i class="fas fa-list-ul"></i>
                                <p>Bạn chưa có danh sách phát nào.</p>
                            </div>
                        `);
                    }
                },
                error: function () {
                    loading.hide();
                    container.html('<div class="error-state"><i class="fas fa-exclamation-circle"></i>Lỗi khi tải danh sách phát. Vui lòng thử lại.</div>');
                }
            });
        }
    </script>
}