@model Web_Video.ViewModels.Playlist.PlaylistWatchViewModel

@{
    ViewData["Title"] = "Toàn bộ danh sách phát: " + Model.PlaylistInfo.Name;
    ViewData["CurrentPage"] = Model.PlaylistInfo.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="playlist-container">
    <div class="playlist-wrapper">
        <!-- Header Section -->
        <div class="playlist-header">
            <div class="playlist-info">
                <h1 class="playlist-title">@Model.PlaylistInfo.Name</h1>
                <div class="playlist-meta">
                    <span class="meta-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 6h18M3 12h18M3 18h18" />
                        </svg>
                        @Model.PlaylistInfo.VideoCount video
                    </span>
                    <span class="meta-divider">•</span>
                    <span class="meta-item">@Model.PlaylistInfo.CreatedAtTimeAgo</span>
                </div>
            </div>
        </div>

        <!-- Video List -->
        <div class="video-list">
            @{
                int index = 1;
            }
            @foreach (var item in Model.Items)
            {
                <div class="video-item" onclick="location.href='/Video/Watch/@item.VideoId'">
                    <div class="video-index">@index</div>
                    <div class="thumbnail-wrapper">
                        <img src="@(item.Thumbnail ?? "/default-thumbnail.jpg")"
                             alt="@item.Title"
                             class="thumbnail">
                        <div class="duration-badge">@item.Duration</div>
                    </div>
                    <div class="video-details">
                        <h3 class="video-title" title="@item.Title">@item.Title</h3>
                        <div class="video-meta">
                            <span class="channel-name">@item.ChannelName</span>
                        </div>
                    </div>
                    <!-- Nút Xóa (Hiển thị ngay cạnh item) -->
                    <button class="remove-playlist-item-btn"
                            data-video-id="@item.VideoId"
                            data-playlist-id="@Model.PlaylistInfo.Id"
                            data-title="@item.Title"
                            title="Xóa video khỏi Playlist">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                index++;
            }
        </div>
    </div>
</div>

@section Css {
    <style>
        /* Global Container - YouTube Style */
        .playlist-container {
            background: #FFFFFF;
            min-height: 100vh;
            padding: 24px 24px 48px;
        }

        .playlist-wrapper {
            max-width: 1280px;
            margin: 0 auto;
        }

        /* Header Section - YouTube Style */
        .playlist-header {
            background: #FFFFFF;
            padding: 0 0 24px 0;
            margin-bottom: 24px;
            border-bottom: 1px solid #E5E5E5;
        }

        .playlist-title {
            font-size: 24px;
            font-weight: 400;
            color: #0F0F0F;
            margin: 0 0 8px 0;
            line-height: 1.3;
            letter-spacing: -0.5px;
        }

        .playlist-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: #606060;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .meta-item svg {
                opacity: 0.7;
            }

        .meta-divider {
            color: #AAAAAA;
        }

        /* Video List - Vertical Layout */
        .video-list {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        /* Video Item - YouTube List Style */
        .video-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 8px;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.1s ease;
        }

            .video-item:hover {
                background: #F2F2F2;
            }

        /* Nút Xóa */
        .remove-playlist-item-btn {
            background: none;
            border: none;
            color: #606060;
            cursor: pointer;
            padding: 0 15px;
            font-size: 16px;
            transition: color 0.2s, transform 0.2s;
            height: 100%;
            display: flex;
            align-items: center;
            position: absolute; /* Đặt nút ở cuối wrapper */
            right: 0;
            z-index: 2; /* Đảm bảo nằm trên item video */
        }

            .remove-playlist-item-btn:hover {
                color: #ff0000;
                transform: scale(1.1);
            }
        /* Điều chỉnh Item khi có nút xóa */
        .video-info {
            flex-grow: 1;
            /* Đảm bảo nội dung không bị nút xóa che */
            margin-right: 50px;
        }
        /* Video Index Number */
        .video-index {
            flex-shrink: 0;
            width: 24px;
            font-size: 14px;
            font-weight: 400;
            color: #606060;
            text-align: center;
            padding-top: 8px;
            line-height: 20px;
        }

        /* Thumbnail */
        .thumbnail-wrapper {
            position: relative;
            flex-shrink: 0;
            width: 168px;
            border-radius: 8px;
            overflow: hidden;
        }

        .thumbnail {
            width: 100%;
            aspect-ratio: 16/9;
            object-fit: cover;
            display: block;
            background: #F1F1F1;
            transition: transform 0.2s ease;
        }

        .video-item:hover .thumbnail {
            transform: scale(1.05);
        }

        .duration-badge {
            position: absolute;
            bottom: 4px;
            right: 4px;
            background: rgba(0, 0, 0, 0.8);
            color: #FFFFFF;
            padding: 2px 4px;
            border-radius: 2px;
            font-size: 12px;
            font-weight: 500;
            letter-spacing: 0.5px;
            line-height: 12px;
        }

        /* Video Details */
        .video-details {
            flex: 1;
            min-width: 0;
            padding-top: 4px;
        }

        .video-title {
            font-size: 14px;
            font-weight: 500;
            color: #0F0F0F;
            margin: 0 0 4px 0;
            line-height: 20px;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            text-overflow: ellipsis;
            max-height: 40px;
        }

        .video-meta {
            font-size: 12px;
            color: #606060;
            line-height: 18px;
        }

        .channel-name {
            font-weight: 400;
        }

        /* Responsive Design */
        @@media (max-width: 992px) {
            .playlist-container

        {
            padding: 20px 16px 40px;
        }

        .playlist-title {
            font-size: 20px;
        }

        .thumbnail-wrapper {
            width: 148px;
        }

        }

        @@media (max-width: 768px) {
            .playlist-container

        {
            padding: 16px 12px 32px;
        }

        .playlist-header {
            padding: 0 0 16px 0;
            margin-bottom: 16px;
        }

        .playlist-title {
            font-size: 18px;
        }

        .playlist-meta {
            font-size: 13px;
        }

        .video-item {
            gap: 8px;
            padding: 6px;
        }

        .video-index {
            width: 20px;
            font-size: 13px;
        }

        .thumbnail-wrapper {
            width: 120px;
        }

        .video-title {
            font-size: 13px;
        }

        .video-meta {
            font-size: 11px;
        }

        }

        @@media (max-width: 480px) {
            .playlist-container

        {
            padding: 12px 8px 24px;
        }

        .playlist-title {
            font-size: 16px;
        }

        .video-item {
            flex-direction: column;
            gap: 8px;
        }

        .video-index {
            width: 100%;
            text-align: left;
            padding-top: 0;
        }

        .thumbnail-wrapper {
            width: 100%;
        }

        .video-details {
            padding-top: 0;
        }

        }
    </style>
}
@section Scripts {
    <script src="~/js/site.js"></script>
    <script>
        $(document).ready(function () {
            // Lắng nghe sự kiện click trên nút xóa
            $(document).on('click', '.remove-playlist-item-btn', async function (e) {
                e.preventDefault();
                e.stopPropagation(); // Rất quan trọng: Ngăn chặn kích hoạt sự kiện onclick của .video-item

                const $btn = $(this);
                const videoId = $btn.data('video-id');
                const playlistId = $btn.data('playlist-id');
                const videoTitle = $btn.data('title');
                const $itemWrapper = $btn.closest('.video-item-wrapper');
                const token = $('input[name="__RequestVerificationToken"]').val();

                // 1. Xác nhận xóa
                const confirmed = await confirmation(`Bạn có chắc chắn muốn xóa video "${videoTitle}" ra khỏi Danh sách phát này không?`);

                if (confirmed) {
                    // Tắt nút và hiện loading
                    $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                    // 2. Gọi API xóa [2]
                    $.ajax({
                        url: '/Playlist/RemoveVideoFromPlaylist',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ PlaylistId: playlistId, VideoId: videoId }),
                        headers: {
                            'RequestVerificationToken': token
                        },
                        success: function (response) {
                            if (response.isSuccess) {
                                displayNotification(true, response.title, response.message, 'toastr');

                                // 3. Xóa item khỏi DOM và cập nhật số lượng video
                                $itemWrapper.fadeOut(300, function() {
                                    $(this).remove();

                                    // Cập nhật số lượng video trong header
                                    const $countElement = $('.playlist-meta .meta-item:first-child');
                                    let currentCountText = $countElement.text().trim();
                                    const regex = /(\d+)/;
                                    const match = currentCountText.match(regex);
                                    if (match) {
                                        let currentCount = parseInt(match[4]);
                                        currentCount = Math.max(0, currentCount - 1); // Đảm bảo không âm
                                        $countElement.html(`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18" /></svg> ${currentCount} video`);
                                    }

                                    // Tải lại trang nếu không còn video nào (Tùy chọn)
                                    if ($('.video-item-wrapper').length === 0) {
                                        // window.location.reload();
                                        // Hoặc hiển thị thông báo "Danh sách rỗng"
                                    }
                                });
                            } else {
                                displayNotification(false, 'Lỗi', response.message, 'toastr');
                                $btn.prop('disabled', false).html('<i class="fas fa-times"></i>');
                            }
                        },
                        error: function () {
                            displayNotification(false, 'Lỗi', 'Không thể xóa video khỏi Playlist. Lỗi kết nối server.', 'toastr');
                            $btn.prop('disabled', false).html('<i class="fas fa-times"></i>');
                        }
                    });
                }
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}