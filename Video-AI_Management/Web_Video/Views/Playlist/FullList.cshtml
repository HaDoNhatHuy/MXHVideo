@model Web_Video.ViewModels.Playlist.PlaylistWatchViewModel

@{
    ViewData["Title"] = "Toàn bộ danh sách phát: " + Model.PlaylistInfo.Name;
    ViewData["CurrentPage"] = Model.PlaylistInfo.Name;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="playlist-container">
    <div class="playlist-wrapper">
        <!-- Header Section -->
        <div class="playlist-header">
            <div class="playlist-info">
                <h1 class="playlist-title">@Model.PlaylistInfo.Name</h1>
                <div class="playlist-meta">
                    <span class="meta-item">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M3 6h18M3 12h18M3 18h18" />
                        </svg>
                        @Model.PlaylistInfo.VideoCount video
                    </span>
                    <span class="meta-divider">•</span>
                    <span class="meta-item">@Model.PlaylistInfo.CreatedAtTimeAgo</span>
                </div>
            </div>
            <!-- THÊM NÚT XÓA TẠI ĐÂY -->
            <div class="playlist-actions-full mt-3">
                @* LƯU Ý: Nút này chỉ hiển thị trên trang FullList (grid view) *@
                <button id="deletePlaylistBtn"
                        class="btn btn-danger btn-sm rounded-pill"
                        data-playlist-id="@Model.PlaylistInfo.Id"
                        data-playlist-name="@Model.PlaylistInfo.Name">
                    <i class="fas fa-trash me-1"></i> Xóa Toàn Bộ Playlist
                </button>
            </div>
        </div>

        <!-- Video List -->
        <div class="video-list">
            @{
                int index = 1;
            }
            @foreach (var item in Model.Items)
            {
                <div class="video-item">
                    <div class="video-clickable" onclick="location.href='/Video/Watch/@item.VideoId'">
                        <div class="video-index">@index</div>
                        <div class="thumbnail-wrapper">
                            <img src="@(item.Thumbnail ?? "/default-thumbnail.jpg")"
                                 alt="@item.Title"
                                 class="thumbnail">
                            <div class="duration-badge">@item.Duration</div>
                        </div>
                        <div class="video-details">
                            <h3 class="video-title" title="@item.Title">@item.Title</h3>
                            <div class="video-meta">
                                <span class="channel-name">@item.ChannelName</span>
                            </div>
                        </div>
                    </div>
                    <!-- Nút Xóa (Redesigned) -->
                    <button class="remove-playlist-item-btn"
                            data-video-id="@item.VideoId"
                            data-playlist-id="@Model.PlaylistInfo.Id"
                            data-title="@item.Title"
                            title="Xóa khỏi danh sách phát">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2M10 11v6M14 11v6" />
                        </svg>
                    </button>
                </div>
                index++;
            }
        </div>
    </div>
</div>

@section Css {
    <style>
        /* Global Container - YouTube Style */
        .playlist-container {
            background: #FFFFFF;
            min-height: 100vh;
            padding: 24px 24px 48px;
        }

        .playlist-wrapper {
            max-width: 1280px;
            margin: 0 auto;
        }

        /* Header Section - YouTube Style */
        .playlist-header {
            background: #FFFFFF;
            padding: 0 0 24px 0;
            margin-bottom: 24px;
            border-bottom: 1px solid #E5E5E5;
        }

        .playlist-title {
            font-size: 24px;
            font-weight: 400;
            color: #0F0F0F;
            margin: 0 0 8px 0;
            line-height: 1.3;
            letter-spacing: -0.5px;
        }

        .playlist-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            color: #606060;
        }

        .meta-item {
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .meta-item svg {
                opacity: 0.7;
            }

        .meta-divider {
            color: #AAAAAA;
        }

        /* Video List - Vertical Layout */
        .video-list {
            display: flex;
            flex-direction: column;
            gap: 0;
        }

        /* Video Item - YouTube List Style */
        /* Video Item - YouTube List Style */
        .video-item {
            display: flex;
            align-items: center;
            gap: 0;
            padding: 8px;
            border-radius: 12px;
            transition: background-color 0.15s ease;
            position: relative;
        }

            .video-item:hover {
                background: #F2F2F2;
            }

        /* Wrapper cho phần có thể click */
        .video-clickable {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            flex: 1;
            cursor: pointer;
            min-width: 0;
        }

        /* Nút Xóa - Redesigned */
        .remove-playlist-item-btn {
            background: transparent;
            border: none;
            color: #606060;
            cursor: pointer;
            padding: 8px 12px;
            margin-left: 8px;
            border-radius: 50%;
            font-size: 16px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transform: scale(0.9);
            flex-shrink: 0;
            z-index: 10; /* THÊM dòng này */
            position: relative; /* THÊM dòng này */
        }

        .video-item:hover .remove-playlist-item-btn {
            opacity: 1;
            transform: scale(1);
        }

        .remove-playlist-item-btn:hover {
            background: #FF0000;
            color: #FFFFFF;
            transform: scale(1.1);
        }

        .remove-playlist-item-btn:active {
            transform: scale(0.95);
        }

        .remove-playlist-item-btn svg {
            transition: transform 0.2s ease;
        }

        .remove-playlist-item-btn:hover svg {
            transform: rotate(5deg);
        }

        /* Xóa các style cũ không cần thiết */
        .video-info {
            /* Xóa hoặc comment phần này */
        }

        /* Điều chỉnh Item khi có nút xóa */
        .video-info {
            flex-grow: 1;
            /* Đảm bảo nội dung không bị nút xóa che */
            margin-right: 50px;
        }
        /* Video Index Number */
        .video-index {
            flex-shrink: 0;
            width: 24px;
            font-size: 14px;
            font-weight: 400;
            color: #606060;
            text-align: center;
            padding-top: 8px;
            line-height: 20px;
        }

        /* Thumbnail */
        .thumbnail-wrapper {
            position: relative;
            flex-shrink: 0;
            width: 168px;
            border-radius: 8px;
            overflow: hidden;
        }

        .thumbnail {
            width: 100%;
            aspect-ratio: 16/9;
            object-fit: cover;
            display: block;
            background: #F1F1F1;
            transition: transform 0.2s ease;
        }

        .video-item:hover .thumbnail {
            transform: scale(1.05);
        }

        .duration-badge {
            position: absolute;
            bottom: 4px;
            right: 4px;
            background: rgba(0, 0, 0, 0.8);
            color: #FFFFFF;
            padding: 2px 4px;
            border-radius: 2px;
            font-size: 12px;
            font-weight: 500;
            letter-spacing: 0.5px;
            line-height: 12px;
        }

        /* Video Details */
        .video-details {
            flex: 1;
            min-width: 0;
            padding-top: 4px;
        }

        .video-title {
            font-size: 14px;
            font-weight: 500;
            color: #0F0F0F;
            margin: 0 0 4px 0;
            line-height: 20px;
            overflow: hidden;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            text-overflow: ellipsis;
            max-height: 40px;
        }

        .video-meta {
            font-size: 12px;
            color: #606060;
            line-height: 18px;
        }

        .channel-name {
            font-weight: 400;
        }

        /* Responsive Design */
        @@media (max-width: 992px) {
            .playlist-container {
                padding: 20px 16px 40px;
            }

            .playlist-title {
                font-size: 20px;
            }

            .thumbnail-wrapper {
                width: 148px;
            }
        }

        @@media (max-width: 768px) {
            .playlist-container {
                padding: 16px 12px 32px;
            }

            .playlist-header {
                padding: 0 0 16px 0;
                margin-bottom: 16px;
            }

            .playlist-title {
                font-size: 18px;
            }

            .playlist-meta {
                font-size: 13px;
            }

            .video-item {
                gap: 8px;
                padding: 6px;
            }

            .video-index {
                width: 20px;
                font-size: 13px;
            }

            .thumbnail-wrapper {
                width: 120px;
            }

            .video-title {
                font-size: 13px;
            }

            .video-meta {
                font-size: 11px;
            }
        }

        @@media (max-width: 480px) {
            .playlist-container {
                padding: 12px 8px 24px;
            }

            .playlist-title {
                font-size: 16px;
            }

            .video-item {
                flex-direction: column;
                gap: 8px;
            }

            .video-index {
                width: 100%;
                text-align: left;
                padding-top: 0;
            }

            .thumbnail-wrapper {
                width: 100%;
            }

            .video-details {
                padding-top: 0;
            }
        }
    </style>
}
@section Scripts {
    <script src="~/js/site.js"></script>
    <script>
        function displayNotification(isSuccess, title, message, type) {
            alert(`${title}: ${message}`);
        }

        async function confirmation(message) {
            return new Promise((resolve) => {
                const result = window.confirm(message);
                resolve(result);
            });
        }
        $(document).ready(function () {

            $('#deletePlaylistBtn').on('click', function(e) {
            e.preventDefault();
            // QUAN TRỌNG: Ngăn chặn bất kỳ sự kiện nào khác chạy
            e.stopImmediatePropagation();

            const $btn = $(this);
            const playlistId = $btn.data('playlist-id');
            const playlistName = $btn.data('playlist-name');
            const token = $('input[name="__RequestVerificationToken"]').val();

            if (!token) {
                 displayNotification(false, 'Lỗi', 'Không tìm thấy Anti-Forgery Token. Đảm bảo bạn có @Html.AntiForgeryToken() trong View.', 'toastr');
                 return;
            }

            confirmation(`CẢNH BÁO: Bạn có chắc chắn muốn xóa vĩnh viễn Playlist "${playlistName}" không?`)
                .then(function(confirmed) {
                    if (confirmed) {
                        const originalHtml = $btn.html();
                        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Đang xóa...');

                        // GỌI API XÓA PLAYLIST
                        $.ajax({
                            url: '/Playlist/DeletePlaylist/' + playlistId,
                            type: 'POST',
                            // Cần phải gửi Anti-Forgery Token qua Header
                            headers: {
                                'RequestVerificationToken': token
                            },
                            // Thiết lập dataType để jQuery biết phản hồi phải là JSON
                            dataType: 'json',
                            success: function (response) {
                                if (response && response.statusCode === 200) {
                                    displayNotification(true, response.title, response.message, 'toastr');
                                    // Chuyển hướng sau khi xóa thành công
                                    setTimeout(() => {
                                        window.location.href = '/Playlist/Index';
                                    }, 1000);
                                } else {
                                    displayNotification(false, 'Lỗi', response.message || 'Lỗi server không xác định.', 'toastr');
                                    $btn.prop('disabled', false).html(originalHtml);
                                }
                            },
                            error: function (xhr, status, error) {
                                // Xử lý lỗi 500 hoặc lỗi mạng
                                let msg = 'Lỗi kết nối hoặc Server gặp sự cố (500 Internal Error).';
                                if (xhr.status === 404) {
                                    msg = 'Lỗi: Không tìm thấy Playlist.';
                                } else if (xhr.responseText && xhr.responseText.includes('The required anti-forgery cookie')) {
                                    msg = 'Lỗi bảo mật: Thiếu Anti-Forgery Token.';
                                }
                                displayNotification(false, 'Lỗi Xóa Playlist', msg, 'toastr');
                                $btn.prop('disabled', false).html(originalHtml);
                            }
                        });
                    }
                });
        });

            // Ngăn chặn sự kiện click lan truyền từ nút xóa
            $(document).on('click', '.remove-playlist-item-btn', function (e) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation(); // QUAN TRỌNG: Thêm dòng này

                const $btn = $(this);
                const videoId = $btn.data('video-id');
                const playlistId = $btn.data('playlist-id');
                const videoTitle = $btn.data('title');
                const $itemWrapper = $btn.closest('.video-item');
                const token = $('input[name="__RequestVerificationToken"]').val();

                // 1. Xác nhận xóa
                confirmation(`Bạn có chắc chắn muốn xóa video "${videoTitle}" ra khỏi Danh sách phát này không?`)
                    .then(function(confirmed) {
                        if (confirmed) {
                            // Tắt nút và hiện loading
                            $btn.prop('disabled', true).html('<svg width="20" height="20" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2" fill="none" stroke-dasharray="31.4" stroke-dashoffset="10"><animateTransform attributeName="transform" type="rotate" from="0 12 12" to="360 12 12" dur="1s" repeatCount="indefinite"/></circle></svg>');

                            // 2. Gọi API xóa
                            $.ajax({
                                url: '/Playlist/RemoveVideoFromPlaylist',
                                type: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify({ PlaylistId: playlistId, VideoId: videoId }),
                                headers: {
                                    'RequestVerificationToken': token
                                },
                                success: function (response) {
                                    if (response.isSuccess) {
                                        displayNotification(true, response.title, response.message, 'toastr');

                                        // 3. Xóa item khỏi DOM
                                        $itemWrapper.fadeOut(300, function() {
                                            $(this).remove();

                                            // Cập nhật lại số thứ tự
                                            $('.video-item').each(function(idx) {
                                                $(this).find('.video-index').text(idx + 1);
                                            });

                                            // Cập nhật số lượng video trong header
                                            const $countElement = $('.playlist-meta .meta-item:first-child');
                                            let currentCountText = $countElement.text().trim();
                                            const regex = /(\d+)/;
                                            const match = currentCountText.match(regex);
                                            if (match) {
                                                let currentCount = parseInt(match[1]);
                                                currentCount = Math.max(0, currentCount - 1);
                                                $countElement.html(`<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18" /></svg> ${currentCount} video`);
                                            }

                                            // Kiểm tra nếu không còn video
                                            if ($('.video-item').length === 0) {
                                                $('.video-list').html('<div style="text-align:center;padding:40px;color:#606060;">Danh sách phát trống</div>');
                                            }
                                        });
                                    } else {
                                        displayNotification(false, 'Lỗi', response.message, 'toastr');
                                        $btn.prop('disabled', false).html('<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2M10 11v6M14 11v6" /></svg>');
                                    }
                                },
                                error: function () {
                                    displayNotification(false, 'Lỗi', 'Không thể xóa video khỏi Playlist. Lỗi kết nối server.', 'toastr');
                                    $btn.prop('disabled', false).html('<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2M10 11v6M14 11v6" /></svg>');
                                }
                            });
                        }
                    });
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}