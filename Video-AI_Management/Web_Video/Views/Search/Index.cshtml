@model Web_Video.Controllers.SearchController.SearchViewModel
@{
    ViewData["Title"] = "Kết quả tìm kiếm";
    ViewData["CurrentPage"] = "Search";
    bool isFallback = ViewBag.IsFallback ?? false;
    bool isFuzzyMatch = ViewBag.IsFuzzyMatch ?? false;
    string currentUploadTime = ViewData["UploadTime"] as string ?? "any";
    string currentDuration = ViewData["Duration"] as string ?? "any";
    bool filtersApplied = currentUploadTime != "any" || currentDuration != "any";

    var uploadTimeLabels = new Dictionary<string, string>
    {
        { "any", "Thời gian đăng tải" },
        { "last_hour", "Giờ trước" },
        { "today", "Hôm nay" },
        { "this_week", "Tuần này" },
        { "this_month", "Tháng này" },
        { "this_year", "Năm nay" }
    };

    var durationLabels = new Dictionary<string, string>
    {
        { "any", "Thời lượng" },
        { "short", "Ngắn (< 4 phút)" },
        { "medium", "Trung bình (4-20 phút)" },
        { "long", "Dài (> 20 phút)" }
    };

    string displayUploadTime = uploadTimeLabels.ContainsKey(currentUploadTime)
        ? uploadTimeLabels[currentUploadTime] : uploadTimeLabels["any"];
    string displayDuration = durationLabels.ContainsKey(currentDuration)
        ? durationLabels[currentDuration] : durationLabels["any"];
}

@section Css {
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="/css/youtube-search.css" rel="stylesheet" />
    <style>
        /* Loading Skeleton Styles */
        .skeleton {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: loading 1.5s infinite;
        }

        @@keyframes loading {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }

        .skeleton-text {
            border-radius: 4px;
            margin-bottom: 8px;
        }

        .skeleton-button {
            border-radius: 20px;
            display: inline-block;
            margin-right: 8px;
        }

        .skeleton-thumbnail {
            width: 100%;
            height: 200px;
            border-radius: 12px;
            margin-bottom: 12px;
        }

        /* Smooth image loading */
        img {
            transition: opacity 0.3s ease;
        }

            img:not(.loaded) {
                opacity: 0.5;
            }

            img.loaded {
                opacity: 1;
            }

        .dropdown-item.active {
            background-color: transparent !important;
            color: #007bff !important;
            font-weight: 600;
        }
    </style>
}

<!-- Loading Skeleton cho khi đang tải -->
<div id="searchLoadingSkeleton" style="display: none;">
    <div class="search-header">
        <div class="skeleton skeleton-text" style="width: 60%; height: 24px;"></div>
    </div>
    <div class="search-filters mb-4">
        <div class="skeleton skeleton-button" style="width: 80px; height: 32px;"></div>
    </div>
    <div class="video-card">
        <div class="skeleton skeleton-thumbnail"></div>
        <div class="video-details">
            <div class="skeleton skeleton-text" style="width: 80%; height: 20px; margin-bottom: 10px;"></div>
            <div class="skeleton skeleton-text" style="width: 50%; height: 16px; margin-bottom: 10px;"></div>
            <div class="skeleton skeleton-text" style="width: 60%; height: 16px;"></div>
        </div>
    </div>
</div>

<div class="youtube-search-results" id="searchResults">
    <div class="search-header">
        <h6 class="search-query-text">
            @if (isFallback)
            {
                <span>
                    <i class="fas fa-search me-2"></i> Không tìm thấy kết quả chính xác cho:
                    <span class="search-query-highlight">"@ViewData["Query"]"</span>
                </span>
                @if (filtersApplied)
                {
                    <small class="text-info d-block">
                        <i class="fas fa-info-circle"></i> Bạn đã áp dụng bộ lọc.
                        <a href="#" id="quickRemoveFilters" class="text-primary">Xóa bộ lọc</a> để xem nhiều kết quả hơn.
                    </small>
                }
            }
            else if (isFuzzyMatch)
            {
                <span>
                    <i class="fas fa-magic me-2"></i> Kết quả gần đúng cho:
                    <span class="font-weight-bold text-primary">"@ViewData["Query"]"</span>
                </span>
                <small class="text-info d-block">
                    <i class="fas fa-lightbulb"></i> Có thể bạn muốn tìm: <strong>@ViewData["Query"]</strong>
                </small>
            }
            else
            {
                <span>
                    Kết quả tìm kiếm cho:
                    <span class="search-query-highlight">"@ViewData["Query"]"</span>
                </span>
            }
        </h6>
    </div>

    <div class="search-filters mb-4">
        <button class="btn btn-sm btn-outline-secondary me-2 filter-toggle-btn" id="filterToggleBtn">
            <i class="fas fa-filter me-1"></i> Lọc
        </button>

        <div id="filterDropdownContainer" class="d-inline-flex gap-3" style="@(filtersApplied ? "display: inline-flex !important;" : "display: none;")">
            <div class="dropdown">
                <button class="btn btn-sm btn-light dropdown-toggle" type="button" id="uploadTimeFilter" data-toggle="dropdown">
                    @displayUploadTime
                </button>
                <ul class="dropdown-menu">
                    @foreach (var option in uploadTimeLabels)
                    {
                        <li>
                            <a class="dropdown-item filter-option @(currentUploadTime == option.Key ? "active text-primary" : "")"
                               href="#" data-filter-type="uploadTime" data-filter-value="@option.Key">
                                @option.Value
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <div class="dropdown">
                <button class="btn btn-sm btn-light dropdown-toggle" type="button" id="durationFilter" data-toggle="dropdown">
                    @displayDuration
                </button>
                <ul class="dropdown-menu">
                    @foreach (var option in durationLabels)
                    {
                        <li>
                            <a class="dropdown-item filter-option @(currentDuration == option.Key ? "active text-primary" : "")"
                               href="#" data-filter-type="duration" data-filter-value="@option.Key">
                                @option.Value
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <button class="btn btn-sm btn-outline-danger" id="resetFiltersBtn">
                <i class="fas fa-times me-1"></i> Xóa bộ lọc
            </button>
        </div>
    </div>

    @if (Model.Channels != null && Model.Channels.Any())
    {
        <div id="channelResults" class="mb-4">
            <h6 class="search-section-title"><i class="fas fa-users me-2"></i>Kênh</h6>
            @foreach (var channel in Model.Channels)
            {
                <div class="channel-card">
                    <div class="channel-avatar-container">
                        <a href="/Member/Channel/@channel.Id">
                            <img src="@(channel.ChannelPicture ?? "/avatarUser/avt-default.jpg")"
                                 alt="@channel.ChannelName" loading="lazy">
                        </a>
                    </div>
                    <div class="channel-details">
                        <a href="/Member/Channel/@channel.Id" class="channel-name">@channel.ChannelName</a>
                        <div class="channel-subscribers">
                            @channel.Subscribers.Count() người đăng ký • @channel.Videos.Count() video
                        </div>
                        <p class="channel-description">@channel.About</p>
                    </div>
                    <div>
                        <a href="/Member/Channel/@channel.Id" class="btn btn-danger">Đăng ký</a>
                    </div>
                </div>
            }
        </div>
    }

    <div id="videoResults">
        @if (Model.Videos != null && Model.Videos.Any())
        {
            @foreach (var video in Model.Videos)
            {
                <div class="video-card">
                    <div class="video-thumbnail-container">
                        <a href="/Video/Watch/@video.Id">
                            <img src="@(video.Thumbnail ?? "/img/default-thumbnail.jpg")"
                                 alt="@video.Title" loading="lazy">
                        </a>
                        <span class="video-duration">@(video.Duration ?? "0:00")</span>
                    </div>
                    <div class="video-details">
                        <h5 class="video-title">
                            <a href="/Video/Watch/@video.Id">@video.Title</a>
                        </h5>
                        <div class="video-metadata">
                            <span>@(video.Views ?? 0) lượt xem</span>
                            <span class="metadata-separator">•</span>
                            <span>@WebVideo.Utility.SD.TimeAgo(video.UploadDate)</span>
                        </div>
                        <div class="channel-info">
                            <img src="@(video.Channel?.ChannelPicture ?? "/avatarUser/avt-default.jpg")"
                                 alt="@(video.Channel?.ChannelName)" loading="lazy">
                            <a href="/Member/Channel/@(video.Channel?.Id)">
                                @(video.Channel?.ChannelName)
                            </a>
                        </div>
                        <p class="video-description">
                            @(video.Description?.Length > 150 ? video.Description.Substring(0, 150) + "..." : video.Description)
                        </p>
                    </div>
                </div>
            }
        }
        else if (!isFallback && (Model.Channels == null || !Model.Channels.Any()))
        {
            <div class="no-results">
                <div class="no-results-icon">
                    <i class="fas fa-search"></i>
                </div>
                <h3 class="no-results-title">Không tìm thấy kết quả</h3>
                <p class="no-results-text">Không tìm thấy video nào khớp với từ khóa của bạn.</p>
                <div class="no-results-suggestions">
                    <p><strong>Gợi ý:</strong></p>
                    <ul>
                        <li>Kiểm tra chính tả từ khóa</li>
                        <li>Thử sử dụng từ khóa khác</li>
                        <li>Thử sử dụng từ khóa tổng quát hơn</li>
                        <li>Xóa bộ lọc để mở rộng kết quả</li>
                    </ul>
                </div>
            </div>
        }
    </div>

    @if (Model.RecommendedVideos != null && Model.RecommendedVideos.Any())
    {
        <div class="mt-5 pt-3 border-top">
            <h5>
                @if (isFallback)
                {
                    <i class="fas fa-video me-2"></i>

                    <span>Video đề xuất cho bạn</span>
                }
                else
                {
                    <i class="fas fa-thumbs-up me-2"></i>

                    <span>Có thể bạn cũng thích</span>
                }
            </h5>
            <div class="row">
                @foreach (var video in Model.RecommendedVideos)
                {
                    <div class="col-xl-3 col-lg-4 col-sm-6 mb-4">
                        <div class="video-card">
                            <div class="video-card-image">
                                <a href="/Video/Watch/@video.Id">
                                    <img src="@(video.Thumbnail ?? "/img/default-thumbnail.jpg")"
                                         alt="@video.Title" loading="lazy">
                                </a>
                                <span class="time">@(video.Duration ?? "0:00")</span>
                            </div>
                            <div class="video-card-body">
                                <img src="@(video.Channel?.ChannelPicture ?? "/avatarUser/avt-default.jpg")"
                                     alt="@(video.Channel?.ChannelName)" loading="lazy">
                                <div class="video-info">
                                    <div class="video-title">
                                        <a href="/Video/Watch/@video.Id">@video.Title</a>
                                    </div>
                                    <div class="video-page">
                                        <a href="/Member/Channel/@(video.Channel?.Id)">
                                            @(video.Channel?.ChannelName)
                                        </a>
                                    </div>
                                    <div class="video-view">
                                        @(video.Views ?? 0) lượt xem • @WebVideo.Utility.SD.TimeAgo(video.UploadDate)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const currentQuery = '@Html.Raw(ViewData["Query"])';
            let currentUploadTime = '@Html.Raw(currentUploadTime)';
            let currentDuration = '@Html.Raw(currentDuration)';
            const $filterContainer = $('#filterDropdownContainer');

            // Toggle filter
            $('#filterToggleBtn').on('click', function() {
                if ($filterContainer.is(':hidden')) {
                    $filterContainer.css('display', 'inline-flex');
                } else {
                    $filterContainer.hide();
                }
            });

            // Apply filter
            $('.filter-option').on('click', function(e) {
                e.preventDefault();
                const type = $(this).data('filter-type');
                const value = $(this).data('filter-value');

                if (type === 'uploadTime') currentUploadTime = value;
                if (type === 'duration') currentDuration = value;

                performSearch();
            });

            // Reset filter
            $('#resetFiltersBtn, #quickRemoveFilters').on('click', function(e) {
                e.preventDefault();
                currentUploadTime = 'any';
                currentDuration = 'any';
                performSearch();
            });

            function performSearch() {
                // Show loading skeleton
                $('#searchLoadingSkeleton').show();
                $('#searchResults').hide();

                const params = new URLSearchParams();
                if (currentQuery) params.set('query', currentQuery);
                if (currentUploadTime !== 'any') params.set('uploadTime', currentUploadTime);
                if (currentDuration !== 'any') params.set('duration', currentDuration);

                window.location.href = `/Search?${params.toString()}`;
            }

            // Lazy loading images
            if ('IntersectionObserver' in window) {
                const imageObserver = new IntersectionObserver((entries, observer) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const img = entry.target;
                            img.src = img.dataset.src || img.src;
                            img.classList.add('loaded');
                            observer.unobserve(img);
                        }
                    });
                });

                document.querySelectorAll('img[loading="lazy"]').forEach(img => {
                    imageObserver.observe(img);
                });
            }
        });
    </script>
}
