@model List<Database_Video.Entities.Video>
@{
    ViewData["Title"] = "Kết quả tìm kiếm";
    ViewData["CurrentPage"] = "Search";
}

@section Css {
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        /* VIDOE template style search results */
        .youtube-search-results {
            max-width: 1280px;
            margin: 0 auto;
            padding: 24px 24px 80px;
            background-color: #fff;
            min-height: 100vh;
        }

        .search-header {
            margin-bottom: 24px;
            border-bottom: 1px solid #e0e0e0;
            padding-bottom: 16px;
        }

        .search-query-text {
            font-size: 18px;
            font-weight: 400;
            color: #212121;
            margin: 0;
        }

        .search-query-highlight {
            font-weight: 600;
        }

        .video-card {
            display: flex;
            gap: 16px;
            margin-bottom: 24px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .video-card:hover .video-thumbnail-container {
                border-radius: 12px;
            }

            .video-card:hover .video-title a {
                color: #065fd4;
            }

        .video-thumbnail-container {
            position: relative;
            flex-shrink: 0;
            width: 360px;
            height: 202px;
            border-radius: 12px;
            overflow: hidden;
            background-color: #e0e0e0;
        }

            .video-thumbnail-container img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.2s ease;
            }

        .video-card:hover .video-thumbnail-container img {
            transform: scale(1.05);
        }

        .video-duration {
            position: absolute;
            bottom: 8px;
            right: 8px;
            background-color: rgba(0, 0, 0, 0.8);
            color: #fff;
            padding: 3px 4px;
            border-radius: 2px;
            font-size: 12px;
            font-weight: 500;
            line-height: 12px;
        }

        .play-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: rgba(0, 0, 0, 0);
            transition: background-color 0.2s ease;
            opacity: 0;
        }

        .video-card:hover .play-overlay {
            background-color: rgba(0, 0, 0, 0.3);
            opacity: 1;
        }

        .play-overlay i {
            font-size: 48px;
            color: rgba(255, 255, 255, 0.9);
        }

        .video-details {
            flex: 1;
            min-width: 0;
        }

        .video-title {
            margin-bottom: 6px;
        }

            .video-title a {
                font-size: 18px;
                font-weight: 500;
                line-height: 26px;
                color: #212121;
                text-decoration: none;
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
                transition: color 0.2s ease;
            }

        .video-metadata {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 14px;
            color: #606060;
            margin-bottom: 12px;
        }

        .metadata-separator {
            margin: 0 4px;
        }

        .channel-info {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }

        .channel-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            overflow: hidden;
            flex-shrink: 0;
            background-color: #e0e0e0;
        }

            .channel-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .channel-name {
            font-size: 14px;
            color: #606060;
            text-decoration: none;
            transition: color 0.2s ease;
        }

            .channel-name:hover {
                color: #212121;
            }

        .video-description {
            font-size: 14px;
            line-height: 20px;
            color: #606060;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            margin-top: 8px;
        }

        .no-results {
            text-align: center;
            padding: 80px 20px;
        }

        .no-results-icon {
            font-size: 120px;
            color: #757575;
            margin-bottom: 24px;
        }

        .no-results-title {
            font-size: 20px;
            color: #212121;
            margin-bottom: 8px;
        }

        .no-results-text {
            font-size: 14px;
            color: #606060;
            line-height: 20px;
        }

        .no-results-suggestions {
            margin-top: 24px;
            text-align: left;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

            .no-results-suggestions ul {
                list-style: none;
                padding: 0;
                color: #606060;
                font-size: 14px;
            }

            .no-results-suggestions li {
                padding: 4px 0;
                padding-left: 20px;
                position: relative;
            }

                .no-results-suggestions li:before {
                    content: "•";
                    position: absolute;
                    left: 0;
                }

        /* Responsive */
        @@media (max-width: 1024px) {
            .video-thumbnail-container

        {
            width: 320px;
            height: 180px;
        }

        }

        @@media (max-width: 768px) {
            .youtube-search-results

        {
            padding: 16px;
        }

        .video-card {
            flex-direction: column;
            gap: 12px;
        }

        .video-thumbnail-container {
            width: 100%;
            height: auto;
            aspect-ratio: 16 / 9;
        }

        .channel-info {
            margin-bottom: 0;
        }

        .video-description {
            display: none;
        }

        }
    </style>
}

<div class="youtube-search-results">
    <div class="search-header">
        <h6 class="search-query-text">
            Kết quả tìm kiếm cho: <span class="search-query-highlight">"@ViewData["Query"]"</span>
        </h6>
    </div>

    @if (Model.Any())
    {
        <div class="search-results-list">
            @foreach (var video in Model)
            {
                <div class="video-card">
                    <div class="video-thumbnail-container">
                        <a asp-controller="Video" asp-action="Watch" asp-route-id="@video.Id">
                            <img src="@video.Thumbnail" alt="@video.Title">
                        </a>
                        <div class="video-duration">10:24</div>
                        <div class="play-overlay">
                            <a asp-controller="Video" asp-action="Watch" asp-route-id="@video.Id">
                                <i class="fas fa-play-circle"></i>
                            </a>
                        </div>
                    </div>
                    <div class="video-details">
                        <div class="video-title">
                            <a asp-controller="Video" asp-action="Watch" asp-route-id="@video.Id">
                                @video.Title
                            </a>
                        </div>
                        <div class="video-metadata">
                            <span>@(video.Views?.ToString("N0") ?? "0") lượt xem</span>
                            <span class="metadata-separator">•</span>
                            <span>@video.UploadDate.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="channel-info">
                            <div class="channel-avatar">
                                <img src="@(video.Channel?.ChannelPicture ?? "/avatarUser/avt-default.jpg")"
                                     alt="@(video.Channel?.ChannelName ?? "Không xác định")">
                            </div>
                            <a href="#" class="channel-name">
                                @(video.Channel?.ChannelName ?? "Không xác định")
                            </a>
                        </div>
                        <div class="video-description">
                            @(video.Description ?? "")
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="no-results">
            <div class="no-results-icon">
                <i class="fas fa-search"></i>
            </div>
            <div class="no-results-title">
                Không tìm thấy kết quả nào
            </div>
            <div class="no-results-text">
                Không có kết quả nào cho "@ViewData["Query"]"
            </div>
            <div class="no-results-suggestions">
                <p style="color: #212121; font-size: 14px; margin-bottom: 12px;">Hãy thử:</p>
                <ul>
                    <li>Kiểm tra lỗi chính tả hoặc thử các từ khóa khác</li>
                    <li>Sử dụng từ khóa tổng quát hơn</li>
                    <li>Thử tìm kiếm nội dung phổ biến</li>
                </ul>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Add hover effects and interactions
            $('.video-card').on('mouseenter', function() {
                $(this).css('background-color', '#f5f5f5');
            }).on('mouseleave', function() {
                $(this).css('background-color', 'transparent');
            });
        });
    </script>
}