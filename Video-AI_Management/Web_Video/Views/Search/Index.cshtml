@model Web_Video.Controllers.SearchController.SearchViewModel
@{
    ViewData["Title"] = "Kết quả tìm kiếm";
    ViewData["CurrentPage"] = "Search";
    bool isFallback = ViewBag.IsFallback ?? false;
}

@section Css {
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="/css/youtube-search.css" rel="stylesheet" />
    <style>
        /* FIX MÀU NỀN ĐEN */
        .youtube-search-results {
            /* Đảm bảo nội dung search luôn có nền sáng */
            background-color: #f9f9f9 !important;
            color: #030303;
            /* Có thể cần reset màu nền cho body nếu search.css đã thay đổi nó */
        }
        /* Nếu search results hiển thị video card kiểu list, đảm bảo nền trắng */
        .video-card {
            background-color: #ffffff !important;
            border-radius: 8px; /* Thêm bo góc để đẹp hơn */
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05); /* Thêm bóng nhẹ */
        }
    </style>
}

<div class="youtube-search-results">
    <div class="search-header mb-4">
        <h6 class="search-query-text">
            @if (isFallback)
            {
                <span><i class="fas fa-search me-2"></i> Không tìm thấy kết quả chính xác cho: <span class="text-warning">"@ViewData["Query"]"</span></span>
            }
            else
            {
                <span>Kết quả tìm kiếm cho: <span class="font-weight-bold text-primary">"@ViewData["Query"]"</span></span>
            }
        </h6>
    </div>

    @if (Model.Channels != null && Model.Channels.Any())
    {
        <div id="channelResults" class="mb-4 border-bottom pb-3">
            <h6 class="text-muted mb-3">Kênh phù hợp</h6>
            @foreach (var channel in Model.Channels)
            {
                <div class="channel-card d-flex align-items-center p-3 mb-2 bg-white rounded shadow-sm border">
                    <div class="channel-avatar-container me-3">
                        <a href="/Member/Channel/@channel.Id">
                            <img src="@(channel.ChannelPicture ?? "/avatarUser/avt-default.jpg")"
                                 class="rounded-circle" style="width: 80px; height: 80px; object-fit: cover;">
                        </a>
                    </div>
                    <div class="channel-details ms-3">
                        <a href="/Member/Channel/@channel.Id" class="channel-name h5 text-dark text-decoration-none">@channel.ChannelName</a>
                        <div class="channel-subscribers text-muted small">
                            @channel.Subscribers.Count() người đăng ký • @channel.Videos.Count() video
                        </div>
                        <p class="text-muted small mt-1 mb-0">@channel.About</p>
                    </div>
                    <div class="ms-auto">
                        <a href="/Member/Channel/@channel.Id" class="btn btn-danger text-white">Đăng ký</a>
                    </div>
                </div>
            }
        </div>
    }

    <div id="videoResults">
        @if (Model.Videos != null && Model.Videos.Any())
        {
            @foreach (var video in Model.Videos)
            {
                <div class="video-card d-flex gap-3 mb-3">
                    <div class="video-thumbnail-container position-relative" style="width: 360px; min-width: 360px;">
                        <a href="/Video/Watch/@video.Id">
                            <img src="@(video.Thumbnail ?? "/img/default-thumbnail.jpg")" class="w-100 rounded" style="height: 200px; object-fit: cover;">
                        </a>
                        <span class="video-duration position-absolute bottom-0 end-0 bg-dark text-white px-2 py-1 m-2 rounded small">
                            @(video.Duration ?? "0:00")
                        </span>
                    </div>
                    <div class="video-details py-2">
                        <h5 class="video-title mb-1">
                            <a href="/Video/Watch/@video.Id" class="text-dark text-decoration-none">@video.Title</a>
                        </h5>
                        <div class="video-metadata text-muted small mb-2">
                            <span>@(video.Views ?? 0) lượt xem</span> •
                            <span>@WebVideo.Utility.SD.TimeAgo(video.UploadDate)</span>
                        </div>
                        <div class="channel-info d-flex align-items-center mb-2">
                            <img src="@(video.Channel?.ChannelPicture ?? "/avatarUser/avt-default.jpg")"
                                 class="rounded-circle me-2" style="width: 24px; height: 24px;">
                            <a href="/Member/Channel/@(video.Channel?.Id)" class="text-secondary text-decoration-none small">
                                @(video.Channel?.ChannelName)
                            </a>
                        </div>
                        <p class="video-description text-muted small">
                            @(video.Description?.Length > 150 ? video.Description.Substring(0, 150) + "..." : video.Description)
                        </p>
                    </div>
                </div>
            }
        }
        else if (!isFallback && Model.Channels.Count == 0)
        {
            <div class="text-center py-4">
                <p class="text-muted">Không tìm thấy video nào khớp với từ khóa.</p>
            </div>
        }
    </div>

    @if (Model.RecommendedVideos != null && Model.RecommendedVideos.Any())
    {
        <div class="mt-5 pt-3 border-top">
            <h5 class="mb-4 font-weight-bold">
                @if (isFallback)
                {
                    <span class="text-danger">Video đề xuất cho bạn</span>
                }
                else
                {
                    <span>Có thể bạn cũng thích</span>
                }
            </h5>

            <div class="row">
                @foreach (var video in Model.RecommendedVideos)
                {
                    <div class="col-xl-3 col-sm-6 mb-4">
                        <div class="video-card h-100 border-0 shadow-sm rounded overflow-hidden">
                            <div class="video-card-image position-relative">
                                <a href="/Video/Watch/@video.Id">
                                    <img class="img-fluid w-100" src="@(video.Thumbnail ?? "/img/default-thumbnail.jpg")"
                                         style="height: 180px; object-fit: cover;" alt="@video.Title">
                                </a>
                                <span class="time position-absolute bottom-0 end-0 bg-dark text-white px-1 m-1 rounded small" style="opacity:0.9">
                                    @(video.Duration ?? "0:00")
                                </span>
                            </div>
                            <div class="video-card-body p-3">
                                <div class="video-title mb-1">
                                    <a href="/Video/Watch/@video.Id" class="text-dark font-weight-bold text-decoration-none"
                                       style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @video.Title
                                    </a>
                                </div>
                                <div class="video-page text-success small mb-1">
                                    @(video.Channel?.ChannelName) <i class="fas fa-check-circle"></i>
                                </div>
                                <div class="video-view text-muted small">
                                    @(video.Views ?? 0) views • @WebVideo.Utility.SD.TimeAgo(video.UploadDate)
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let isLoading = false;
            let isFallbackMode = @Json.Serialize(isFallback);

            // Nếu vào trang đã là Fallback (không tìm thấy), hiện separator ngay
            if (isFallbackMode) $('#recommendation-separator').show();

            $(window).scroll(function () {
                if ($(window).scrollTop() + $(window).height() > $(document).height() - 100) {
                    if (!isLoading) {
                        // Khi cuộn hết kết quả tìm kiếm, tự động chuyển sang mode gợi ý
                        if (!isFallbackMode) {
                            isFallbackMode = true;
                            $('#recommendation-separator').fadeIn();
                        }
                        loadMoreRecommendations();
                    }
                }
            });

            function loadMoreRecommendations() {
                isLoading = true;
                $('#search-loading').show();

                // Gọi API Home Grid để lấy video ngẫu nhiên/trending (giả lập đề xuất vô tận)
                $.ajax({
                    url: '/Home/GetVideosForHomeGrid',
                    type: 'GET',
                    data: { pageNumber: 1, pageSize: 5, sortBy: 'random' }, // 'random' hoặc 'views-d'
                    success: function (res) {
                        $('#search-loading').hide();
                        if (res.result && res.result.items) {
                            appendVideos(res.result.items);
                        }
                        isLoading = false;
                    }
                });
            }

            function appendVideos(videos) {
                let html = '';
                videos.forEach(v => {
                    html += `
                    <div class="video-card animated fadeIn">
                        <div class="video-thumbnail-container">
                            <a href="/Video/Watch/${v.id}"><img src="${v.thumbnail || '/img/default-thumbnail.jpg'}"></a>
                            <div class="video-duration">${v.duration || '0:00'}</div>
                        </div>
                        <div class="video-details">
                            <div class="video-title"><a href="/Video/Watch/${v.id}">${v.title}</a></div>
                            <div class="video-metadata"><span>${v.views} views</span> • <span>${v.createdAtTimeAgo}</span></div>
                            <div class="channel-info"><span class="channel-name">${v.channelName}</span></div>
                            <div class="video-description">${v.description || ''}</div>
                        </div>
                    </div>`;
                });
                $('#videoResults').append(html);
            }
        });
    </script>
}