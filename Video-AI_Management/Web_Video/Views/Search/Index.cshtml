@model Web_Video.Controllers.SearchController.SearchViewModel

@{
    ViewData["Title"] = "Kết quả tìm kiếm";
    ViewData["CurrentPage"] = "Search";
    bool isFallback = ViewBag.IsFallback ?? false;
    // Lấy cờ mới
    bool isFuzzyMatch = ViewBag.IsFuzzyMatch ?? false; // <-- THÊM DÒNG NÀY
    string currentUploadTime = ViewData["UploadTime"] as string ?? "any";
    string currentDuration = ViewData["Duration"] as string ?? "any";
    bool filtersApplied = currentUploadTime != "any" || currentDuration != "any";
    // --- MAPPING NHÃN HIỂN THỊ ---
    var uploadTimeLabels = new Dictionary<string, string>
    {
        { "any", "Thời gian đăng tải" },
        { "last_hour", "Giờ trước" },
        { "today", "Hôm nay" },
        { "this_week", "Tuần này" },
        { "this_month", "Tháng này" },
        { "this_year", "Năm nay" }
    };
    var durationLabels = new Dictionary<string, string>
    {
        { "any", "Thời lượng" },
        { "short", "Ngắn (dưới 4 phút)" },
        { "medium", "Trung bình (4-20 phút)" },
        { "long", "Dài (trên 20 phút)" }
    };

    // Lấy nhãn hiện tại
    string displayUploadTime = uploadTimeLabels.ContainsKey(currentUploadTime) ? uploadTimeLabels[currentUploadTime] : uploadTimeLabels["any"];
    string displayDuration = durationLabels.ContainsKey(currentDuration) ? durationLabels[currentDuration] : durationLabels["any"];
}

@section Css {
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="/css/youtube-search.css" rel="stylesheet" />
    <style>
        /* Thêm khoảng cách giữa các phần tử trong bộ lọc vì Bootstrap 4 không có gap-3 */
        #filterDropdownContainer .dropdown,
        #filterDropdownContainer #resetFiltersBtn {
            margin-right: 10px; /* Tạo khoảng cách ngang */
        }

        /* Đảm bảo dropdown menu hiển thị đúng lớp trên cùng */
        .dropdown-menu {
            z-index: 1050; /* Bootstrap 4 z-index chuẩn */
        }

        .dropdown-item.active, .dropdown-item:active {
            background-color: transparent;
            color: inherit;
        }
        /* Custom CSS cho nút Đăng ký trên trang Search */

        /* Style cho nút khi đã đăng ký */
        .subscribe-search-btn.subscribed-btn {
            /* Dùng màu xám nền và chữ xám tương tự các nút phụ khác */
            background-color: var(--search-bg-secondary, #e5e5e5);
            color: var(--search-text-secondary, #606060);
            border: 1px solid var(--search-divider, #ccc);
        }

            .subscribe-search-btn.subscribed-btn:hover {
                background-color: var(--yt-gray-200, #d9d9d9);
                color: var(--search-text, #0f0f0f);
                /* Khi hover Đã đăng ký, ta có thể đổi thành "Hủy đăng ký" màu đỏ, nhưng để đơn giản, ta giữ màu xám */
            }

        /* Đảm bảo nút Đăng ký mặc định màu đỏ */
        .subscribe-search-btn.btn-danger {
            background-color: var(--yt-red, #ff0000);
            color: #fff;
            border: none;
        }

            .subscribe-search-btn.btn-danger:hover {
                background-color: #cc0000;
            }

        /* Định nghĩa lại style chung của nút (nếu cần) */
        .channel-card .btn {
            height: 36px;
            padding: 0 16px;
            border-radius: 18px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }
    </style>
}

<div class="youtube-search-results">
    <div class="search-header">
        <h6 class="search-query-text">
            @if (isFallback)
            {
                <span><i class="fas fa-search me-2"></i> Không tìm thấy kết quả chính xác cho: <span class="search-query-highlight">"@ViewData["Query"]"</span></span>
                @if (filtersApplied)
                {
                    <small class="text-info d-block">LƯU Ý: Đã áp dụng bộ lọc thời gian đăng tải/thời lượng, bạn có thể thử xóa bộ lọc.</small>
                }
            }
            else if (isFuzzyMatch) // <-- Xử lý trường hợp có kết quả Fuzzy
            {
                <span><i class="fas fa-search me-2"></i> Kết quả tìm kiếm GẦN ĐÚNG cho: <span class="font-weight-bold text-primary">"@ViewData["Query"]"</span></span>
                <small class="text-info d-block">Kết quả này được tạo ra dựa trên độ tương đồng từ khóa.</small>
            }
            else
            {
                <span>Kết quả tìm kiếm cho: <span class="search-query-highlight">"@ViewData["Query"]"</span></span>
            }
        </h6>
    </div>

    <div class="search-filters mb-4">
        <!-- Nút Lọc Chính (giống YouTube) -->
        <button class="btn btn-sm btn-outline-secondary me-2 filter-toggle-btn" id="filterToggleBtn">
            <i class="fas fa-filter me-1"></i> Lọc
        </button>

        <!-- Container Dropdown Lọc -->
        <div id="filterDropdownContainer" class="d-inline-flex gap-3" style="display: none;">

            <!-- Lọc theo Thời gian đăng tải -->
            <div class="dropdown">
                <button class="btn btn-sm btn-light dropdown-toggle" type="button" id="uploadTimeFilter" data-toggle="dropdown" aria-expanded="false">
                    @displayUploadTime
                </button>
                <ul class="dropdown-menu" aria-labelledby="uploadTimeFilter">
                    <li><a class="dropdown-item filter-option @(currentUploadTime == "any" ? "active text-primary" : "")" href="#" data-filter-type="uploadTime" data-filter-value="any">Bất kỳ</a></li>
                    <li><a class="dropdown-item filter-option @(currentUploadTime == "last_hour" ? "active text-primary" : "")" href="#" data-filter-type="uploadTime" data-filter-value="last_hour">Giờ trước</a></li>
                    <li><a class="dropdown-item filter-option @(currentUploadTime == "today" ? "active text-primary" : "")" href="#" data-filter-type="uploadTime" data-filter-value="today">Hôm nay</a></li>
                    <li><a class="dropdown-item filter-option @(currentUploadTime == "this_week" ? "active text-primary" : "")" href="#" data-filter-type="uploadTime" data-filter-value="this_week">Tuần này</a></li>
                    <li><a class="dropdown-item filter-option @(currentUploadTime == "this_month" ? "active text-primary" : "")" href="#" data-filter-type="uploadTime" data-filter-value="this_month">Tháng này</a></li>
                    <li><a class="dropdown-item filter-option @(currentUploadTime == "this_year" ? "active text-primary" : "")" href="#" data-filter-type="uploadTime" data-filter-value="this_year">Năm nay</a></li>
                </ul>
            </div>

            <!-- Lọc theo Thời lượng video -->
            <div class="dropdown">
                <button class="btn btn-sm btn-light dropdown-toggle" type="button" id="durationFilter" data-toggle="dropdown" aria-expanded="false">
                    @displayDuration
                </button>
                <ul class="dropdown-menu" aria-labelledby="durationFilter">
                    <li><a class="dropdown-item filter-option @(currentDuration == "any" ? "active text-primary" : "")" href="#" data-filter-type="duration" data-filter-value="any">Bất kỳ</a></li>
                    <li><a class="dropdown-item filter-option @(currentDuration == "short" ? "active text-primary" : "")" href="#" data-filter-type="duration" data-filter-value="short">Ngắn (dưới 4 phút)</a></li>
                    <li><a class="dropdown-item filter-option @(currentDuration == "medium" ? "active text-primary" : "")" href="#" data-filter-type="duration" data-filter-value="medium">Trung bình (4-20 phút)</a></li>
                    <li><a class="dropdown-item filter-option @(currentDuration == "long" ? "active text-primary" : "")" href="#" data-filter-type="duration" data-filter-value="long">Dài (trên 20 phút)</a></li>
                </ul>
            </div>

            <!-- Nút Reset -->
            <button class="btn btn-sm btn-outline-danger" id="resetFiltersBtn">
                Xóa bộ lọc
            </button>
        </div>
    </div>

    @if (Model.Channels != null && Model.Channels.Any())
    {
        <div id="channelResults" class="mb-4">
            <h6 class="search-section-title">Kênh</h6>
            @foreach (var channel in Model.Channels)
            {
                <div class="channel-card">
                    <div class="channel-avatar-container">
                        <a href="/Member/Channel/@channel.Id">
                            <img src="@(channel.ChannelPicture ?? "/avatarUser/avt-default.jpg")" alt="@channel.ChannelName">
                        </a>
                    </div>
                    <div class="channel-details">
                        <a href="/Member/Channel/@channel.Id" class="channel-name">@channel.ChannelName</a>
                        <div class="channel-subscribers">
                            @channel.Subscribers.Count() người đăng ký • @channel.Videos.Count() video
                        </div>
                        <p class="channel-description">@channel.About</p>
                    </div>
                    <div>
                        @{
                            bool isUserAuthenticated = User.Identity.IsAuthenticated;
                            string userId = isUserAuthenticated ? User.GetUserId() : null;

                            // Kiểm tra trạng thái đăng ký dựa trên dữ liệu tải từ DB
                            bool isSubscribed = isUserAuthenticated && channel.Subscribers.Any(s => s.AppUserId == userId);

                            string buttonClass = isSubscribed ? "subscribed-btn" : "btn-danger";
                            string buttonText = isSubscribed ? "Đã đăng ký" : "Đăng ký";
                            string dataAttr = isSubscribed.ToString().ToLower();
                        }

                        @if (isUserAuthenticated)
                        {
                            <button type="button"
                                    class="btn @buttonClass subscribe-search-btn"
                                    data-channel-id="@channel.Id"
                                    data-is-subscribed="@dataAttr"
                                    data-channel-name="@channel.ChannelName">
                                @buttonText
                            </button>
                        }
                        else
                        {
                            <!-- Nếu chưa đăng nhập, giữ nguyên hành vi chuyển hướng (ví dụ: đến trang đăng nhập hoặc trang kênh) -->
                            <a href="/Account/Login" class="btn btn-danger">Đăng ký</a>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <div id="videoResults">
        @if (Model.Videos != null && Model.Videos.Any())
        {
            @foreach (var video in Model.Videos)
            {
                <div class="video-card">
                    <div class="video-thumbnail-container">
                        <a href="/Video/Watch/@video.Id">
                            <img src="@(video.Thumbnail ?? "/img/default-thumbnail.jpg")" alt="@video.Title">
                        </a>
                        <span class="video-duration">@(video.Duration ?? "0:00")</span>
                    </div>
                    <div class="video-details">
                        <h5 class="video-title">
                            <a href="/Video/Watch/@video.Id">@video.Title</a>
                        </h5>
                        <div class="video-metadata">
                            <span>@(video.Views ?? 0) lượt xem</span>
                            <span class="metadata-separator">•</span>
                            <span>@WebVideo.Utility.SD.TimeAgo(video.UploadDate)</span>
                        </div>
                        <div class="channel-info">
                            <img src="@(video.Channel?.ChannelPicture ?? "/avatarUser/avt-default.jpg")" alt="@(video.Channel?.ChannelName)">
                            <a href="/Member/Channel/@(video.Channel?.Id)">
                                @(video.Channel?.ChannelName)
                            </a>
                        </div>
                        <p class="video-description">
                            @(video.Description?.Length > 150 ? video.Description.Substring(0, 150) + "..." : video.Description)
                        </p>
                    </div>
                </div>
            }
        }
        else if (!isFallback && (Model.Channels == null || Model.Channels.Count == 0))
        {
            <div class="no-results">
                <div class="no-results-icon">
                    <i class="fas fa-search"></i>
                </div>
                <h3 class="no-results-title">Không tìm thấy kết quả</h3>
                <p class="no-results-text">Không tìm thấy video nào khớp với từ khóa của bạn.</p>
                <div class="no-results-suggestions">
                    <p>Gợi ý:</p>
                    <ul>
                        <li>Kiểm tra chính tả từ khóa</li>
                        <li>Thử sử dụng từ khóa khác</li>
                        <li>Thử sử dụng từ khóa tổng quát hơn</li>
                    </ul>
                </div>
            </div>
        }
    </div>

    @if (Model.RecommendedVideos != null && Model.RecommendedVideos.Any())
    {
        <div class="mt-5 pt-3 border-top">
            <h5>
                @if (isFallback)
                {
                    <span>Video đề xuất cho bạn</span>
                }
                else
                {
                    <span>Có thể bạn cũng thích</span>
                }
            </h5>
            <div class="row">
                @foreach (var video in Model.RecommendedVideos)
                {
                    <div class="col-xl-3 col-lg-4 col-sm-6 mb-4">
                        <div class="video-card">
                            <div class="video-card-image">
                                <a href="/Video/Watch/@video.Id">
                                    <img src="@(video.Thumbnail ?? "/img/default-thumbnail.jpg")" alt="@video.Title">
                                </a>
                                <span class="time">@(video.Duration ?? "0:00")</span>
                            </div>
                            <div class="video-card-body">
                                <img src="@(video.Channel?.ChannelPicture ?? "/avatarUser/avt-default.jpg")" alt="@(video.Channel?.ChannelName)">
                                <div class="video-info">
                                    <div class="video-title">
                                        <a href="/Video/Watch/@video.Id">@video.Title</a>
                                    </div>
                                    <div class="video-page">
                                        <a href="/Member/Channel/@(video.Channel?.Id)">@(video.Channel?.ChannelName)</a>
                                    </div>
                                    <div class="video-view">
                                        @(video.Views ?? 0) lượt xem • @WebVideo.Utility.SD.TimeAgo(video.UploadDate)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<div id="search-loading" style="display: none;">
    <div class="spinner-border spinner-border-sm" role="status">
        <span class="sr-only">Đang tải...</span>
    </div>
</div>

@section Scripts {
    <script src="~/js/site.js"></script>
    <script>
        // Hàm xác nhận (được lấy từ logic trong AllReports.cshtml [8])
        function confirmation(message) {
            return new Promise((resolve) => {
                const result = window.confirm(message);
                resolve(result);
            });
        }

        // Hàm hiển thị thông báo (được lấy từ logic trong _Notification.cshtml [9] và Watch.cshtml [10])
        function displayNotification(isSuccess, title, message, type) {
            if (typeof toastr !== "undefined") {
                if (isSuccess) toastr.success(message, title);
                else toastr.error(message, title);
            } else {
                alert(`${title}: ${message}`);
            }
        }
        $(document).ready(function () {

            // Lắng nghe sự kiện click trên tất cả các nút subscribe trên trang tìm kiếm
        $(document).on('click', '.subscribe-search-btn', function(e) {
            e.preventDefault();

            const $btn = $(this);
            const channelId = $btn.data('channel-id');
            // Đọc trạng thái hiện tại (boolean)
            let isCurrentlySubscribed = $btn.data('is-subscribed') === true || $btn.data('is-subscribed') === 'true';
            const channelName = $btn.data('channel-name');

            const actionText = isCurrentlySubscribed ? 'Hủy đăng ký' : 'Đăng ký';

            // Xử lý xác nhận nếu đang ở trạng thái Đã đăng ký
            if (isCurrentlySubscribed) {
                if (typeof confirmation === 'function') {
                    confirmation(`Bạn có chắc chắn muốn hủy đăng ký kênh "${channelName}" không?`)
                    .then(confirmed => {
                        if (confirmed) {
                            performSubscriptionToggle($btn, channelId, isCurrentlySubscribed, actionText);
                        }
                    });
                } else {
                    // Fallback nếu hàm confirmation không tồn tại
                    if(confirm(`Bạn có chắc chắn muốn hủy đăng ký kênh "${channelName}" không?`)){
                        performSubscriptionToggle($btn, channelId, isCurrentlySubscribed, actionText);
                    }
                }
            } else {
                // Không cần xác nhận khi Đăng ký
                performSubscriptionToggle($btn, channelId, isCurrentlySubscribed, actionText);
            }
        });

        function performSubscriptionToggle($btn, channelId, isCurrentlySubscribed, actionText) {

            // Lưu trạng thái hiện tại để khôi phục nếu lỗi
            const originalText = $btn.text();
            const originalClass = $btn.attr('class');

            // Hiển thị trạng thái loading
            $btn.prop('disabled', true).text('Đang xử lý...');

            // Lấy token anti-forgery (cần thiết cho POST/PUT/DELETE)
            const token = $('input[name="__RequestVerificationToken"]').val();

            // Gửi yêu cầu PUT đến API SubscribeChannel (đã được sử dụng trong Watch.cshtml [1])
            $.ajax({
                url: "/Video/SubscribeChannel",
                type: "PUT",
                contentType: "application/x-www-form-urlencoded", // Dùng standard encoding
                data: { channelId: channelId },
                headers: {
                    // Truyền token bảo mật qua header
                    'RequestVerificationToken': token
                },
                success: function (data) {
                    $btn.prop('disabled', false);

                    if (data && data.isSuccess) {
                        // Cập nhật trạng thái mới
                        const newStatus = data.title === "Subscribed"; // Kiểm tra phản hồi từ server
                        const newText = newStatus ? "Đã đăng ký" : "Đăng ký";
                        const newClass = newStatus ? "subscribed-btn" : "btn-danger";

                        // Cập nhật button
                        $btn.text(newText);
                        // Xóa cả hai class có thể có và thêm class mới
                        $btn.removeClass('btn-danger subscribed-btn').addClass(newClass + ' subscribe-search-btn btn');
                        $btn.data('is-subscribed', newStatus); // Cập nhật data-attribute

                        // Hiển thị thông báo
                        displayNotification(true, data.title, data.message, 'toastr');
                    } else {
                        // Xử lý lỗi từ server
                        // Khôi phục nút
                        $btn.text(originalText).attr('class', originalClass);
                        displayNotification(false, 'Lỗi', data.message || `Không thể ${actionText} kênh.`, 'toastr');
                    }
                },
                error: function (xhr) {
                    // Khôi phục nút nếu lỗi kết nối
                    $btn.prop('disabled', false).text(originalText).attr('class', originalClass);
                    displayNotification(false, 'Lỗi', `Lỗi kết nối khi ${actionText}.`, 'toastr');
                }
            });
        }


            /* ============================================================
             *  1) FILTER NÂNG CAO (UPLOAD TIME + DURATION)
             * ============================================================ */

            // Lấy query từ ViewData (nếu có)
            const currentQuery = '@Html.Raw(ViewData["Query"])';

            // Lấy filter từ ViewData
            let currentUploadTime = '@Html.Raw(currentUploadTime)';
            let currentDuration = '@Html.Raw(currentDuration)';

            const $filterContainer = $('#filterDropdownContainer');

            // Toggle bộ lọc
            $('#filterToggleBtn').on('click', function () {
                const $container = $('#filterDropdownContainer');

                // Kiểm tra nếu đang ẩn thì hiện và ngược lại
                if ($container.is(':hidden')) {
                    $container.css('display', 'inline-flex'); // Hiện dạng flex để các nút nằm ngang
                } else {
                    $container.hide();
                }
            });

            // Chọn filter
            $('.filter-option').on('click', function (e) {
                e.preventDefault();

                const type = $(this).data('filter-type');
                const value = $(this).data('filter-value');

                if (type === 'uploadTime') currentUploadTime = value;
                if (type === 'duration') currentDuration = value;

                performSearch();
            });

            // Reset filter
            $('#resetFiltersBtn').on('click', function () {
                currentUploadTime = 'any';
                currentDuration = 'any';
                performSearch();
            });

            // Hàm redirect URL search
            function performSearch() {
                // FIX: Sử dụng URLSearchParams để quản lý query string chuẩn hơn
                const params = new URLSearchParams(window.location.search);

                // Giữ lại query cũ
                if (currentQuery) params.set('query', currentQuery);

                // Cập nhật filter
                if (currentUploadTime !== 'any') params.set('uploadTime', currentUploadTime);
                else params.delete('uploadTime'); // Xóa nếu là any

                if (currentDuration !== 'any') params.set('duration', currentDuration);
                else params.delete('duration'); // Xóa nếu là any

                window.location.href = `/Search?${params.toString()}`;
            }

            // Nếu filter đang bật → hiển thị container
            if (currentUploadTime !== 'any' || currentDuration !== 'any') {
                $filterContainer.css('display', 'inline-flex').addClass('d-inline-flex');
            }

            /* ============================================================
             *  2) LOGIC CŨ: INFINITE SCROLL + FALLBACK MODE
             * ============================================================ */

            let isLoading = false;
            let isFallbackMode = @Json.Serialize(isFallback);

            if (isFallbackMode) {
                $('#recommendation-separator').show();
            }

            $(window).scroll(function () {

                // Khi kéo gần cuối trang
                if ($(window).scrollTop() + $(window).height() > $(document).height() - 100) {

                    if (!isLoading) {

                        if (!isFallbackMode) {
                            isFallbackMode = true;
                            $('#recommendation-separator').fadeIn();
                        }

                        loadMoreRecommendations();
                    }
                }
            });

            // AJAX load video fallback
            function loadMoreRecommendations() {
                isLoading = true;
                $('#search-loading').show();

                $.ajax({
                    url: '/Home/GetVideosForHomeGrid',
                    type: 'GET',
                    data: { pageNumber: 1, pageSize: 8, sortBy: 'random' },
                    success: function (res) {

                        $('#search-loading').hide();
                        if (res.result && res.result.items) {
                            appendVideos(res.result.items);
                        }

                        isLoading = false;
                    }
                });
            }

            // Append video vào grid
            function appendVideos(videos) {
                let html = '';
                videos.forEach(v => {
                    html += `
                    <div class="col-xl-3 col-lg-4 col-sm-6 mb-4">
                        <div class="video-card animated">
                            <div class="video-card-image">
                                <a href="/Video/Watch/${v.id}">
                                    <img src="${v.thumbnail || '/img/default-thumbnail.jpg'}" alt="${v.title}">
                                </a>
                                <span class="time">${v.duration || '0:00'}</span>
                            </div>
                            <div class="video-card-body">
                                <img src="${v.channelPicture || '/avatarUser/avt-default.jpg'}" alt="${v.channelName}">
                                <div class="video-info">
                                    <div class="video-title">
                                        <a href="/Video/Watch/${v.id}">${v.title}</a>
                                    </div>
                                    <div class="video-page">
                                        <a href="/Member/Channel/${v.channelId}">${v.channelName}</a>
                                    </div>
                                    <div class="video-view">${v.views} lượt xem • ${v.createdAtTimeAgo}</div>
                                </div>
                            </div>
                        </div>
                    </div>`;
                });

                $('.mt-5.pt-3.border-top .row').append(html);
            }

        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}