@model IEnumerable<Web_Video.ViewModels.Moderator.VideoDisplayGridViewModel>
@{
    ViewData["Title"] = "Quản lý video";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="studio-container">
    <!-- Header Section -->
    <div class="studio-header">
        <div class="header-content">
            <h1 class="studio-title">Nội dung kênh</h1>
            <p class="studio-subtitle">@Model.Count() video</p>
        </div>
    </div>

    <!-- Video Grid -->
    <div class="video-grid">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <svg width="120" height="120" viewBox="0 0 120 120" fill="none">
                    <circle cx="60" cy="60" r="60" fill="#F9F9F9" />
                    <path d="M45 40h30v40H45z" fill="#E5E5E5" />
                    <circle cx="60" cy="60" r="15" fill="#CCCCCC" />
                </svg>
                <h3>Chưa có video nào</h3>
                <p>Không có video nào để hiển thị trong hệ thống</p>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="video-card">
                    <!-- Thumbnail -->
                    <a href="@Url.Action("Watch", "Video", new { id = item.Id })" class="thumbnail-container">
                        <img src="@item.Thumbnail" alt="@item.Title" class="thumbnail" />
                        <div class="thumbnail-overlay">
                            <svg width="48" height="48" viewBox="0 0 68 48">
                                <path d="M66.52,7.74c-0.78-2.93-2.49-5.41-5.42-6.19C55.79,.13,34,0,34,0S12.21,.13,6.9,1.55 C3.97,2.33,2.27,4.81,1.48,7.74C0.06,13.05,0,24,0,24s0.06,10.95,1.48,16.26c0.78,2.93,2.49,5.41,5.42,6.19 C12.21,47.87,34,48,34,48s21.79-0.13,27.1-1.55c2.93-0.78,4.64-3.26,5.42-6.19C67.94,34.95,68,24,68,24S67.94,13.05,66.52,7.74z" fill="#FF0000" />
                                <path d="M 45,24 27,14 27,34" fill="#FFFFFF" />
                            </svg>
                        </div>
                    </a>

                    <!-- Video Info -->
                    <div class="video-info">
                        <a href="@Url.Action("Watch", "Video", new { id = item.Id })" class="video-title">
                            @item.Title
                        </a>
                        <div class="video-meta">
                            <a href="@Url.Action("Channel", "Member", new { id = item.ChannelId })" class="channel-name">
                                @item.ChannelName
                            </a>
                            <div class="video-stats">
                                <span>@item.CategoryName</span>
                                <span class="dot">•</span>
                                <span>@item.UploadDate.ToString("dd/MM/yyyy")</span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="video-actions">
                            <form method="post" class="delete-form">
                                <button asp-action="DeleteVideo" asp-route-id="@item.Id" type="submit" class="delete-btn">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6"></polyline>
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        <line x1="10" y1="11" x2="10" y2="17"></line>
                                        <line x1="14" y1="11" x2="14" y2="17"></line>
                                    </svg>
                                    Xóa
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Css {
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        .studio-container {
            background: #FFFFFF;
            min-height: 100vh;
            padding: 24px 32px;
            font-family: "Roboto", Arial, sans-serif;
        }

        /* Header */
        .studio-header {
            margin-bottom: 32px;
            padding-bottom: 16px;
            border-bottom: 1px solid #E5E5E5;
        }

        .studio-title {
            font-size: 24px;
            font-weight: 400;
            color: #0F0F0F;
            margin-bottom: 4px;
        }

        .studio-subtitle {
            font-size: 14px;
            color: #606060;
            font-weight: 400;
        }

        /* Video Grid */
        .video-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 24px 16px;
        }

        /* Empty State */
        .empty-state {
            grid-column: 1 / -1;
            text-align: center;
            padding: 80px 20px;
        }

            .empty-state h3 {
                font-size: 20px;
                font-weight: 400;
                color: #0F0F0F;
                margin: 16px 0 8px;
            }

            .empty-state p {
                font-size: 14px;
                color: #606060;
            }

        /* Video Card */
        .video-card {
            background: #FFFFFF;
            border-radius: 8px;
            overflow: hidden;
            transition: transform 0.2s ease;
        }

            .video-card:hover {
                transform: translateY(-2px);
            }

        /* Thumbnail */
        .thumbnail-container {
            position: relative;
            display: block;
            width: 100%;
            padding-top: 56.25%; /* 16:9 */
            background: #F9F9F9;
            border-radius: 8px;
            overflow: hidden;
        }

        .thumbnail {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.2s ease;
        }

        .video-card:hover .thumbnail {
            transform: scale(1.05);
        }

        .thumbnail-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            opacity: 0;
            transition: opacity 0.2s ease;
        }

        .thumbnail-container:hover .thumbnail-overlay {
            opacity: 1;
        }

        /* Video Info */
        .video-info {
            padding: 12px 0;
        }

        .video-title {
            display: block;
            font-size: 14px;
            font-weight: 500;
            color: #0F0F0F;
            line-height: 1.4;
            max-height: 2.8em;
            overflow: hidden;
            text-decoration: none;
            margin-bottom: 8px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

            .video-title:hover {
                color: #0F0F0F;
            }

        .video-meta {
            font-size: 12px;
            color: #606060;
            line-height: 1.6;
        }

        .channel-name {
            color: #606060;
            text-decoration: none;
            display: block;
            margin-bottom: 4px;
        }

            .channel-name:hover {
                color: #0F0F0F;
            }

        .video-stats {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .dot {
            font-size: 10px;
        }

        /* Actions */
        .video-actions {
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid #E5E5E5;
        }

        .delete-form {
            display: block;
        }

        .delete-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 500;
            color: #FF0000;
            background: transparent;
            border: 1px solid #E5E5E5;
            border-radius: 18px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .delete-btn:hover {
                background: #FFF0F0;
                border-color: #FF0000;
            }

            .delete-btn svg {
                stroke: #FF0000;
            }

        /* Responsive */
        @@media (max-width: 768px) {
            .studio-container

        {
            padding: 16px;
        }

        .video-grid {
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 16px 12px;
        }

        }

        @@media (max-width: 480px) {
            .video-grid

        {
            grid-template-columns: 1fr;
        }

        }
    </style>
}