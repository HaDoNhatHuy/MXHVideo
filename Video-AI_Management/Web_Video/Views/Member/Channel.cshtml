@model Web_Video.ViewModels.Member.MemberChannelViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Channel Banner -->
<div class="yt-channel-banner">
    <img src="/img/channel-banner.png" alt="Channel Banner">
</div>

<!-- Channel Header -->
<div class="yt-channel-header">
    <div class="yt-channel-header-inner">
        <div class="yt-channel-avatar-wrapper">
            <img class="yt-channel-avatar" src="/img/s2.png" alt="@Model.Name">
        </div>

        <div class="yt-channel-info">
            <h1 class="yt-channel-name">
                @Model.Name
                <span class="yt-verified-badge" title="Verified">
                    <i class="fas fa-check-circle"></i>
                </span>
            </h1>

            <div class="yt-channel-metadata">
                <span class="yt-channel-handle">@@@Model.Name.Replace(" ", "").ToLower()</span>
                <span class="yt-metadata-dot">•</span>
                <span class="yt-channel-subscribers">@Model.NumberOfSubscribers.ToString("N0") người đăng ký</span>
                <span class="yt-metadata-dot">•</span>
                <span class="yt-channel-videos">125 video</span>
            </div>

            <div class="yt-channel-description-short">
                Chào mừng đến với kênh của chúng tôi! Đăng ký để không bỏ lỡ video mới nhất.
            </div>

            <div class="yt-channel-links">
                <a href="#" class="yt-channel-link">
                    <i class="fab fa-facebook"></i>
                </a>
                <a href="#" class="yt-channel-link">
                    <i class="fab fa-twitter"></i>
                </a>
                <a href="#" class="yt-channel-link">
                    <i class="fab fa-instagram"></i>
                </a>
            </div>
        </div>

        @if (User.GetUserChannelId() != Model.ChannelId.ToString())
        {
            <div class="yt-channel-actions">
                <form method="post" class="d-inline">
                    <button asp-action="SubscribeChannel"
                            asp-route-channelId="@Model.ChannelId"
                            type="submit"
                            class="yt-subscribe-btn @(Model.UserIsSubscribed ? "subscribed" : "")">
                        <i class="fas @(Model.UserIsSubscribed ? "fa-bell" : "fa-bell-slash")"></i>
                        @(Model.UserIsSubscribed ? "Đã đăng ký" : "Đăng ký")
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="yt-channel-actions">
                <button class="yt-manage-btn">
                    <i class="fas fa-sliders-h"></i>
                    Tùy chỉnh kênh
                </button>
            </div>
        }
    </div>
</div>

<!-- Channel Navigation -->
<div class="yt-channel-nav">
    <div class="yt-channel-nav-inner">
        <a href="#" class="yt-nav-tab active" data-tab="videos">
            <span>Trang chủ</span>
        </a>
        <a href="#" class="yt-nav-tab" data-tab="videos">
            <span>Video</span>
        </a>
        <a href="#" class="yt-nav-tab" data-tab="playlist">
            <span>Danh sách phát</span>
        </a>
        <a href="#" class="yt-nav-tab" data-tab="community">
            <span>Cộng đồng</span>
        </a>
        <a href="#" class="yt-nav-tab" data-tab="about">
            <span>Giới thiệu</span>
        </a>

        <div class="yt-nav-search">
            <input type="search" placeholder="Tìm kiếm" class="yt-search-input">
            <button class="yt-search-btn">
                <i class="fas fa-search"></i>
            </button>
        </div>
    </div>
</div>

<!-- Channel Content -->
<div class="yt-channel-content">
    <div class="yt-content-header">
        <h2 class="yt-content-title">Video</h2>
        <div class="yt-content-filter">
            <button class="yt-filter-dropdown">
                <span>Mới nhất</span>
                <i class="fas fa-chevron-down"></i>
            </button>
        </div>
    </div>

    <div class="yt-videos-grid" id="videosContainer">
        <!-- Videos will be populated by JavaScript -->
    </div>
</div>

@section Css {
    <style>
        /* ============================================
           YOUTUBE CHANNEL - LIGHT MODE
           ============================================ */

        :root {
            --yt-spec-base-background: #fff;
            --yt-spec-raised-background: #fff;
            --yt-spec-menu-background: #f9f9f9;
            --yt-spec-text-primary: #030303;
            --yt-spec-text-secondary: #606060;
            --yt-spec-text-disabled: #909090;
            --yt-spec-icon-inactive: #606060;
            --yt-spec-icon-active: #030303;
            --yt-spec-10-percent-layer: rgba(0, 0, 0, 0.1);
            --yt-spec-touch-response: rgba(0, 0, 0, 0.05);
            --yt-spec-brand-button-background: #cc0000;
            --yt-spec-call-to-action: #065fd4;
            --yt-spec-blue-link: #065fd4;
            --yt-spec-verified-badge: #606060;
            --yt-spec-border-color: #e5e5e5;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background-color: var(--yt-spec-base-background);
            color: var(--yt-spec-text-primary);
            margin: 0;
            padding: 0;
        }

        /* ============================================
           CHANNEL BANNER
           ============================================ */

        .yt-channel-banner {
            width: 100%;
            height: 200px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            overflow: hidden;
        }

            .yt-channel-banner img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        /* ============================================
           CHANNEL HEADER
           ============================================ */

        .yt-channel-header {
            background-color: var(--yt-spec-base-background);
            border-bottom: 1px solid var(--yt-spec-border-color);
            padding: 16px 0 0;
        }

        .yt-channel-header-inner {
            max-width: 1284px;
            margin: 0 auto;
            padding: 0 24px 16px;
            display: flex;
            align-items: flex-start;
            gap: 24px;
        }

        .yt-channel-avatar-wrapper {
            margin-top: -80px;
            flex-shrink: 0;
        }

        .yt-channel-avatar {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            border: 4px solid var(--yt-spec-base-background);
            object-fit: cover;
            background-color: var(--yt-spec-menu-background);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .yt-channel-info {
            flex: 1;
            min-width: 0;
            padding-top: 8px;
        }

        .yt-channel-name {
            font-size: 36px;
            font-weight: 900;
            line-height: 1.2;
            color: var(--yt-spec-text-primary);
            margin: 0 0 4px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .yt-verified-badge {
            font-size: 24px;
            color: var(--yt-spec-verified-badge);
        }

        .yt-channel-metadata {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 14px;
            color: var(--yt-spec-text-secondary);
            margin-bottom: 8px;
            flex-wrap: wrap;
        }

        .yt-channel-handle {
            font-weight: 500;
        }

        .yt-metadata-dot {
            margin: 0 4px;
        }

        .yt-channel-description-short {
            font-size: 14px;
            color: var(--yt-spec-text-secondary);
            margin: 12px 0;
            line-height: 1.4;
        }

        .yt-channel-links {
            display: flex;
            gap: 16px;
            margin-top: 12px;
        }

        .yt-channel-link {
            color: var(--yt-spec-text-secondary);
            font-size: 20px;
            transition: color 0.2s;
        }

            .yt-channel-link:hover {
                color: var(--yt-spec-text-primary);
            }

        .yt-channel-actions {
            padding-top: 8px;
        }

        .yt-subscribe-btn,
        .yt-manage-btn {
            height: 36px;
            padding: 0 16px;
            border-radius: 18px;
            border: none;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
            white-space: nowrap;
        }

        .yt-subscribe-btn {
            background-color: var(--yt-spec-brand-button-background);
            color: #fff;
        }

            .yt-subscribe-btn:hover {
                background-color: #b20000;
            }

            .yt-subscribe-btn.subscribed {
                background-color: var(--yt-spec-10-percent-layer);
                color: var(--yt-spec-text-primary);
            }

                .yt-subscribe-btn.subscribed:hover {
                    background-color: rgba(0, 0, 0, 0.15);
                }

        .yt-manage-btn {
            background-color: var(--yt-spec-10-percent-layer);
            color: var(--yt-spec-text-primary);
        }

            .yt-manage-btn:hover {
                background-color: rgba(0, 0, 0, 0.15);
            }

        /* ============================================
           CHANNEL NAVIGATION
           ============================================ */

        .yt-channel-nav {
            background-color: var(--yt-spec-base-background);
            border-bottom: 1px solid var(--yt-spec-border-color);
            position: sticky;
            top: 56px;
            z-index: 100;
        }

        .yt-channel-nav-inner {
            max-width: 1284px;
            margin: 0 auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            gap: 32px;
        }

        .yt-nav-tab {
            padding: 14px 0;
            font-size: 14px;
            font-weight: 500;
            color: var(--yt-spec-text-secondary);
            text-decoration: none;
            border-bottom: 2px solid transparent;
            cursor: pointer;
            transition: color 0.2s;
            white-space: nowrap;
        }

            .yt-nav-tab:hover {
                color: var(--yt-spec-text-primary);
            }

            .yt-nav-tab.active {
                color: var(--yt-spec-text-primary);
                border-bottom-color: var(--yt-spec-text-primary);
            }

        .yt-nav-search {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 0;
        }

        .yt-search-input {
            width: 200px;
            height: 32px;
            padding: 0 12px;
            border: 1px solid var(--yt-spec-border-color);
            border-right: none;
            border-radius: 20px 0 0 20px;
            font-size: 14px;
            background-color: var(--yt-spec-base-background);
            color: var(--yt-spec-text-primary);
        }

            .yt-search-input:focus {
                outline: none;
                border-color: var(--yt-spec-call-to-action);
            }

        .yt-search-btn {
            height: 32px;
            padding: 0 16px;
            border: 1px solid var(--yt-spec-border-color);
            border-left: none;
            border-radius: 0 20px 20px 0;
            background-color: var(--yt-spec-menu-background);
            color: var(--yt-spec-text-secondary);
            cursor: pointer;
            transition: background-color 0.2s;
        }

            .yt-search-btn:hover {
                background-color: #e5e5e5;
            }

        /* ============================================
           CHANNEL CONTENT
           ============================================ */

        .yt-channel-content {
            max-width: 1284px;
            margin: 0 auto;
            padding: 24px 24px 48px;
        }

        .yt-content-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .yt-content-title {
            font-size: 16px;
            font-weight: 400;
            color: var(--yt-spec-text-primary);
            margin: 0;
        }

        .yt-filter-dropdown {
            height: 32px;
            padding: 0 12px;
            background-color: transparent;
            border: none;
            border-radius: 16px;
            font-size: 14px;
            color: var(--yt-spec-text-secondary);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: background-color 0.2s;
        }

            .yt-filter-dropdown:hover {
                background-color: var(--yt-spec-touch-response);
            }

        /* ============================================
           VIDEO GRID
           ============================================ */

        .yt-videos-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 16px 16px;
        }

        .yt-video-card {
            cursor: pointer;
        }

        .yt-video-thumbnail-container {
            position: relative;
            width: 100%;
            padding-bottom: 56.25%;
            border-radius: 12px;
            overflow: hidden;
            background-color: var(--yt-spec-menu-background);
        }

            .yt-video-thumbnail-container img {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.2s;
            }

        .yt-video-card:hover .yt-video-thumbnail-container img {
            transform: scale(1.05);
        }

        .yt-video-duration {
            position: absolute;
            bottom: 4px;
            right: 4px;
            background-color: rgba(0, 0, 0, 0.8);
            color: #fff;
            padding: 3px 4px;
            border-radius: 2px;
            font-size: 12px;
            font-weight: 500;
            line-height: 12px;
        }

        .yt-video-details {
            display: flex;
            gap: 12px;
            padding: 12px 0 0;
        }

        .yt-video-channel-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            flex-shrink: 0;
            object-fit: cover;
        }

        .yt-video-metadata {
            flex: 1;
            min-width: 0;
        }

        .yt-video-title {
            font-size: 14px;
            font-weight: 500;
            line-height: 20px;
            color: var(--yt-spec-text-primary);
            margin: 0 0 4px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .yt-video-channel-name {
            font-size: 12px;
            color: var(--yt-spec-text-secondary);
            margin: 0 0 2px;
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .yt-video-channel-name a {
                color: var(--yt-spec-text-secondary);
                text-decoration: none;
            }

                .yt-video-channel-name a:hover {
                    color: var(--yt-spec-text-primary);
                }

        .yt-video-stats {
            font-size: 12px;
            color: var(--yt-spec-text-secondary);
        }

        /* ============================================
           RESPONSIVE
           ============================================ */

        @@media (max-width: 1024px) {
            .yt-channel-header-inner

        {
            flex-wrap: wrap;
        }

        .yt-channel-actions {
            width: 100%;
            order: 3;
        }

        }

        @@media (max-width: 768px) {
            .yt-channel-banner

        {
            height: 150px;
        }

        .yt-channel-avatar {
            width: 120px;
            height: 120px;
        }

        .yt-channel-avatar-wrapper {
            margin-top: -60px;
        }

        .yt-channel-name {
            font-size: 24px;
        }

        .yt-videos-grid {
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        }

        .yt-nav-search {
            display: none;
        }

        }

        @@media (max-width: 480px) {
            .yt-channel-header-inner, .yt-channel-nav-inner, .yt-channel-content

        {
            padding-left: 16px;
            padding-right: 16px;
        }

        .yt-videos-grid {
            grid-template-columns: 1fr;
        }

        }

        /* Empty State */
        .yt-empty-state {
            text-align: center;
            padding: 48px 24px;
            color: var(--yt-spec-text-secondary);
        }

            .yt-empty-state i {
                font-size: 48px;
                margin-bottom: 16px;
                opacity: 0.5;
            }
    </style>
}

@section Scripts {
    <script>
        $(function () {
            loadAvailableVideos();
        });

        function loadAvailableVideos() {
            $.ajax({
                url: "/Member/GetMemberChannelVideos?channelId=" + '@Model.ChannelId',
                type: "GET",
                success: function (data) {
                    const result = data.result;
                    populateVideos(result);
                },
                error: function (xhr, status, error) {
                    console.error('Error fetching videos:', error);
                    $('#videosContainer').html('<div class="yt-empty-state"><i class="fas fa-video-slash"></i><p>Không có video nào để hiển thị.</p></div>');
                }
            });
        }

        function populateVideos(videos) {
            let html = '';

            if (videos && videos.length > 0) {
                videos.forEach(v => {
                    html += `
                    <div class="yt-video-card">
                        <a href="/Video/Watch/${v.id}" style="text-decoration: none;">
                            <div class="yt-video-thumbnail-container">
                                <img src="${v.thumbnail}" alt="${v.title}">
                                <div class="yt-video-duration">3:50</div>
                            </div>
                        </a>

                        <div class="yt-video-details">
                            <a href="/Member/Channel/${v.channelId}">
                                <img src="/img/s2.png" alt="Channel" class="yt-video-channel-avatar">
                            </a>

                            <div class="yt-video-metadata">
                                <h3 class="yt-video-title">
                                    <a href="/Video/Watch/${v.id}" style="color: inherit; text-decoration: none;">
                                        ${v.title}
                                    </a>
                                </h3>

                                <div class="yt-video-channel-name">
                                    <a href="/Member/Channel/${v.channelId}">
                                        @Model.Name
                                    </a>
                                    <i class="fas fa-check-circle" style="font-size: 12px;"></i>
                                </div>

                                <div class="yt-video-stats">
                                    ${v.numberOfViews} lượt xem • ${v.createdAtTimeAgo}
                                </div>
                            </div>
                        </div>
                    </div>
                    `;
                });
            } else {
                html = '<div class="yt-empty-state"><i class="fas fa-video-slash"></i><p>Không có video nào để hiển thị.</p></div>';
            }

            $('#videosContainer').html(html);
        }
    </script>
}