@model Web_Video.ViewModels.Member.MemberChannelViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="single-channel-image">
    <img class="img-fluid" alt="Channel Banner" src="/img/channel-banner.png">
    <div class="channel-profile">
        <img class="channel-profile-img" alt="Profile" src="/img/s2.png">
        <div class="social hidden-xs">
            Social &nbsp;
            <a class="fb" href="#">Facebook</a>
            <a class="tw" href="#">Twitter</a>
            <a class="gp" href="#">Google</a>
        </div>
    </div>
</div>
<div class="single-channel-nav">
    <nav class="navbar navbar-expand-lg navbar-light">
        <a class="channel-brand" href="#">@Model.Name <span title="" data-placement="top" data-toggle="tooltip" data-original-title="Verified"><i class="fas fa-check-circle text-success"></i></span></a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mr-auto">
                <li class="nav-item active">
                    <a class="nav-link" href="#">Videos <span class="sr-only">(current)</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Playlist</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Channels</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Discussion</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">About</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        Donate
                    </a>
                    <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                        <a class="dropdown-item" href="#">Action</a>
                        <a class="dropdown-item" href="#">Another action</a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="#">Something else here</a>
                    </div>
                </li>
            </ul>
            <form class="form-inline my-2 my-lg-0">
                <input class="form-control form-control-sm mr-sm-1" type="search" placeholder="Search" aria-label="Search">
                <button class="btn btn-outline-success btn-sm my-2 my-sm-0" type="submit"><i class="fas fa-search"></i></button> &nbsp;&nbsp;&nbsp;
                @if (User.GetUserChannelId() != Model.ChannelId.ToString())
                {
                    <form method="post" class="d-inline">
                        <button asp-action="SubscribeChannel" asp-route-channelId="@Model.ChannelId" type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="fas @(Model.UserIsSubscribed ? "fa-bell" : "fa-bell-slash")"></i> @(Model.UserIsSubscribed ? "Subscribed" : "Subscribe") <strong>@Model.NumberOfSubscribers.ToString("N0")</strong>
                        </button>
                    </form>
                }
            </form>
        </div>
    </nav>
</div>
<div class="video-block section-padding">
    <div class="row">
        <div class="col-md-12">
            <div class="main-title">
                <div class="btn-group float-right right-action">
                    <a href="#" class="right-action-link text-gray" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        Sort by <i class="fa fa-caret-down" aria-hidden="true"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-right">
                        <a class="dropdown-item" href="#"><i class="fas fa-fw fa-star"></i> &nbsp; Top Rated</a>
                        <a class="dropdown-item" href="#"><i class="fas fa-fw fa-signal"></i> &nbsp; Viewed</a>
                        <a class="dropdown-item" href="#"><i class="fas fa-fw fa-times-circle"></i> &nbsp; Close</a>
                    </div>
                </div>
                <h6>Available Videos</h6>
            </div>
        </div>
        <div class="row" id="videosContainer">
            <!-- Videos will be populated by JavaScript -->
        </div>
    </div>
</div>

@section Css {
    <style>
        /* Single Channel Image - YouTube Style */
        .single-channel-image {
            width: 100%;
            height: 200px;
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

            .single-channel-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .channel-profile {
            position: relative;
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
        }

        .channel-profile-img {
            width: 160px;
            height: 160px;
            border-radius: 50%;
            border: 4px solid #fff;
            margin-top: -80px;
            object-fit: cover;
        }

        .social {
            position: absolute;
            right: 24px;
            top: -40px;
        }

            .social a {
                color: #fff;
                margin: 0 8px;
                font-size: 14px;
                text-decoration: none;
            }

        /* Channel Nav */
        .single-channel-nav {
            background-color: #fff;
            border-bottom: 1px solid #e5e5e5;
            position: sticky;
            top: 56px;
            z-index: 100;
        }

            .single-channel-nav .navbar {
                max-width: 1280px;
                margin: 0 auto;
                padding: 0 24px;
            }

        .channel-brand {
            font-size: 24px;
            font-weight: 400;
            color: #0f0f0f;
            text-decoration: none;
        }

        .single-channel-nav .nav-link {
            color: #606060;
            font-size: 14px;
            font-weight: 500;
            padding: 14px 16px;
            border-bottom: 2px solid transparent;
            transition: all 0.2s;
        }

            .single-channel-nav .nav-link.active,
            .single-channel-nav .nav-link:hover {
                color: #0f0f0f;
                border-bottom-color: #0f0f0f;
            }

        /* Video Cards - giống Home */
        .video-card {
            cursor: pointer;
            background: transparent;
            border: none;
            border-radius: 0;
            box-shadow: none;
        }

        .video-card-image {
            position: relative;
            width: 100%;
            padding-top: 56.25%;
            overflow: hidden;
            border-radius: 12px;
            background-color: #f1f1f1;
        }

            .video-card-image img {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .time {
            position: absolute;
            bottom: 4px;
            right: 4px;
            background-color: rgba(0,0,0,0.8);
            color: #fff;
            font-size: 12px;
            font-weight: 500;
            padding: 3px 4px;
            border-radius: 2px;
        }

        .video-card-body {
            padding: 12px 0 0;
        }

        .video-title a {
            font-size: 14px;
            font-weight: 500;
            line-height: 20px;
            color: #0f0f0f;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .video-page,
        .video-view {
            font-size: 12px;
            color: #606060;
        }
    </style>
}

@section Scripts {
    <script>
        $(function () {
            loadAvailableVideos();
        });

        function loadAvailableVideos() {
            $.ajax({
                url: "/Member/GetMemberChannelVideos?channelId=" + '@Model.ChannelId',
                type: "GET",
                success: function (data) {
                    const result = data.result;
                    populateVideos(result);
                },
                error: function (xhr, status, error) {
                    console.error('Error fetching videos:', error);
                    $('#videosContainer').html('<div class="col-12 text-center p-3">Không có video nào để hiển thị.</div>');
                }
            });
        }

        function populateVideos(videos) {
            let html = '';

            if (videos && videos.length > 0) {
                videos.forEach(v => {
                    html += `
                        <div class="col-xl-3 col-sm-6 mb-3">
                            <div class="video-card">
                                <div class="video-card-image">
                                    <a class="play-icon" href="/Video/Watch/${v.id}"><i class="fas fa-play-circle"></i></a>
                                    <a href="/Video/Watch/${v.id}"><img src="${v.thumbnail}" alt="Video Thumbnail"></a>
                                    <div class="time">3:50</div>
                                </div>
                                <div class="video-card-body">
                                    <div class="video-title">
                                        <a href="/Video/Watch/${v.id}">${v.title}</a>
                                    </div>
                                    <div class="video-page text-success">
        @Model.Name <a title="" data-placement="top" data-toggle="tooltip" href="#" data-original-title="Verified"><i class="fas fa-check-circle text-success"></i></a>
                                    </div>
                                    <div class="video-view">
                                        ${v.numberOfViews} lượt xem &nbsp;<i class="fas fa-calendar-alt"></i> ${v.createdAtTimeAgo}
                                    </div>
                                </div>
                            </div>
                        </div>`;
                });
            } else {
                html = '<div class="col-12 text-center p-3">Không có video nào để hiển thị.</div>';
            }

            $('#videosContainer').html(html);
        }
    </script>
}