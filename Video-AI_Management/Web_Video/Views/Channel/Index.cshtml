@model Web_Video.ViewModels.Channel.ChannelAddEditViewModel
@{
    ViewData["Title"] = "My Channel";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Css {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-bs4.min.css" rel="stylesheet">
    <link href="/css/channelStyle.css" rel="stylesheet" />
}

<!-- Spinner toàn màn hình -->
<div id="globalLoading" style="display: none;">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<!-- Modal để chỉnh sửa thông tin channel -->
<div class="modal fade" id="editChannelModal" tabindex="-1" aria-labelledby="editChannelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #282828; border: none;">
            <div class="modal-header" style="border-bottom: 1px solid #3f3f3f;">
                <h5 class="modal-title" style="color: #f1f1f1;">Chỉnh sửa kênh</h5>
                <button type="button" class="btn-close btn-close-white" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editChannelForm" asp-action="EditChannel" asp-controller="Channel" method="post" enctype="multipart/form-data">
                    <div class="mb-4 text-center">
                        <img id="editAvatarPreview" src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "/avatarUser/avt-default.jpg" : Model.AvatarUrl)" alt="Avatar" style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; margin-bottom: 16px;">
                        <div>
                            <input type="file" id="editAvatarInput" name="Avatar" accept="image/*" style="display: none;">
                            <button type="button" class="btn-custom btn-customize" onclick="document.getElementById('editAvatarInput').click()">
                                <i class="bi bi-camera"></i>
                                Thay đổi ảnh đại diện
                            </button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label" style="color: #f1f1f1;">Tên kênh</label>
                        <input asp-for="Name" type="text" class="form-control" id="channelName" style="background-color: #3f3f3f; border: 1px solid #5f5f5f; color: #f1f1f1;">
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="About" class="form-label" style="color: #f1f1f1;">Mô tả kênh</label>
                        <textarea asp-for="About" class="form-control AboutChannel" id="channelAbout" rows="6" style="background-color: #3f3f3f; border: 1px solid #5f5f5f; color: #f1f1f1;"></textarea>
                        <span asp-validation-for="About" class="text-danger"></span>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="border-top: 1px solid #3f3f3f;">
                <button type="button" class="btn-custom btn-manage" data-dismiss="modal">Hủy</button>
                <button type="button" class="btn-custom btn-customize" onclick="submitEditChannelForm()">Cập nhật</button>
            </div>
        </div>
    </div>
</div>

@if (string.IsNullOrEmpty(Model.Name) || Model.Errors.Count > 0)
{
    <div class="channel-form-container">
        <h2>Tạo kênh của bạn</h2>
        <form asp-action="CreateChannel" method="post" enctype="multipart/form-data">
            <div class="mb-4 text-center">
                <img id="createAvatarPreview" src="/avatarChannel/channel-default.jpg" alt="Avatar" style="width: 120px; height: 120px; border-radius: 50%; object-fit: cover; margin-bottom: 16px;">
                <div>
                    <input type="file" id="createAvatarInput" name="Avatar" accept="image/*" style="display: none;">
                    <button type="button" class="btn-custom btn-customize" onclick="document.getElementById('createAvatarInput').click()">
                        <i class="bi bi-camera"></i>
                        Tải ảnh đại diện
                    </button>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label" style="color: #f1f1f1;">Tên kênh</label>
                <input asp-for="Name" type="text" class="form-control" style="background-color: #3f3f3f; border: 1px solid #5f5f5f; color: #f1f1f1;">
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="About" class="form-label" style="color: #f1f1f1;">Mô tả kênh</label>
                <textarea asp-for="About" rows="6" class="form-control AboutChannel" style="background-color: #3f3f3f; border: 1px solid #5f5f5f; color: #f1f1f1;"></textarea>
                <span asp-validation-for="About" class="text-danger"></span>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-custom btn-customize">Tạo kênh</button>
            </div>
        </form>
    </div>
}
else
{
    <!-- Channel Banner -->
    <div class="channel-banner">
        <img src="@(string.IsNullOrEmpty(Model.BannerUrl) ? "https://images.unsplash.com/photo-1579546929518-9e396f3cc809?w=1920" : Model.BannerUrl)" alt="Channel Banner">
    </div>

    <!-- Channel Info -->
    <div class="channel-info-wrapper">
        <div class="channel-info">
            <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "/avatarUser/avt-default.jpg" : Model.AvatarUrl)" alt="Channel Avatar" class="channel-avatar">
            <div class="channel-details">
                <h1 class="channel-name">@Model.Name</h1>
                <div class="channel-handle">@Model.Name • @Model.SubcribersCount.ToString("N0") người đăng ký</div>
                <div class="channel-stats">
                    <span>@Model.TotalVideos video</span>
                    <span class="stat-dot"></span>
                    <span>@Model.TotalViews.ToString("N0") lượt xem</span>
                    <span class="stat-dot"></span>
                    <span>Tham gia @Model.CreatedDate.ToString("dd MMMM yyyy")</span>
                </div>
                <div class="channel-actions">
                    <button class="btn-custom btn-customize" data-toggle="modal" data-target="#editChannelModal">
                        <i class="bi bi-pencil"></i>
                        Tùy chỉnh kênh
                    </button>
                    <a class="btn-custom btn-manage" href="@Url.Action("CreateEditVideo", "Video")">
                        <i class="bi bi-gear"></i>
                        Tải video lên
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="channel-nav">
        <div class="channel-nav-inner">
            <a class="nav-tab active" data-tab="myvideos">Video</a>
            <a class="nav-tab" data-tab="analytics">Phân tích</a>
            <a class="nav-tab" data-tab="profile">Giới thiệu</a>
        </div>
    </div>

    <!-- Content Area -->
    <div class="channel-content">
        <!-- Video Tab -->
        <div id="myvideos" class="tab-pane active">
            <div class="videos-section">
                <div class="section-header">
                    <div class="section-title">Tất cả video</div>
                    <button class="play-all-btn">
                        <i class="bi bi-play-fill"></i>
                        Phát tất cả
                    </button>
                </div>
                <div class="video-grid" id="videosGrid">
                    <!-- Videos will be populated here -->
                </div>
                <div id="loadingMore" style="display: none; text-align: center; margin-top: 20px;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Analytics Tab -->
        <div id="analytics" class="tab-pane">
            <div class="section-title">Tổng quan hiệu suất</div>
            <div class="analytics-overview">
                <div class="metric-card">
                    <div class="metric-header">
                        <div class="metric-label">Lượt xem</div>
                        <i class="bi bi-eye metric-icon"></i>
                    </div>
                    <div class="metric-value" id="totalViews">0</div>
                    <div class="metric-change positive">
                        <i class="bi bi-arrow-up"></i>
                        <span id="viewsChange">+0% so với tháng trước</span>
                    </div>
                </div>
                <div class="metric-card">
                    <div class="metric-header">
                        <div class="metric-label">Người đăng ký</div>
                        <i class="bi bi-person-plus metric-icon"></i>
                    </div>
                    <div class="metric-value" id="subscribers">0</div>
                    <div class="metric-change positive">
                        <i class="bi bi-arrow-up"></i>
                        <span id="subscribersChange">+0% so với tháng trước</span>
                    </div>
                </div>
                <div class="metric-card">
                    <div class="metric-header">
                        <div class="metric-label">Lượt thích</div>
                        <i class="bi bi-heart metric-icon"></i>
                    </div>
                    <div class="metric-value" id="likes">0</div>
                    <div class="metric-change positive">
                        <i class="bi bi-arrow-up"></i>
                        <span id="likesChange">+0% so với tháng trước</span>
                    </div>
                </div>
                <div class="metric-card">
                    <div class="metric-header">
                        <div class="metric-label">Bình luận</div>
                        <i class="bi bi-chat metric-icon"></i>
                    </div>
                    <div class="metric-value" id="comments">0</div>
                    <div class="metric-change positive">
                        <i class="bi bi-arrow-up"></i>
                        <span id="commentsChange">+0% so với tháng trước</span>
                    </div>
                </div>
            </div>
            <div class="chart-container">
                <div class="chart-header">
                    <div class="chart-title">Lượt xem theo thời gian</div>
                    <select class="time-filter" id="timeFilter">
                        <option value="7">7 ngày qua</option>
                        <option value="28" selected>28 ngày qua</option>
                        <option value="90">90 ngày qua</option>
                        <option value="all">Tất cả thời gian</option>
                    </select>
                </div>
                <canvas id="viewsChart" height="80"></canvas>
            </div>
            <div class="chart-container">
                <div class="chart-header">
                    <div class="chart-title">Nguồn lưu lượng truy cập</div>
                </div>
                <canvas id="trafficSourcesChart" height="80"></canvas>
            </div>
        </div>

        <!-- About Tab -->
        <div id="profile" class="tab-pane">
            <div class="about-content">
                <div class="about-section">
                    <h3>Mô tả</h3>
                    <p id="channelDescription">@Model.About</p>
                </div>
                <div class="about-section">
                    <h3>Thống kê kênh</h3>
                    <div class="about-stats-grid">
                        <div class="stat-item">
                            <i class="bi bi-calendar-event stat-icon"></i>
                            <div class="stat-content">
                                <div class="stat-value">@Model.CreatedDate.ToString("dd MMMM yyyy")</div>
                                <div class="stat-label">Ngày tham gia</div>
                            </div>
                        </div>
                        <div class="stat-item">
                            <i class="bi bi-eye stat-icon"></i>
                            <div class="stat-content">
                                <div class="stat-value" id="totalViewsAbout">@Model.TotalViews.ToString("N0")</div>
                                <div class="stat-label">Tổng lượt xem</div>
                            </div>
                        </div>
                        <div class="stat-item">
                            <i class="bi bi-camera-video stat-icon"></i>
                            <div class="stat-content">
                                <div class="stat-value">@Model.TotalVideos</div>
                                <div class="stat-label">Tổng số video</div>
                            </div>
                        </div>
                        <div class="stat-item">
                            <i class="bi bi-people stat-icon"></i>
                            <div class="stat-content">
                                <div class="stat-value" id="subscribersAbout">@Model.SubcribersCount.ToString("N0")</div>
                                <div class="stat-label">Người đăng ký</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="about-section">
                    <h3>Liên kết</h3>
                    <div class="about-links">
                        <a href="#" class="social-link" title="Website"><i class="bi bi-globe"></i></a>
                        <a href="#" class="social-link" title="Twitter"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="social-link" title="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-link" title="Facebook"><i class="bi bi-facebook"></i></a>
                    </div>
                </div>
            </div>
        </div>

    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-bs4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

    <script>
        let pageNumber = 1;
        let pageSize = 10; // Số video mỗi lần tải
        let sortBy = '';
        let isLoading = false;
        let hasMoreVideos = true;
        let viewsChart, trafficChart;

        $(document).ready(function () {
            // Khởi tạo summernote cho phần About
            $('.AboutChannel').summernote({
                height: 200,
                toolbar: [
                    ['style', ['style']],
                    ['font', ['bold', 'italic', 'underline']],
                    ['para', ['ul', 'ol', 'paragraph']],
                    ['insert', ['link']],
                ]
            });

            // Xử lý chuyển tab
            $('.nav-tab').on('click', function () {
                $('.nav-tab').removeClass('active');
                $('.tab-pane').removeClass('active');

                $(this).addClass('active');
                const tabId = $(this).attr('data-tab');
                $('#' + tabId).addClass('active');

                localStorage.setItem('activeTab', '#' + tabId);

                if (tabId === 'analytics') {
                    updateAnalytics();
                } else if (tabId === 'myvideos') {
                    pageNumber = 1;
                    hasMoreVideos = true;
                    $('#videosGrid').empty();
                    getVideos();
                }
            });

            // Khôi phục tab đã chọn trước đó
            var activeTab = localStorage.getItem('activeTab');
            if (activeTab) {
                $('.nav-tab[data-tab="' + activeTab.substring(1) + '"]').click();
            } else {
                $('.nav-tab[data-tab="myvideos"]').click();
            }

            // Xử lý infinite scroll
            $(window).on('scroll', function () {
                if ($(window).scrollTop() + $(window).height() >= $('#videosGrid').offset().top + $('#videosGrid').outerHeight() - 100 && !isLoading && hasMoreVideos) {
                    getVideos();
                }
            });

            // Xử lý preview avatar khi upload
            $('#createAvatarInput').on('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        $('#createAvatarPreview').attr('src', e.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });

            $('#editAvatarInput').on('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        $('#editAvatarPreview').attr('src', e.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Cập nhật analytics khi thay đổi bộ lọc thời gian
            $('#timeFilter').on('change', updateAnalytics);

            // Tải tổng số lượt xem và subscribers cho tab About
            getTotalViewsForAbout();
        });

        function getVideos() {
            if (isLoading || !hasMoreVideos) return;

            isLoading = true;
            $('#videosGrid').append('<div class="video-card loading-skeleton" style="height: 250px;"></div>'.repeat(pageSize));

            $.ajax({
                url: "/Channel/GetVideosForChannelGrid",
                type: "GET",
                data: {
                    pageNumber: pageNumber,
                    pageSize: pageSize,
                    sortBy: sortBy
                },
                success: function (data) {
                    $('.loading-skeleton').remove();

                    // Kiểm tra cấu trúc response
                    if (!data || typeof data !== 'object') {
                        $('#videosGrid').append('<p>Đã xảy ra lỗi khi tải video: Phản hồi không hợp lệ.</p>');
                        hasMoreVideos = false;
                        return;
                    }

                    // Kiểm tra statusCode
                    if (data.statusCode !== 200) {
                        $('#videosGrid').append(`<p>Lỗi: ${data.message || 'Không thể tải video.'}</p>`);
                        hasMoreVideos = false;
                        return;
                    }

                    // Kiểm tra result
                    if (!data.result || !Array.isArray(data.result.items)) {
                        $('#videosGrid').append('<p>Đã xảy ra lỗi: Dữ liệu video không hợp lệ.</p>');
                        hasMoreVideos = false;
                        return;
                    }

                    const result = data.result;
                    if (result.items.length === 0) {
                        hasMoreVideos = false;
                        if (pageNumber === 1) {
                            $('#videosGrid').append('<p>Bạn chưa có video nào.</p>');
                        }
                    } else {
                        populateVideoGrid(result.items);
                        pageNumber++;
                        if (result.items.length < pageSize) {
                            hasMoreVideos = false;
                        }
                    }
                },
                error: function (xhr) {
                    $('.loading-skeleton').remove();
                    $('#videosGrid').append('<p>Đã xảy ra lỗi khi tải video: ' + (xhr.responseJSON?.message || 'Lỗi không xác định') + '</p>');
                    hasMoreVideos = false;
                },
                complete: function () {
                    isLoading = false;
                }
            });
        }

        function populateVideoGrid(videos) {
            let videoItems = '';

            if (videos.length > 0) {
                videos.forEach((v) => {
                    videoItems += '<div class="video-card">';
                    videoItems += '<div class="video-thumbnail-wrapper">';
                    videoItems += `<img src="${v.thumbnail || '/images/default-thumbnail.jpg'}" alt="${v.title}" class="video-thumbnail">`;
                    videoItems += `<span class="video-duration">${v.duration || '0:00'}</span>`;
                    videoItems += '<button class="video-menu"><i class="bi bi-three-dots-vertical"></i></button>';
                    videoItems += '</div>';
                    videoItems += '<div class="video-info">';
                    videoItems += `<div class="video-title"><a href="/Video/Watch/${v.id}">${v.title}</a></div>`;
                    videoItems += `<div class="video-meta">${v.views.toLocaleString()} lượt xem • ${new Date(v.createdAt).toLocaleDateString('vi-VN')}</div>`;
                    videoItems += '</div>';
                    videoItems += '</div>';
                });
            }

            $('#videosGrid').append(videoItems);

            // Xử lý menu dropdown cho video
            $('.video-menu').off('click').on('click', function () {
                const videoId = $(this).closest('.video-card').find('a').attr('href').split('/').pop();
                const videoTitle = $(this).closest('.video-card').find('.video-title').text();
                const dropdownMenu = `
                    <ul class="dropdown-menu show" style="position: absolute; top: 40px; right: 0;">
                        <li><a class="dropdown-item" href="/Video/CreateEditVideo/${videoId}"><i class="bi bi-pencil me-2"></i>Chỉnh sửa</a></li>
                        <li><a class="dropdown-item delete-video-btn" href="#" data-video-id="${videoId}" data-video-title="${videoTitle}"><i class="bi bi-trash3 me-2"></i>Xóa</a></li>
                        <span class="delete-loading"><div class="spinner-border spinner-border-sm text-primary" role="status"></div></span>
                    </ul>`;
                $(this).after(dropdownMenu);
            });
        }

        function getTotalViewsForAbout() {
            $.ajax({
                url: "/Channel/GetTotalViews",
                type: "GET",
                success: function (data) {
                    $('#totalViewsAbout').text(data.totalViews.toLocaleString());
                    $('#subscribersAbout').text(data.subscribers.toLocaleString());
                },
                error: function () {
                    $('#totalViewsAbout').text('0');
                    $('#subscribersAbout').text('0');
                }
            });
        }

        function updateAnalytics() {
            const timeFilter = $('#timeFilter').val();

            $.ajax({
                url: "/Channel/GetAnalytics",
                type: "GET",
                data: { timeFilter: timeFilter },
                success: function (data) {
                    $('#totalViews').text(data.totalViews.toLocaleString());
                    $('#subscribers').text(data.subscribers.toLocaleString());
                    $('#likes').text(data.likes.toLocaleString());
                    $('#comments').text(data.comments.toLocaleString());
                    $('#viewsChange').text(`+${data.viewsChange || 0}% so với tháng trước`);
                    $('#subscribersChange').text(`+${data.subscribersChange || 0}% so với tháng trước`);
                    $('#likesChange').text(`+${data.likesChange || 0}% so với tháng trước`);
                    $('#commentsChange').text(`+${data.commentsChange || 0}% so với tháng trước`);

                    if (viewsChart) viewsChart.destroy();
                    const viewsCtx = document.getElementById('viewsChart').getContext('2d');
                    viewsChart = new Chart(viewsCtx, {
                        type: 'line',
                        data: {
                            labels: data.viewsOverTime.labels,
                            datasets: [{
                                label: 'Lượt xem',
                                data: data.viewsOverTime.data,
                                borderColor: '#3ea6ff',
                                backgroundColor: 'rgba(62, 166, 255, 0.1)',
                                fill: true,
                                tension: 0.4,
                                borderWidth: 2
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: true,
                            plugins: {
                                legend: {
                                    display: false
                                }
                            },
                            scales: {
                                x: {
                                    grid: {
                                        color: '#3f3f3f'
                                    },
                                    ticks: {
                                        color: '#aaa'
                                    }
                                },
                                y: {
                                    grid: {
                                        color: '#3f3f3f'
                                    },
                                    ticks: {
                                        color: '#aaa'
                                    },
                                    beginAtZero: true
                                }
                            }
                        }
                    });

                    if (trafficChart) trafficChart.destroy();
                    const trafficCtx = document.getElementById('trafficSourcesChart').getContext('2d');
                    trafficChart = new Chart(trafficCtx, {
                        type: 'doughnut',
                        data: {
                            labels: data.trafficSources.labels,
                            datasets: [{
                                data: data.trafficSources.data,
                                backgroundColor: [
                                    '#3ea6ff',
                                    '#ff6b6b',
                                    '#4ecdc4',
                                    '#ffe66d',
                                    '#a8dadc'
                                ],
                                borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: true,
                            plugins: {
                                legend: {
                                    position: 'right',
                                    labels: {
                                        color: '#f1f1f1',
                                        padding: 15,
                                        font: {
                                            size: 12
                                        }
                                    }
                                }
                            }
                        }
                    });
                },
                error: function () {
                    $('#totalViews').text('0');
                    $('#subscribers').text('0');
                    $('#likes').text('0');
                    $('#comments').text('0');
                    $('#viewsChange').text('+0% so với tháng trước');
                    $('#subscribersChange').text('+0% so với tháng trước');
                    $('#likesChange').text('+0% so với tháng trước');
                    $('#commentsChange').text('+0% so với tháng trước');
                }
            });
        }

        function submitEditChannelForm() {
            $('#editChannelForm').submit();
        }

        $(document).on('click', '.delete-video-btn', async function (e) {
            e.preventDefault();
            const videoId = $(this).data('video-id');
            const videoTitle = $(this).data('video-title');
            const $deleteBtn = $(this);
            const $loadingSpinner = $deleteBtn.siblings('.delete-loading');

            const result = await confirmation('Bạn có chắc muốn xóa video ' + videoTitle + ' không?');
            if (result) {
                $deleteBtn.hide();
                $loadingSpinner.show();
                $('#globalLoading').show();

                $.ajax({
                    url: "/Video/DeleteVideo/" + videoId,
                    type: "DELETE",
                    success: function (data) {
                        displayNotification(data.isSuccess, data.title, data.message, 'modal');
                        pageNumber = 1;
                        hasMoreVideos = true;
                        $('#videosGrid').empty();
                        getVideos();
                    },
                    error: function (xhr) {
                        displayNotification(false, "Lỗi", "Đã xảy ra lỗi khi xóa video.", 'modal');
                    },
                    complete: function () {
                        $loadingSpinner.hide();
                        $deleteBtn.show();
                        $('#globalLoading').hide();
                    }
                });
            }
        });
    </script>
}