@model Web_Video.ViewModels.Home.HomeViewModel

@{
    ViewData["Title"] = "Video đã thích";
    ViewData["CurrentPage"] = "Liked";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="video-block section-padding">
    <div class="row">
        <div class="col-md-12">
            <div class="main-title">
                <div class="btn-group float-right right-action">
                    <a href="#" class="right-action-link text-gray" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        Sort by <i class="fa fa-caret-down" aria-hidden="true"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-right">
                        <a class="dropdown-item" href="#"><i class="fas fa-fw fa-star"></i> &nbsp; Top Rated</a>
                        <a class="dropdown-item" href="#"><i class="fas fa-fw fa-signal"></i> &nbsp; Viewed</a>
                        <a class="dropdown-item" href="#"><i class="fas fa-fw fa-times-circle"></i> &nbsp; Close</a>
                    </div>
                </div>
                <h6>Video đã thích</h6>
            </div>
        </div>
        <div id="likedContainer" class="row">
            <!-- Nội dung sẽ được tải động bằng JavaScript -->
        </div>
    </div>
</div>

@section Css {
    <link rel="stylesheet" href="~/css_new/osahan.css" asp-append-version="true">
    <style>
        .video-block {
            padding: 30px;
        }

        .video-card {
            background: #fff;
            border-radius: 2px;
            box-shadow: 0 0 11px #ececec;
            transition-duration: 0.4s;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .video-card-image {
            position: relative;
            border-radius: 2px 2px 0 0;
            overflow: hidden;
            flex-grow: 0;
            height: 180px; /* Chiều cao cố định cho thumbnail để đồng đều */
        }

            .video-card-image img {
                width: 100%;
                height: 100%; /* Đảm bảo ảnh lấp đầy khung */
                object-fit: cover;
            }

        .play-icon {
            opacity: 0;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.4);
            transition: opacity 0.4s;
        }

        .video-card:hover .play-icon {
            opacity: 1;
        }

        .play-icon .fas {
            color: #fff;
            font-size: 35px;
        }

        .time {
            background: #f5234a;
            border-radius: 2px;
            bottom: 5px;
            color: #fff;
            font-size: 11px;
            font-weight: 500;
            opacity: 0.7;
            padding: 0 6px;
            position: absolute;
            right: 5px;
        }

        .video-card:hover .time {
            opacity: 1;
        }

        .video-card-body {
            padding: 12px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .video-title a {
            color: #000;
            font-weight: 600;
            font-size: 16px;
            text-decoration: none;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .video-title a:hover {
                color: #ff516b;
            }

        .video-page {
            font-size: 11px;
            color: #606060;
            margin-top: 4px;
        }

        .video-view {
            font-size: 10px;
            color: #acacac;
            font-weight: 500;
            margin-top: 2px;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .youtube-filter-btn {
            border-radius: 20px;
            font-size: 14px;
            padding: 5px 12px;
        }

            .youtube-filter-btn.active {
                background-color: #ff516b;
                color: #fff;
                border-color: #ff516b;
            }

            .youtube-filter-btn:hover {
                background-color: #e0e0e0;
            }

        .form-control {
            border-radius: 20px;
            padding: 5px 12px;
        }
        /* Đảm bảo các card trong cùng hàng có chiều cao đồng đều /
        .row {
        display: flex;
        flex-wrap: wrap;
        margin-right: -15px;
        margin-left: -15px;
        align-items: stretch; / Căn chỉnh chiều cao đồng đều */
        }

        .col-xl-3, .col-sm-6 {
            padding-right: 15px;
            padding-left: 15px;
            display: flex;
        }
    </style>
}

@section Scripts {
    <script src="~/js/site.js"></script>
    <script src="~/js/home_home.js"></script>
}