@model Web_Video.ViewModels.Home.HomeViewModel

@{
    ViewData["Title"] = "Subscriptions";
    ViewData["CurrentPage"] = "Subscriptions";
}

@Html.AntiForgeryToken()

<div class="video-block section-padding">
    <div class="row">
        <div class="col-md-12">
            <div class="main-title">
                <h6 class="page-title">Subscriptions</h6>
            </div>
        </div>
        <div id="subscriptions-container" class="row w-100">
            <!-- Channel cards will be loaded here -->
        </div>
        <div id="loading" class="text-center w-100" style="display: none;">
            <div class="loading-spinner">
                <i class="fas fa-circle-notch fa-spin"></i>
                <p>Loading more channels...</p>
            </div>
        </div>
    </div>
</div>

@section Css {
    <style>
        /* ========================================
           SUBSCRIPTIONS PAGE - YOUTUBE MODERN LIGHT
           ======================================== */

        /* Main Layout */
        .video-block.section-padding {
            padding: 24px;
            background-color: #FFFFFF;
            min-height: calc(100vh - 56px);
        }

        /* Page Title */
        .main-title {
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid #E5E5E5;
        }

        .page-title {
            color: #0F0F0F;
            font-size: 20px;
            font-weight: 600;
            margin: 0;
        }

        /* Grid Container */
        #subscriptions-container {
            margin: 0 -12px;
        }

        /* Channel Card */
        .channel-card {
            padding: 0 12px;
            margin-bottom: 32px;
        }

        .channels-card {
            background: transparent;
            border: none;
            border-radius: 0;
            transition: none;
            text-align: center;
        }

        /* Avatar Section */
        .channels-card-image {
            position: relative;
            width: 136px;
            height: 136px;
            margin: 0 auto 16px;
            border-radius: 50%;
            overflow: hidden;
        }

            .channels-card-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 50%;
                transition: transform 0.2s ease;
            }

        .channels-card:hover .channels-card-image img {
            transform: scale(1.05);
        }

        /* Channel Info */
        .channels-card-body {
            padding: 0;
        }

        .channels-title {
            margin-bottom: 4px;
        }

            .channels-title a {
                color: #0F0F0F;
                font-size: 16px;
                font-weight: 500;
                text-decoration: none;
                display: block;
                transition: color 0.2s;
            }

                .channels-title a:hover {
                    color: #065FD4;
                }

        .channels-view {
            color: #606060;
            font-size: 14px;
            margin-bottom: 12px;
        }

        /* Unsubscribe Button */
        .unsubscribe-btn {
            background-color: #F2F2F2;
            color: #0F0F0F;
            border: none;
            padding: 10px 16px;
            border-radius: 18px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .unsubscribe-btn:hover {
                background-color: #E5E5E5;
            }

            .unsubscribe-btn:active {
                background-color: #D0D0D0;
            }

            .unsubscribe-btn i {
                font-size: 16px;
            }

        /* Loading Indicator */
        #loading {
            padding: 40px 0;
        }

        .loading-spinner {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }

            .loading-spinner i {
                font-size: 32px;
                color: #606060;
            }

            .loading-spinner p {
                color: #606060;
                font-size: 14px;
                margin: 0;
            }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 80px 20px;
        }

            .empty-state i {
                font-size: 64px;
                color: #E5E5E5;
                margin-bottom: 16px;
            }

            .empty-state h6 {
                color: #0F0F0F;
                font-size: 18px;
                font-weight: 500;
                margin-bottom: 8px;
            }

            .empty-state p {
                color: #606060;
                font-size: 14px;
                margin: 0;
            }

        /* Responsive Grid */
        @@media (min-width: 1400px) {
            .channel-card

        {
            flex: 0 0 25%;
            max-width: 25%;
        }

        }

        @@media (min-width: 992px) and (max-width: 1399px) {
            .channel-card

        {
            flex: 0 0 33.333333%;
            max-width: 33.333333%;
        }

        }

        @@media (min-width: 768px) and (max-width: 991px) {
            .channel-card

        {
            flex: 0 0 50%;
            max-width: 50%;
        }

        .channels-card-image {
            width: 120px;
            height: 120px;
        }

        }

        @@media (max-width: 767px) {
            .video-block.section-padding

        {
            padding: 16px 12px;
        }

        .channel-card {
            flex: 0 0 50%;
            max-width: 50%;
        }

        .channels-card-image {
            width: 100px;
            height: 100px;
        }

        .channels-title a {
            font-size: 14px;
        }

        .channels-view {
            font-size: 13px;
        }

        }

        @@media (max-width: 480px) {
            .channel-card

        {
            flex: 0 0 100%;
            max-width: 100%;
            margin-bottom: 24px;
        }

        .channels-card-image {
            width: 120px;
            height: 120px;
        }

        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            let pageNumber = 1;
            let pageSize = 12;
            let isLoading = false;
            let hasMoreData = true;
            const $container = $('#subscriptions-container');

            function loadSubscriptionsPage() {
                if (isLoading || !hasMoreData) return;

                isLoading = true;
                $('#loading').show();

                $.ajax({
                    url: `/Home/GetSubscriptions`,
                    type: 'GET',
                    data: { pageNumber: pageNumber, pageSize: pageSize },
                    success: function(response) {
                        $('#loading').hide();
                        isLoading = false;

                        if (response.statusCode === 200 && response.result && response.result.items) {
                            const subscriptions = response.result.items;

                            if (subscriptions.length === 0) {
                                hasMoreData = false;
                                if (pageNumber === 1) {
                                    $container.html(`
                                        <div class="col-12">
                                            <div class="empty-state">
                                                <i class="fas fa-user-friends"></i>
                                                <h6>No subscriptions yet</h6>
                                                <p>Channels you subscribe to will appear here</p>
                                            </div>
                                        </div>
                                    `);
                                }
                                return;
                            }

                            subscriptions.forEach(sub => {
                                const channelId = sub.id || sub.Id;
                                const channelName = sub.channelName || sub.ChannelName;
                                const videosCount = sub.videosCount || sub.VideosCount || 0;
                                const thumbnail = sub.thumbnail || sub.Thumbnail || '/avatarUser/avt-default.jpg';

                                const cardHtml = `
                                    <div class="channel-card">
                                        <div class="channels-card">
                                            <div class="channels-card-image">
                                                <a href="/Member/Channel/${channelId}">
                                                    <img src="${thumbnail}" alt="${channelName}">
                                                </a>
                                            </div>
                                            <div class="channels-card-body">
                                                <div class="channels-title">
                                                    <a href="/Member/Channel/${channelId}">${channelName}</a>
                                                </div>
                                                <div class="channels-view">
                                                    ${videosCount} videos
                                                </div>
                                                <button class="unsubscribe-btn" data-channel-id="${channelId}">
                                                    <i class="fas fa-check"></i>
                                                    Subscribed
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                `;
                                $container.append(cardHtml);
                            });

                            if (subscriptions.length < pageSize) {
                                hasMoreData = false;
                            } else {
                                pageNumber++;
                            }
                        }
                    },
                    error: function(xhr) {
                        $('#loading').hide();
                        isLoading = false;
                        console.error('Error loading subscriptions:', xhr);
                    }
                });
            }

            // Unsubscribe handler
            $(document).on('click', '.unsubscribe-btn', function() {
                const btn = $(this);
                const channelId = btn.data('channel-id');

                if (!confirm('Are you sure you want to unsubscribe from this channel?')) return;

                $.ajax({
                    url: '/Video/SubscribeChannel',
                    type: 'PUT',
                    data: { channelId: channelId },
                    success: function(response) {
                        if (response.statusCode === 200) {
                            btn.closest('.channel-card').fadeOut(300, function() {
                                $(this).remove();

                                // Check if container is empty
                                if ($container.children('.channel-card').length === 0) {
                                    $container.html(`
                                        <div class="col-12">
                                            <div class="empty-state">
                                                <i class="fas fa-user-friends"></i>
                                                <h6>No subscriptions yet</h6>
                                                <p>Channels you subscribe to will appear here</p>
                                            </div>
                                        </div>
                                    `);
                                }
                            });
                        } else {
                            alert(response.message || 'Failed to unsubscribe');
                        }
                    },
                    error: function() {
                        alert('An error occurred. Please try again.');
                    }
                });
            });

            // Infinite Scroll
            $(window).on('scroll', function() {
                if ($(window).scrollTop() + $(window).height() > $(document).height() - 100) {
                    loadSubscriptionsPage();
                }
            });

            // Initial load
            loadSubscriptionsPage();
        });
    </script>
}