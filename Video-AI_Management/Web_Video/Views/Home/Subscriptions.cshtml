@model Web_Video.ViewModels.Home.HomeViewModel

@{
    ViewData["Title"] = "Subscriptions";
    ViewData["CurrentPage"] = "Subscriptions";
}

@Html.AntiForgeryToken()

<div class="video-block section-padding">
    <div class="row">
        <div class="col-md-12">
            <div class="main-title">
                <div class="btn-group float-right right-action">
                    <a href="#" class="right-action-link text-gray" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        Sort by <i class="fa fa-caret-down" aria-hidden="true"></i>
                    </a>
                    <div class="dropdown-menu dropdown-menu-right">
                        <a class="dropdown-item" href="#"><i class="fas fa-fw fa-star"></i> &nbsp; Top Rated</a>
                        <a class="dropdown-item" href="#"><i class="fas fa-fw fa-signal"></i> &nbsp; Viewed</a>
                        <a class="dropdown-item" href="#"><i class="fas fa-fw fa-times-circle"></i> &nbsp; Close</a>
                    </div>
                </div>
                <h6 class="text-primary">My Subscriptions</h6> <!-- Thay đổi màu sắc tiêu đề -->
            </div>
        </div>
        <div id="subscriptions-container" class="row justify-content-center">
            <!-- Danh sách kênh sẽ được thêm động bằng JavaScript -->
        </div>
        <div id="loading" class="text-center" style="display: none;">
            <p class="text-muted">Loading more channels...</p> <!-- Cải thiện văn bản loading -->
        </div>
    </div>
</div>

@section Css {
    <style>
        /* Channel Card - YouTube Style */
        .channels-card {
            border: none;
            border-radius: 0;
            overflow: visible;
            transition: none;
            background: transparent;
            box-shadow: none;
            margin-bottom: 24px;
        }

        .channels-card-image {
            position: relative;
            border-radius: 50%;
            overflow: hidden;
            width: 136px;
            height: 136px;
            margin: 0 auto 16px;
        }

            .channels-card-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 50%;
            }

        .channels-card-image-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            display: flex;
            gap: 4px;
        }

            .channels-card-image-btn .btn {
                padding: 4px 8px;
                font-size: 12px;
                border-radius: 4px;
            }

        .channels-card-body {
            padding: 0;
            text-align: center;
        }

        .channels-title a {
            color: #0f0f0f;
            font-weight: 500;
            font-size: 16px;
            text-decoration: none;
            transition: color 0.2s;
        }

            .channels-title a:hover {
                color: #065fd4;
            }

        .channels-view {
            color: #606060;
            font-size: 14px;
            margin-top: 4px;
        }

        /* Unsubscribe Button */
        .unsubscribe-btn {
            background-color: #cc0000;
            color: #fff;
            border: none;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            cursor: pointer;
            transition: background 0.2s;
        }

            .unsubscribe-btn:hover {
                background-color: #ff0000;
            }

        /* Loading */
        #loading p {
            font-size: 14px;
            padding: 16px;
            color: #606060;
        }
    </style>
}
@section Scripts {
    <script>
        $(document).ready(function() {
            let pageNumber = 1;
            let pageSize = 12;
            let isLoading = false;
            let hasMoreData = true;
            const $container = $('#subscriptions-container'); // Định nghĩa biến container

            function loadSubscriptionsPage() {
                if (isLoading || !hasMoreData) return;

                isLoading = true;
                $('#loading').show();

                $.ajax({
                    url: `/Home/GetSubscriptions`, // Gọi đúng API vừa tạo
                    type: 'GET',
                    data: { pageNumber: pageNumber, pageSize: pageSize },
                    success: function(response) {
                        $('#loading').hide();
                        isLoading = false;

                        if (response.statusCode === 200 && response.result && response.result.items) {
                            const subscriptions = response.result.items;

                            if (subscriptions.length === 0) {
                                hasMoreData = false;
                                if (pageNumber === 1) {
                                    $container.html('<p class="text-center text-muted w-100 mt-4">Bạn chưa đăng ký kênh nào.</p>');
                                }
                                return;
                            }

                            subscriptions.forEach(sub => {
                                // Mapping dữ liệu từ API (chú ý chữ hoa/thường)
                                const channelId = sub.id || sub.Id;
                                const channelName = sub.channelName || sub.ChannelName;
                                const videosCount = sub.videosCount || sub.VideosCount || 0;
                                const thumbnail = sub.thumbnail || sub.Thumbnail || '/avatarUser/avt-default.jpg';

                                const cardHtml = `
                                <div class="col-xl-3 col-sm-6 mb-4">
                                    <div class="channels-card text-center">
                                        <div class="channels-card-image">
                                            <a href="/Member/Channel/${channelId}">
                                                <img class="img-fluid" src="${thumbnail}" alt="${channelName}">
                                            </a>
                                        </div>
                                        <div class="channels-card-body mt-2">
                                            <div class="channels-title">
                                                <a href="/Member/Channel/${channelId}" class="h6 text-dark text-decoration-none">${channelName}</a>
                                            </div>
                                            <div class="channels-view small text-muted">
                                                ${videosCount} videos
                                            </div>
                                            <button class="btn btn-danger btn-sm mt-2 unsubscribe-btn" data-channel-id="${channelId}">
                                                Đã đăng ký
                                            </button>
                                        </div>
                                    </div>
                                </div>`;
                                $container.append(cardHtml);
                            });

                            if (subscriptions.length < pageSize) {
                                hasMoreData = false;
                            } else {
                                pageNumber++;
                            }
                        }
                    },
                    error: function(xhr) {
                        $('#loading').hide();
                        isLoading = false;
                        console.error('Error loading subscriptions:', xhr);
                    }
                });
            }

            // Xử lý nút Hủy đăng ký
            $(document).on('click', '.unsubscribe-btn', function() {
                const btn = $(this);
                const channelId = btn.data('channel-id');

                if(!confirm('Bạn có chắc muốn hủy đăng ký kênh này?')) return;

                $.ajax({
                    url: '/Video/SubscribeChannel',
                    type: 'PUT',
                    data: { channelId: channelId },
                    success: function(response) {
                        if (response.statusCode === 200) {
                            // Xóa card khỏi giao diện
                            btn.closest('.col-xl-3').fadeOut(300, function() { $(this).remove(); });
                        } else {
                            alert(response.message);
                        }
                    }
                });
            });

            // Infinite Scroll
            $(window).on('scroll', function() {
                if ($(window).scrollTop() + $(window).height() > $(document).height() - 100) {
                    loadSubscriptionsPage();
                }
            });

            // Load lần đầu
            loadSubscriptionsPage();
        });
    </script>
}