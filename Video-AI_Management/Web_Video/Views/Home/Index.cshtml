@model Web_Video.ViewModels.Home.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ";
    ViewData["CurrentPage"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (!User.Identity.IsAuthenticated)
{
    <div class="text-center pt-4">
        <h2 class="h4" style="color:black;">Đăng nhập để khám phá các video clip tuyệt vời.</h2>
    </div>
}
else
{
    <partial name="_HomePartial" model="Model" />
}
@section Css {
    <link rel="stylesheet" href="~/css/home_home.css" asp-append-version="true">
}
@section Scripts {

    @* <script src="./vendor/jquery/jquery.min.js"></script> *@
    <script src="~/js/site.js"></script>
    <!-- Include utils trước -->
    @* <script src="/js/home_utils.js"></script> *@
    @* <script src="/js/home_index.js"></script> *@
    <script src="/js/home_home.js"></script>
}