@model Web_Video.ViewModels.Home.HomeViewModel
@{
    ViewData["Title"] = "Lịch sử xem";
    ViewData["CurrentPage"] = "History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="video-block section-padding" data-page="history">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="library-header">
                    <h1>Lịch sử xem</h1>
                </div>
            </div>
            <div class="col-md-12">
                <div id="historyContainer">
                    <!-- Nội dung sẽ được tải động bằng JavaScript -->
                </div>
                <div id="history-loading-indicator" style="display:none;">
                    <div class="spinner-border spinner-border-sm" role="status">
                        @* <span class="visually-hidden">Loading...</span> *@
                    </div>
                    Đang tải...
                </div>
            </div>
        </div>
    </div>
</div>

@section Css {
    <link rel="stylesheet" href="~/css/history_liked.css" asp-append-version="true">
}

@section Scripts {
    <script src="~/js/site.js"></script>
    <script src="~/js/home_home.js"></script>
}