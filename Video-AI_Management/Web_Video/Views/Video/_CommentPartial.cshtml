@model Web_Video.ViewModels.Video.CommentViewModel
@using Web_Video.Extensions

<div class="container my-4">
    <!-- Tiêu đề số lượng bình luận -->
    <h2 class="comments-header">
        @SD.FormatView(Model.AvailableComments.Count())
        @(Model.AvailableComments.Count() > 1 ? "Comments" : "Comment")
    </h2>

    <!-- Ô nhập bình luận -->
    <div class="comment-input">
        <img src="/avatarUser/avt-default.jpg" alt="User Avatar" />
        <form id="create-comment-form" style="flex: 1;">
            <input type="hidden" name="PostComment.VideoId" value="@Model.PostComment.VideoId" />
            <input type="hidden" name="__RequestVerificationToken" value="@Html.AntiForgeryToken().ToString()" />
            <input type="text" id="textComment" name="PostComment.Content"
                   class="form-control" placeholder="Add a comment..." />
            <div class="comment-actions" id="sectionCommentBtns">
                <button id="btnCancel" type="button" class="btn btn-cancel">Cancel</button>
                <button id="btnComment" type="submit" class="btn btn-comment">Comment</button>
            </div>
        </form>
    </div>

    <!-- Danh sách bình luận -->
    <div id="comments-list">
        @foreach (var comment in Model.AvailableComments)
        {
            var isOwner = comment.AppUserId == User.GetUserId();
            <div class="comment-item" id="comment-@comment.Id">
                <img src="/avatarUser/avt-default.jpg" alt="User Avatar" />
                <div class="comment-content">
                    <div class="comment-header">
                        @if (comment.FromChannelId != Guid.Empty)
                        {
                            <a asp-controller="Member" asp-action="Channel"
                               asp-route-id="@comment.FromChannelId" class="comment-author">
                                @comment.FromName
                            </a>
                        }
                        else
                        {
                            <span class="comment-author">@comment.FromName</span>
                        }
                        <span class="comment-time">
                            @SD.TimeAgo(comment.PostedAt)
                            @if (comment.IsEdited)
                            {
                                <span class="edited-label">(edited)</span>
                            }
                        </span>
                    </div>
                    <p class="comment-text">@comment.Content</p>

                    @if (isOwner)
                    {
                        <div class="comment-actions-wrapper">
                            <button class="btn btn-more-actions" data-comment-id="@comment.Id">
                                <i class="fa fa-ellipsis-v"></i>
                            </button>
                            <div class="comment-actions-menu" id="actions-menu-@comment.Id" style="display: none;">
                                <button class="btn btn-edit-comment" data-comment-id="@comment.Id">Edit</button>
                                <button class="btn btn-delete-comment" data-comment-id="@comment.Id"
                                        data-video-id="@Model.PostComment.VideoId">
                                    Delete
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <button class="load-more-btn btn btn-link" id="loadMoreComments" style="display: none;">
        Load More
    </button>
</div>