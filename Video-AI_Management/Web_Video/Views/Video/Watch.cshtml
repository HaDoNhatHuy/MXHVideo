@model Web_Video.ViewModels.Video.VideoWatchViewModel
@using Web_Video.Extensions
@{
    ViewData["CurrentPage"] = "Watch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="video-block section-padding">
    <div class="row">
        <!-- Phần video chính -->
        <div class="col-md-8">
            <div class="single-video-left">
                <!-- Video Player (sử dụng Video.js) -->
                <div class="single-video">
                    <video id="player" class="video-js vjs-default-skin vjs-big-play-centered" controls preload="auto" playsinline data-poster="@Model.Thumbnail">
                        <source src="/Video/GetVideoFile?videoId=@Model.Id" type="@(Model.VideoContentType ?? "video/mp4")" />
                        <p class="vjs-no-js">
                            To view this video please enable JavaScript, and consider upgrading to a web browser that
                            <a href="https://videojs.com/html5-video-support/" target="_blank">supports HTML5 video</a>
                        </p>
                    </video>
                </div>
                @* TEST VIDEO *@
                @* <video controls>
                    <source src="/Video/GetVideoFile?videoId=@Model.Id" type="@Model.VideoContentType" />
                    Your browser does not support the video tag.
                </video> *@
                <!-- Tiêu đề và lượt xem -->
                <div class="single-video-title box mb-3">
                    <h2><a href="#">@Model.Title</a></h2>
                    <p class="mb-0"><i class="fas fa-eye"></i> @SD.FormatView(Model.ViewersCount) views</p>
                </div>
                <!-- Thông tin kênh và nút hành động -->
                <div class="single-video-author box mb-3">
                    <div class="float-right">
                        @if (User.GetUserChannelId() != Model.ChannelId.ToString())
                        {
                            <button id="subscribeBtn" class="btn @(Model.IsSubscribed ? "btn-secondary subscribed" : "btn-danger")">
                                @(Model.IsSubscribed ? "Subscribed" : "Subscribe") <strong>@SD.FormatView(Model.SubscribersCount)</strong>
                            </button>
                        }
                        <button class="btn @(Model.IsLiked ? "btn-primary" : "btn-outline-primary")" id="likeBtn" onclick="likeDislike('likeBtn', 'like')">
                            <i class="fas fa-thumbs-up"></i> <span>@SD.FormatView(Model.LikesCount)</span>
                        </button>
                        <button class="btn @(Model.IsDisiked ? "btn-primary" : "btn-outline-primary")" id="dislikeBtn" onclick="likeDislike('dislikeBtn', 'dislike')">
                            <i class="fas fa-thumbs-down"></i> <span>@(Model.DislikesCount > 0 ? SD.FormatView(Model.DislikesCount) : "")</span>
                        </button>
                        <button class="btn btn-outline-primary" id="shareBtn" onclick="shareVideo()">
                            <i class="fas fa-share"></i> Share
                        </button>
                        <form method="post" style="display: inline;">
                            <button asp-action="DownloadVideoFile" asp-route-videoId="@Model.Id" type="submit" class="btn btn-outline-primary">
                                <i class="fas fa-download"></i> Download
                            </button>
                        </form>
                        <div class="btn-group">
                            <button class="btn btn-outline-primary" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <i class="fas fa-ellipsis-v"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-right">
                                <a class="dropdown-item" href="#" data-toggle="modal" data-target="#addToPlaylistModal" onclick="loadUserPlaylistsForModal('@Model.Id')">
                                    <i class="fas fa-fw fa-plus"></i> Add to Playlist
                                </a>
                                <a class="dropdown-item" href="#" data-toggle="modal" data-target="#reportModal">
                                    <i class="fas fa-fw fa-flag"></i>
                                    Report
                                </a>
                            </div>
                        </div>
                    </div>
                    <img class="img-fluid" src="@Model.ChannelAvatar" alt="@Model.ChannelName Avatar">
                    <p>
                        <a href="@Url.Action("Channel", "Member", new { id = Model.ChannelId })"><strong>@Model.ChannelName</strong></a>
                        <span title="" data-placement="top" data-toggle="tooltip" data-original-title="Verified"><i class="fas fa-check-circle text-success"></i></span>
                    </p>
                    <small>Published on @SD.TimeAgo(Model.CreatedAt)</small>
                </div>
                <!-- Thông tin video và mô tả -->
                <div class="single-video-info-content box mb-3">
                    @if (!string.IsNullOrEmpty(Model.RecognizedCelebrities))
                    {
                        <h6>Cast:</h6>
                        <p>@Model.RecognizedCelebrities.Replace("Đã nhận diện: ", "")</p>
                    }
                    <h6>Category:</h6>
                    <p>@(Model.CategoryName ?? "Unknown")</p>
                    <h6>About:</h6>
                    <div class="description-content" id="descriptionContent">
                        <p>@Html.Raw(Model.Description)</p>
                    </div>
                    @if (Model.CelebrityFrames != null && Model.CelebrityFrames.Any())
                    {
                        <h6>Frames:</h6>
                        <div class="frame-carousel">
                            <button class="carousel-btn prev" id="prevBtn"><i class="fas fa-chevron-left"></i></button>
                            <div class="carousel-content" id="carouselContent">
                                @foreach (var celebEntry in Model.CelebrityFrames.OrderBy(x => x.Value.First().Time))
                                {
                                    var celebName = celebEntry.Key;
                                    foreach (var frame in celebEntry.Value)
                                    {
                                        <div class="frame-card">
                                            <img src="data:image/jpeg;base64,@frame.FrameImage" alt="@celebName at @frame.Time seconds" class="frame-image" />
                                            @{
                                                var ts = TimeSpan.FromSeconds(frame.Time);
                                            }
                                            <p class="frame-time">@ts.ToString(@"mm\:ss")</p>
                                        </div>
                                    }
                                }
                            </div>
                            <button class="carousel-btn next" id="nextBtn"><i class="fas fa-chevron-right"></i></button>
                        </div>
                    }
                    else
                    {
                        <p class="no-duration">No celebrity frame information available.</p>
                    }
                    <h6>Tags:</h6>
                    <p class="tags mb-0">
                        @if (!string.IsNullOrEmpty(Model.RecognizedCelebrities))
                        {
                            var celebrities = Model.RecognizedCelebrities
                            .Replace("Đã nhận diện: ", "")
                            .Split(new[] { ", " }, StringSplitOptions.RemoveEmptyEntries);
                            foreach (var celebrity in celebrities)
                            {
                                <span><a href="#">@celebrity</a></span>
                            }
                        }
                        else
                        {
                            <span><a href="#">General</a></span>
                        }
                    </p>
                    <button class="btn btn-link show-more-btn" id="showMoreBtn">Show more</button>
                </div>
                <!-- Bình luận -->
                <div class="comments-section box mb-3">
                    <partial name="_CommentPartial" model="Model.CommentVM" />
                </div>
            </div>
        </div>
        <!-- Phần video đề xuất -->
        <div class="col-md-4">
            <div class="single-video-right">
                <div class="row">
                    @if (Model.CurrentPlaylistId.HasValue)
                    {
                        <!-- PHẦN MỚI: Hiển thị Playlist nếu đang xem trong ngữ cảnh Playlist -->
                        <partial name="_WatchPlaylistPartial" model="Model" />
                    }
                    @* else
                    { *@
                    <!-- PHẦN CŨ: Hiển thị Video đề xuất như bình thường -->
                    <div class="col-md-12">
                        <div class="adblock">
                            <div class="img">
                                Google AdSense<br>
                                336 x 280
                            </div>
                        </div>
                        <div class="main-title">
                            <div class="btn-group float-right right-action">
                                <a href="#" class="right-action-link text-gray" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    Sort by <i class="fa fa-caret-down" aria-hidden="true"></i>
                                </a>
                                <div class="dropdown-menu dropdown-menu-right">
                                    <a class="dropdown-item" href="#"><i class="fas fa-fw fa-star"></i> Top Rated</a>
                                    <a class="dropdown-item" href="#"><i class="fas fa-fw fa-signal"></i> Viewed</a>
                                    <a class="dropdown-item" href="#"><i class="fas fa-fw fa-times-circle"></i> Close</a>
                                </div>
                            </div>
                            <h6>Up Next</h6>
                        </div>
                    </div>
                    <div class="col-md-12">
                        @foreach (var video in Model.RecommendedVideos)
                        {
                            <div class="video-card video-card-list">
                                <div class="video-card-image">
                                    <a class="play-icon" href="@Url.Action("Watch", "Video", new { id = video.Id })"><i class="fas fa-play-circle"></i></a>
                                    <a href="@Url.Action("Watch", "Video", new { id = video.Id })"><img class="img-fluid" src="@video.Thumbnail" alt="@video.Title"></a>
                                </div>
                                <div class="video-card-body">
                                    <div class="btn-group float-right right-action">
                                        <a href="#" class="right-action-link text-gray" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                                        </a>
                                        <div class="dropdown-menu dropdown-menu-right">
                                            <a class="dropdown-item" href="#"><i class="fas fa-fw fa-star"></i> Top Rated</a>
                                            <a class="dropdown-item" href="#"><i class="fas fa-fw fa-signal"></i> Viewed</a>
                                            <a class="dropdown-item" href="#"><i class="fas fa-fw fa-times-circle"></i> Close</a>
                                        </div>
                                    </div>
                                    <div class="video-title">
                                        <a href="@Url.Action("Watch", "Video", new { id = video.Id })">@video.Title</a>
                                    </div>
                                    <div class="video-page text-success">
                                        @video.ChannelName <a title="" data-placement="top" data-toggle="tooltip" href="#" data-original-title="Verified"><i class="fas fa-check-circle text-success"></i></a>
                                    </div>
                                    <div class="video-view">
                                        @SD.FormatView(video.ViewersCount) views &nbsp;<i class="fas fa-calendar-alt"></i> @SD.TimeAgo(video.CreatedAt)
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="adblock mt-0">
                            <div class="img">
                                Google AdSense<br>
                                336 x 280
                            </div>
                        </div>
                    </div>
                    @* } *@
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Playlist Modal -->
<div class="modal fade" id="addToPlaylistModal" tabindex="-1" role="dialog" aria-labelledby="addToPlaylistModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addToPlaylistModalLabel">Lưu vào danh sách phát...</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="playlistListContainer">
                    <!-- Danh sách playlist sẽ được tải bằng JS -->
                    <div class="text-center p-3" id="playlistLoading"><i class="fas fa-spinner fa-spin"></i> Đang tải...</div>
                    <div id="playlistList"></div> <!-- Thêm div này để hiển thị danh sách -->
                </div>

                <hr class="my-3">

                <!-- Form tạo Playlist mới -->
                <div class="d-flex align-items-center">
                    <i class="fas fa-plus mr-3"></i>
                    <input type="text" class="form-control mr-2" id="newPlaylistName" placeholder="Nhập tên danh sách phát mới" required>
                    <button class="btn btn-danger btn-sm" id="btnCreateNewPlaylist">Tạo</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Báo cáo Video -->
<div class="modal fade" id="reportModal" tabindex="-1" role="dialog" aria-labelledby="reportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <!-- ... Modal Header ... -->
            <div class="modal-body">
                <form id="reportForm">
                    <input type="hidden" name="VideoId" value="@Model.Id" />
                    <input type="hidden" name="__RequestVerificationToken"
                           value="@Html.AntiForgeryToken().ToString()" />
                    <div class="form-group">
                        <label for="reportReason">Lý do báo cáo:</label>
                        <select class="form-control" id="reportReason" name="Reason" required>
                            <option value="">Chọn lý do</option>
                            <option value="Celebrity Copyright">Vi phạm bản quyền khuôn mặt người nổi tiếng</option>
                            <option value="Hate Speech">Nội dung thù địch/bắt nạt</option>
                            <option value="Sexual Content">Nội dung khiêu dâm</option>
                            <option value="Other">Lý do khác (Vui lòng ghi rõ)</option>
                        </select>
                    </div>

                    <!-- THÊM: Khu vực chọn Người nổi tiếng -->
                    <div class="form-group" id="celebritySelectionGroup" style="display: none; margin-top: 15px;">
                        <label>Chọn người nổi tiếng vi phạm:</label>
                        <div id="celebrityListContainer" class="d-flex flex-wrap gap-2">
                            <!-- Danh sách tên celeb sẽ được chèn vào đây bằng JS -->
                        </div>
                        <!-- Trường ẩn để lưu tên celeb được chọn -->
                        <input type="hidden" id="reportedCelebrityNameInput" name="ReportedCelebrityName" />
                        <span class="text-danger" id="celebrityError" style="font-size: 14px; display: none;">Vui lòng chọn một người nổi tiếng.</span>
                    </div>

                    <div class="form-group" id="otherReasonGroup" style="display: none; margin-top: 10px;">
                        <label for="otherReason">Mô tả chi tiết:</label>
                        <textarea class="form-control" id="otherReason" name="OtherReason"
                                  rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger mt-3" id="submitReportBtn">Gửi Báo cáo</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Css {
    <link href="/css/video-watch.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://vjs.zencdn.net/8.6.0/video-js.css" />
    <style>
        .video-js {
            border-radius: 4px;
            overflow: hidden;
            width: 100%;
            height: auto;
        }

        .vjs-big-play-button {
            margin: auto;
        }

        .frame-carousel {
            position: relative;
            display: flex;
            align-items: center;
            overflow: hidden;
            margin: 10px 0;
        }

        .carousel-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(0, 0, 0, 0.5);
            color: white;
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            font-size: 16px;
            cursor: pointer;
            z-index: 10;
            transition: background 0.3s;
        }

            .carousel-btn:hover {
                background: rgba(0, 0, 0, 0.8);
            }

            .carousel-btn.prev {
                left: 10px;
            }

            .carousel-btn.next {
                right: 10px;
            }

        .carousel-content {
            display: flex;
            overflow-x: auto;
            scroll-behavior: smooth;
            padding: 0 50px; /* Để tránh nút che frames */
            gap: 10px;
        }

        .frame-card {
            flex: 0 0 auto;
            min-width: 150px;
            text-align: center;
        }

        .frame-image {
            width: 100%;
            height: 100px;
            object-fit: cover;
            border-radius: 4px;
        }

        .frame-time {
            font-size: 12px;
            margin: 5px 0;
            color: #666;
        }

        .modal-content {
            border-radius: 8px;
        }

        .modal-header {
            border-bottom: 1px solid #e5e5e5;
        }

        .modal-body {
            padding: 20px;
        }
    </style>
}

@section Scripts {
    <script src="~/js/site.js"></script>
    <script src="https://vjs.zencdn.net/8.6.0/video.min.js"></script>
    <script>
        $(document).ready(function () {
            // Hàm displayNotification
            function displayNotification(isSuccess, title, message, type) {
                if (typeof toastr !== "undefined") {
                    if (isSuccess) toastr.success(message, title);
                    else toastr.error(message, title);
                } else {
                    alert(`${title}: ${message}`);
                }
            }

            // Hàm timeAgo
            function timeAgo(date) {
                const now = new Date();
                const posted = new Date(date);
                const diffInSeconds = Math.floor((now - posted) / 1000);
                if (diffInSeconds < 60) return "just now";
                if (diffInSeconds < 3600) return `${Math.floor(diffInSeconds / 60)} minutes ago`;
                if (diffInSeconds < 86400) return `${Math.floor(diffInSeconds / 3600)} hours ago`;
                return `${Math.floor(diffInSeconds / 86400)} days ago`;
            }

           // Hàm loadUserPlaylistsForModal
            window.loadUserPlaylistsForModal = function (videoId) {
                $('#playlistLoading').show();
                $('#playlistList').empty();

                $.ajax({
                    url: '/Playlist/GetUserPlaylistsSummary?videoId=' + videoId,
                    type: 'GET',
                    success: function (response) {
                        console.log('API Response (GetUserPlaylistsSummary):', response);
                        if (response.isSuccess && response.result) {
                            let html = '<ul class="list-group">';
                            response.result.forEach(playlist => {
                                html += `
                                    <li class="list-group-item">
                                        <input type="checkbox" id="playlist-${playlist.id}"
                                               ${playlist.isChecked ? 'checked' : ''}
                                               data-playlist-id="${playlist.id}"
                                               onchange="togglePlaylist('${videoId}', '${playlist.id}', this.checked)">
                                        <label for="playlist-${playlist.id}" style="margin-left: 10px;">${playlist.name}</label>
                                    </li>
                                `;
                            });
                            html += '</ul>';
                            $('#playlistList').html(html);
                        } else {
                            $('#playlistList').html('<p>Không có danh sách phát nào.</p>');
                        }
                        $('#playlistLoading').hide();
                    },
                    error: function (xhr, status, error) {
                        console.error('API Error (GetUserPlaylistsSummary):', error, xhr.status, xhr.responseText);
                        $('#playlistList').html('<p>Lỗi khi tải danh sách phát.</p>');
                        $('#playlistLoading').hide();
                    }
                });
            };

            // Hàm togglePlaylist
            window.togglePlaylist = function (videoId, playlistId, isChecked) {
                const data = { PlaylistId: playlistId, VideoId: videoId };
                console.log('Sending Toggle Request:', JSON.stringify(data));
                $.ajax({
                    url: '/Playlist/ToggleVideoInPlaylist',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        console.log('Toggle Response:', response);
                        if (response.isSuccess) {
                            displayNotification(true, 'Thành công', response.message, 'toastr');
                        } else {
                            alert(response.message);
                            $('#playlist-' + playlistId).prop('checked', !isChecked);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Toggle Error:', error, xhr.status, xhr.responseText);
                        alert('Lỗi khi cập nhật danh sách phát.');
                        $('#playlist-' + playlistId).prop('checked', !isChecked);
                    }
                });
            };

            $('#btnCreateNewPlaylist').on('click', function () {
            const playlistName = $('#newPlaylistName').val().trim();
            if (playlistName) {
                $.ajax({
                    url: '/Playlist/CreatePlaylist',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ Name: playlistName }),
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.isSuccess) {
                            $('#newPlaylistName').val(''); // Reset input
                            loadUserPlaylistsForModal('@Model.Id'); // Tải lại danh sách
                            displayNotification(true, 'Thành công', 'Đã tạo danh sách phát mới.', 'toastr');
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert('Lỗi khi tạo danh sách phát.');
                    }
                });
            }
        });

        // === 1. DỮ LIỆU CELEBRITIES TỪ DB (AN TOÀN 100%) ===
            const recognizedCelebritiesRaw = @Html.Raw(Json.Serialize(Model.RecognizedCelebrities ?? ""))
                .replace(/^"|"$/g, '')  // Loại bỏ dấu nháy kép thừa
                .trim();

            console.log('Raw celeb string:', recognizedCelebritiesRaw); // DEBUG

            // === 2. PARSE CHUỖI THÀNH MẢNG ===
            function parseCelebrities(raw) {
                if (!raw || typeof raw !== 'string' || raw.trim() === '') return [];
                raw = raw.trim();
                if (raw.includes("Không nhận diện được")) return [];

                const prefix = "Đã nhận diện: ";
                if (raw.startsWith(prefix)) {
                    return raw
                        .substring(prefix.length)
                        .split(',')
                        .map(n => n.trim())
                        .filter(n => n.length > 0);
                }
                return raw
                    .split(',')
                    .map(n => n.trim())
                    .filter(n => n.length > 0);
            }

            const availableCelebrities = parseCelebrities(recognizedCelebritiesRaw);
            console.log('Available celebs:', availableCelebrities); // DEBUG

            // === 3. MODAL REPORT: HIỂN THỊ NÚT CELEB ===
            $('#reportReason').on('change', function () {
                const reason = $(this).val();
                const $celebGroup = $('#celebritySelectionGroup');
                const $otherGroup = $('#otherReasonGroup');

                // Reset
                $otherGroup.hide();
                $('#otherReason').prop('required', false);
                $celebGroup.hide();
                $('#reportedCelebrityNameInput').val('');
                $('#celebrityError').hide();

                if (reason === 'Other') {
                    $otherGroup.show();
                    $('#otherReason').prop('required', true);
                }

                if (reason === 'Celebrity Copyright') {
                    if (availableCelebrities.length > 0) {
                        $celebGroup.show();
                        renderCelebrityButtons(availableCelebrities);
                    } else {
                        displayNotification(false, 'Cảnh báo',
                            'Video này không có dữ liệu nhận diện người nổi tiếng. Vui lòng chọn lý do khác.',
                            'toastr');
                        $(this).val(''); // reset
                        $otherGroup.show();
                        $('#otherReason').prop('required', true);
                    }
                }
            });

            // === 4. HIỂN THỊ NÚT CELEB ===
            function renderCelebrityButtons(celebs) {
                const $container = $('#celebrityListContainer');
                $container.empty();
                celebs.forEach(name => {
                    $container.append(`
                        <button type="button"
                                class="btn btn-sm btn-outline-primary me-2 mb-2 celebrity-btn"
                                data-name="${name}">
                            ${name}
                        </button>
                    `);
                });
            }

            // === 5. CLICK CHỌN CELEB ===
            $(document).on('click', '.celebrity-btn', function () {
                $('.celebrity-btn')
                    .removeClass('btn-primary')
                    .addClass('btn-outline-primary');
                $(this)
                    .removeClass('btn-outline-primary')
                    .addClass('btn-primary');
                $('#reportedCelebrityNameInput').val($(this).data('name'));
                $('#celebrityError').hide();
            });

            // === 6. SUBMIT BÁO CÁO ===
            $('#reportForm').on('submit', function (e) {
                e.preventDefault();
                const reason = $('#reportReason').val();

                if (reason === 'Celebrity Copyright' && !$('#reportedCelebrityNameInput').val()) {
                    $('#celebrityError').text('Vui lòng chọn một người nổi tiếng.').show();
                    return;
                }

                $.ajax({
                    url: '/Video/ReportVideo',
                    type: 'POST',
                    // data: $(this).serialize(),
                    data: {
                            VideoId: '@Model.Id',
                            Reason: $('#reportReason').val(),
                            OtherReason: $('#otherReason').val(),
                            ReportedCelebrityName: $('#reportedCelebrityNameInput').val() // THÊM DÒNG NÀY
                    },
                    success: function (res) {
                        displayNotification(res.isSuccess, 'Thông báo', res.message, 'toastr');
                        $('#reportModal').modal('hide');
                    },
                    error: function () {
                        displayNotification(false, 'Lỗi', 'Không thể gửi báo cáo. Vui lòng thử lại.', 'toastr');
                    }
                });
            });

            // Hàm shareVideo
            function shareVideo() {
                const url = window.location.href;
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(url).then(() => {
                        displayNotification(true, 'Copied', 'Video URL copied to clipboard', 'toastr');
                    }).catch(err => {
                        console.error('Clipboard error:', err);
                        prompt('Copy the URL below:', url);
                        displayNotification(true, 'Prompt', 'Please copy the URL manually', 'toastr');
                    });
                } else {
                    prompt('Copy the URL below:', url);
                    displayNotification(true, 'Prompt', 'Please copy the URL manually', 'toastr');
                }
            }

            // Hàm likeDislike
            function likeDislike(id, action) {
                let model = {
                    videoId: '@Model.Id',
                    action
                };
                if ($('#' + id).hasClass('btn-primary')) {
                    model.like = false;
                } else {
                    model.like = true;
                }
                $.ajax({
                    url: "/Video/LikeDislikeVideo",
                    type: "PUT",
                    data: model,
                    success: function (data) {
                        const commands = data.title.split('-');
                        commands.forEach(c => {
                            if (c == 'addLike') {
                                $('#likeBtn').addClass('btn-primary').removeClass('btn-outline-primary');
                                var $span = $('#likeBtn').find('span');
                                var currentNumber = parseInt($span.text()) || 0;
                                $span.text(currentNumber + 1);
                                $('#dislikeBtn').removeClass('btn-primary').addClass('btn-outline-primary');
                                var $dislikeSpan = $('#dislikeBtn').find('span');
                                var dislikeNumber = $dislikeSpan.text() ? parseInt($dislikeSpan.text()) : 0;
                                if (dislikeNumber > 0) $dislikeSpan.text(dislikeNumber - 1);
                            } else if (c == 'addDislike') {
                                $('#dislikeBtn').addClass('btn-primary').removeClass('btn-outline-primary');
                                var $span = $('#dislikeBtn').find('span');
                                var currentNumber = $span.text() ? parseInt($span.text()) : 0;
                                $span.text(currentNumber + 1);
                                $('#likeBtn').removeClass('btn-primary').addClass('btn-outline-primary');
                                var $likeSpan = $('#likeBtn').find('span');
                                var likeNumber = parseInt($likeSpan.text()) || 0;
                                if (likeNumber > 0) $likeSpan.text(likeNumber - 1);
                            } else if (c == 'removeLike') {
                                $('#likeBtn').removeClass('btn-primary').addClass('btn-outline-primary');
                                var $span = $('#likeBtn').find('span');
                                var currentNumber = parseInt($span.text()) || 0;
                                if (currentNumber > 0) $span.text(currentNumber - 1);
                            } else if (c == 'removeDislike') {
                                $('#dislikeBtn').removeClass('btn-primary').addClass('btn-outline-primary');
                                var $span = $('#dislikeBtn').find('span');
                                var currentNumber = $span.text() ? parseInt($span.text()) : 0;
                                if (currentNumber > 0) $span.text(currentNumber - 1);
                            }
                        });
                    },
                    error: function (xhr) {
                        console.error('Like/Dislike error:', xhr.statusText);
                        displayNotification(false, 'Error', `Failed to ${action}: ${xhr.statusText}`, 'toastr');
                    }
                });
            }

            // Gắn sự kiện click cho nút Like và Dislike
            $('#likeBtn').on('click', function () {
                likeDislike('likeBtn', 'like');
            });

            $('#dislikeBtn').on('click', function () {
                likeDislike('dislikeBtn', 'dislike');
            });

            // Hàm enterEditMode và exitEditMode
            function enterEditMode(commentId, content) {
                const $form = $('#create-comment-form');
                const $input = $('#textComment');
                const $btnComment = $('#btnComment');
                $input.val(content);
                $form.data('edit-comment-id', commentId);
                $form.attr('action', '/Video/EditComment');
                $btnComment.text('Save');
                $('#sectionCommentBtns').fadeIn();
            }

            function exitEditMode() {
                const $form = $('#create-comment-form');
                const $input = $('#textComment');
                const $btnComment = $('#btnComment');
                $input.val('');
                $form.removeData('edit-comment-id');
                $form.attr('action', '/Video/CreateComment');
                $btnComment.text('Comment');
                $('#sectionCommentBtns').fadeOut();
            }

            // Khởi tạo Video.js
            const videoId = '@Model.Id';
            const player = videojs('player', {
                controls: true,
                autoplay: false,
                preload: 'auto',
                fluid: true,
                aspectRatio: '16:9',
                playbackRates: [0.5, 0.75, 1, 1.5, 2],
                controlBar: {
                    volumePanel: { inline: false },
                    pictureInPictureToggle: true,
                    fullscreenToggle: true
                }
            });

            // Thêm kiểm tra thời lượng xem ≥30s
            let viewRecorded = false;
            let watchStartTime = new Date();
            player.on('timeupdate', () => {
                const currentTime = Math.floor(player.currentTime());
                const watchDuration = (new Date() - watchStartTime) / 1000;
                if (watchDuration >= 10 && !viewRecorded) {
                    $.ajax({
                        url: `/Home/AddOrUpdateView?videoId=@Model.Id`,
                        type: 'POST',
                        success: function () {
                            console.log('View recorded after 30s watch time');
                            viewRecorded = true;
                        },
                        error: function (xhr) {
                            console.error('Error recording view after 30s:', xhr.statusText);
                        }
                    });
                }
            });

            // Debug: Kiểm tra player đã khởi tạo
            console.log('Video.js player initialized:', player);
            // Debug seek event
            player.on('seeked', () => {
                console.log('Seeked to:', player.currentTime());
            });

            // Set thời gian bắt đầu từ ProgressSeconds hoặc localStorage
            player.on('loadedmetadata', () => {
                const savedProgress = @(Model.ProgressSeconds ?? 0) || parseFloat(localStorage.getItem(`progress_${videoId}`)) || 0;
                if (savedProgress > 0) {
                    player.currentTime(savedProgress);
                    console.log(`Resumed from ${savedProgress} seconds`);
                } else {
                    console.log('No saved progress, starting from 0');
                }
            });

            // Lưu tiến trình mỗi 5 giây
            let lastSavedTime = 0;
            player.on('timeupdate', () => {
                const currentTime = Math.floor(player.currentTime());
                if (Math.abs(currentTime - lastSavedTime) >= 5) {
                    lastSavedTime = currentTime;
                    localStorage.setItem(`progress_${videoId}`, currentTime);
                    $.ajax({
                        url: '/Video/UpdateProgress',
                        type: 'POST',
                        data: { videoId: '@Model.Id', progressSeconds: currentTime },
                        success: function () { console.log(`Progress saved: ${currentTime}s`); },
                        error: function (xhr) {
                            console.error('Update progress error:', xhr.statusText);
                            console.log('Saved to localStorage as fallback');
                        }
                    });
                }
            });

            // Lưu tiến trình khi rời trang
            window.addEventListener('beforeunload', () => {
                const currentTime = Math.floor(player.currentTime());
                if (currentTime > 0) {
                    localStorage.setItem(`progress_${videoId}`, currentTime);
                    const data = new FormData();
                    data.append('videoId', '@Model.Id');
                    data.append('progressSeconds', currentTime);
                    navigator.sendBeacon('/Video/UpdateProgress', data);
                    console.log('Sent beacon for progress:', currentTime);
                }
            });

            // Xử lý lỗi video
            player.on('error', function (e) {
                console.error('Video.js error:', e);
                console.error('Video source:', player.currentSource());
                console.error('Media can play:', player.canPlayType(player.currentSource().type));
                displayNotification(false, 'Video Error', 'Không thể phát video. Kiểm tra định dạng video hoặc trình duyệt.', 'toastr');
            });

            // Log khi video play
            player.on('play', () => {
                console.log('Video is playing');
            });

            // Khởi tạo tooltip cho Bootstrap
            $('[data-toggle="tooltip"]').tooltip();

            // Xử lý nút Show More/Show Less
            $('#showMoreBtn').on('click', function () {
                const $description = $('#descriptionContent');
                const isExpanded = $description.hasClass('expanded');
                $description.toggleClass('expanded');
                $(this).text(isExpanded ? 'Show more' : 'Show less');
            });

            // Ẩn nút Show More nếu mô tả ngắn
            const descriptionHeight = $('#descriptionContent').height();
            if (descriptionHeight <= 50) {
                $('#showMoreBtn').hide();
            }

            // Xử lý carousel khung hình
            function moveCarousel(direction) {
                const carousel = document.getElementById('carouselContent');
                const cards = carousel.getElementsByClassName('frame-card');
                if (cards.length === 0) return;
                const cardWidth = cards[0].offsetWidth + 10;
                const currentScroll = carousel.scrollLeft;
                const maxScroll = (cards.length - Math.floor(carousel.offsetWidth / cardWidth)) * cardWidth;
                let newScroll = currentScroll + (direction * cardWidth);
                if (newScroll < 0) newScroll = 0;
                if (newScroll > maxScroll) newScroll = maxScroll;
                carousel.scrollTo({ left: newScroll, behavior: 'smooth' });
            }

            // Gắn sự kiện click cho nút prev/next
            $('#prevBtn').on('click', function () {
                moveCarousel(-1);
            });

            $('#nextBtn').on('click', function () {
                moveCarousel(1);
            });

            // Xử lý Subscribe
            $('#subscribeBtn').on('click', function () {
                $.ajax({
                    url: "/Video/SubscribeChannel",
                    type: "PUT",
                    data: { channelId: '@Model.ChannelId' },
                    success: function (data) {
                        if (data.title == "Unsubscribed") {
                            $('#subscribeBtn').removeClass('subscribed btn-secondary').addClass('btn-danger');
                            $('#subscribeBtn').html('Subscribe <strong>@SD.FormatView(Model.SubscribersCount)</strong>');
                            displayNotification(false, data.title, data.message, 'toastr');
                        } else if (data.title == "Subscribed") {
                            $('#subscribeBtn').removeClass('btn-danger').addClass('subscribed btn-secondary');
                            $('#subscribeBtn').html('Subscribed <strong>@SD.FormatView(Model.SubscribersCount)</strong>');
                            displayNotification(true, data.title, data.message, 'toastr');
                        } else {
                            displayNotification(data.isSuccess, data.title, data.message, 'modal');
                        }
                    },
                    error: function (xhr) {
                        displayNotification(false, 'Error', `Failed to subscribe: ${xhr.statusText}`, 'toastr');
                    }
                });
            });

            // Xử lý bình luận
            $('#textComment').on('input', function () {
                var text = $(this).val().trim();
                if (text.length > 0) {
                    $('#sectionCommentBtns').fadeIn();
                } else {
                    $('#sectionCommentBtns').fadeOut();
                }
            });

            $('#btnCancel').on('click', function () {
                exitEditMode();
            });

            $('#create-comment-form').on('submit', function (event) {
                event.preventDefault();
                const content = $('#textComment').val().trim();
                const videoId = $('input[name="PostComment.VideoId"]').val();
                const token = $('input[name="__RequestVerificationToken"]').val();
                const commentId = $(this).data('edit-comment-id');

                if (commentId) {
                    // Chế độ Edit
                    const data = {
                        commentId: commentId,
                        videoId: videoId,
                        content: content,
                        __RequestVerificationToken: token
                    };
                    $.ajax({
                        url: '/Video/EditComment',
                        type: 'POST',
                        data: data,
                        success: function (data) {
                            if (data.isSuccess) {
                                const commentText = $(`#comment-${commentId} .comment-text`);
                                commentText.text(content);
                                const commentTime = $(`#comment-${commentId} .comment-time`);
                                if (!commentTime.find('.edited-label').length) {
                                    commentTime.append('<span class="edited-label">(edited)</span>');
                                }
                                exitEditMode();
                            } else {
                                console.error('Edit comment failed:', data.message);
                            }
                        },
                        error: function (xhr) {
                            console.error('Edit comment error:', xhr.statusText);
                        }
                    });
                } else {
                    // Chế độ Create
                    const data = {
                        PostComment: {
                            VideoId: videoId,
                            Content: content
                        },
                        __RequestVerificationToken: token
                    };
                    $.ajax({
                        url: '/Video/CreateComment',
                        type: 'POST',
                        data: data,
                        success: function (data) {
                            if (data.isSuccess) {
                                const newComment = data.comment;
                                const isOwner = newComment.appUserId === '@User.GetUserId()';
                                const commentHtml = `
                                    <div class="comment-item" id="comment-${newComment.id}">
                                        <img src="/avatarUser/avt-default.jpg" alt="User Avatar" />
                                        <div class="comment-content">
                                            <div class="comment-header">
                                                <span class="comment-author">${newComment.fromName}</span>
                                                <span class="comment-time">${timeAgo(newComment.postedAt)}</span>
                                            </div>
                                            <p class="comment-text">${newComment.content}</p>
                                            ${isOwner ? `
                                                <div class="comment-actions-wrapper">
                                                    <button class="btn btn-more-actions" data-comment-id="${newComment.id}">
                                                        <i class="fa fa-ellipsis-v"></i>
                                                    </button>
                                                    <div class="comment-actions-menu" id="actions-menu-${newComment.id}" style="display: none;">
                                                        <button class="btn btn-edit-comment" data-comment-id="${newComment.id}">Edit</button>
                                                        <button class="btn btn-delete-comment" data-comment-id="${newComment.id}" data-video-id="${videoId}">Delete</button>
                                                    </div>
                                                </div>
                                            ` : ''}
                                        </div>
                                    </div>
                                `;
                                $('#comments-list').prepend(commentHtml);
                                const commentItems = $('.comment-item');
                                if (commentItems.length > 5) {
                                    commentItems.slice(5).remove();
                                }
                                const commentCount = commentItems.length;
                                $('.comments-header').text(`${commentCount} ${commentCount > 1 ? 'Comments' : 'Comment'}`);
                                $('#loadMoreComments').show();
                                $('#textComment').val('');
                                $('#sectionCommentBtns').fadeOut();
                            } else {
                                console.error('Create comment failed:', data.message);
                            }
                        },
                        error: function (xhr) {
                            console.error('Create comment error:', xhr.statusText);
                        }
                    });
                }
            });

            let currentPage = 1;
            const commentsPerPage = 5;
            function loadMoreComments() {
                $.ajax({
                    url: '/Video/GetCommentsByPage',
                    type: 'GET',
                    data: {
                        videoId: '@Model.Id',
                        page: currentPage + 1,
                        pageSize: commentsPerPage
                    },
                    success: function (data) {
                        if (data.isSuccess && data.comments && data.comments.length > 0) {
                            currentPage++;
                            const commentsList = $('#comments-list');
                            data.comments.forEach(comment => {
                                const isOwner = comment.appUserId === '@User.GetUserId()';
                                const commentHtml = `
                                    <div class="comment-item" id="comment-${comment.id}">
                                        <img src="/avatarUser/avt-default.jpg" alt="User Avatar" />
                                        <div class="comment-content">
                                            <div class="comment-header">
                                                <span class="comment-author">${comment.fromName}</span>
                                                <span class="comment-time">${timeAgo(comment.postedAt)}${comment.isEdited ? '<span class="edited-label">(edited)</span>' : ''}</span>
                                            </div>
                                            <p class="comment-text">${comment.content}</p>
                                            ${isOwner ? `
                                                <div class="comment-actions-wrapper">
                                                    <button class="btn btn-more-actions" data-comment-id="${comment.id}">
                                                        <i class="fa fa-ellipsis-v"></i>
                                                    </button>
                                                    <div class="comment-actions-menu" id="actions-menu-${comment.id}" style="display: none;">
                                                        <button class="btn btn-edit-comment" data-comment-id="${comment.id}">Edit</button>
                                                        <button class="btn btn-delete-comment" data-comment-id="${comment.id}" data-video-id="@Model.Id">Delete</button>
                                                    </div>
                                                </div>
                                            ` : ''}
                                        </div>
                                    </div>
                                `;
                                commentsList.append(commentHtml);
                            });
                            if (data.comments.length < commentsPerPage) {
                                $('#loadMoreComments').hide();
                            }
                        } else {
                            $('#loadMoreComments').hide();
                        }
                    },
                    error: function () {
                        console.error('Load more comments error');
                    }
                });
            }

            $('#loadMoreComments').on('click', loadMoreComments);

            // Xử lý click nút More và Edit/Delete bình luận
            $(document).on('click', '.btn-more-actions', function () {
                const commentId = $(this).data('comment-id');
                const $menu = $(`#actions-menu-${commentId}`);
                $('.comment-actions-menu').not($menu).hide();
                $menu.toggle();
            });

            $(document).on('click', function (event) {
                if (!$(event.target).closest('.btn-more-actions, .comment-actions-menu').length) {
                    $('.comment-actions-menu').hide();
                }
            });

            $(document).on('click', '.btn-edit-comment', function (event) {
                event.preventDefault();
                const commentId = $(this).data('comment-id');
                const commentText = $(`#comment-${commentId} .comment-text`).text();
                enterEditMode(commentId, commentText);
                $(`#actions-menu-${commentId}`).hide();
            });

            $(document).on('click', '.btn-delete-comment', function () {
                if (!confirm('Bạn có chắc muốn xóa bình luận này không?')) {
                    return;
                }
                const commentId = $(this).data('comment-id');
                const videoId = $(this).data('video-id');
                $.ajax({
                    url: '/Video/DeleteComment',
                    type: 'POST',
                    data: { commentId: commentId, videoId: videoId, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                    success: function (data) {
                        if (data.isSuccess) {
                            $(`#comment-${commentId}`).remove();
                            const commentCount = $('.comment-item').length;
                            $('.comments-header').text(`${commentCount} ${commentCount > 1 ? 'Comments' : 'Comment'}`);
                            if (commentCount >= commentsPerPage) {
                                $('#loadMoreComments').show();
                            }
                        } else {
                            console.error('Delete comment failed:', data.message);
                        }
                    },
                    error: function () {
                        console.error('Delete comment error');
                    }
                });
            });

            // Fix WAI-ARIA issue: Handle modal close to remove focus trap
            $('.modal').on('shown.bs.modal', function () {
                $(this).find('.close').attr('tabindex', '0').focus();
            }).on('hidden.bs.modal', function () {
                $(this).find('.close').removeAttr('tabindex');
            });

            $('#addToPlaylistModal').on('hidden.bs.modal', function () {
            $(this).removeAttr('aria-hidden');  // Hoặc dùng inert nếu browser hỗ trợ
            // Hoặc focus về button mở modal
            $('[data-target="#addToPlaylistModal"]').focus();
        });
            // --- AJAX LAZY LOAD GỢI Ý ---
        loadRecommendedVideos();
        });
                function loadRecommendedVideos() {
            // Hiển thị Skeleton/Spinner ở cột bên phải trước
            const $container = $('.single-video-right .col-md-12').first();
            // Lưu ý: Selector này tùy thuộc vào cấu trúc HTML hiện tại của bạn, đảm bảo trỏ đúng div chứa list video

            $container.html('<div class="text-center py-5"><div class="spinner-border text-danger"></div><p class="mt-2 text-muted">Đang tìm video liên quan...</p></div>');

            $.ajax({
                url: '/Video/GetRecommendedVideosAPI',
                type: 'GET',
                data: { videoId: '@Model.Id' },
                success: function(data) {
                    $container.empty(); // Xóa spinner

                    if (data && data.length > 0) {
                        let html = '';
                        // Render Title "Up Next"
                        html += `
                        <div class="main-title">
                            <h6>Tiếp theo</h6>
                        </div>`;

                        data.forEach(v => {
                            html += `
                            <div class="video-card video-card-list">
                                <div class="video-card-image">
                                    <a class="play-icon" href="/Video/Watch/${v.id}"><i class="fas fa-play-circle"></i></a>
                                    <a href="/Video/Watch/${v.id}"><img class="img-fluid" src="${v.thumbnail}" alt="${v.title}"></a>
                                    <div class="time">${v.duration}</div>
                                </div>
                                <div class="video-card-body">
                                    <div class="video-title"><a href="/Video/Watch/${v.id}">${v.title}</a></div>
                                    <div class="video-page text-success">${v.channelName} <i class="fas fa-check-circle text-success"></i></div>
                                    <div class="video-view">${formatView(v.viewersCount)} views • ${timeAgo(v.createdAt)}</div>
                                </div>
                            </div>`;
                        });
                        $container.append(html);
                    }
                },
                error: function() {
                    $container.html('<p class="text-center text-danger">Không thể tải đề xuất.</p>');
                }
            });
        }
                // Hàm phụ trợ (nếu chưa có)
        function formatView(views) {
            if(views >= 1000000) return (views/1000000).toFixed(1) + 'M';
            if(views >= 1000) return (views/1000).toFixed(1) + 'K';
            return views;
        }
    </script>
}