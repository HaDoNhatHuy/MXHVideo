@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-bs4.min.js"></script>
    <script>
                $(document).ready(function () {
            $('#Description').summernote();
            console.log('Summernote initialized');

            // Test hiển thị progress bar ngay khi load trang (để debug)
            console.log('Progress container exists:', $('#progressContainer').length);
            console.log('Progress container display:', $('#progressContainer').css('display'));
        });

        $(function () {
            const videoId = $('#videoId').val();
            if (videoId && videoId !== "00000000-0000-0000-0000-000000000000") {
                $('#videoUpload').prop("disabled", true);
                const url = $('#imageUrl').val();
                $('#previewImage').append(`<img src="${url}" class="card-img-top rounded preview-image" />`);
                console.log('Edit mode: Video upload disabled, image preview loaded');
            }
        });

        $('#imageUpload').on('change', function () {
            if (this.files && this.files[0]) {
                $('#previewImage').empty();
                var reader = new FileReader();
                reader.onload = function (event) {
                    $('#previewImage').append(`<img src="${event.target.result}" class="card-img-top rounded preview-image" />`);
                    console.log('Image preview updated');
                }
                reader.readAsDataURL(this.files[0]);
            }
        });

        let xhr;

        $('#videoAddEditForm').on('submit', function (e) {
            e.preventDefault();
            console.log('=== FORM SUBMITTED ===');

            const formData = new FormData(this);
            const progressContainer = $('#progressContainer');
            const progressBar = $('#progressBar');
            const progressText = $('#progressText');
            const recognitionLoading = $('#recognitionLoading');
            const resultContainer = $('#resultContainer');
            const uploadMessage = $('#uploadMessage');

            console.log('Elements found:');
            console.log('- progressContainer:', progressContainer.length);
            console.log('- progressBar:', progressBar.length);
            console.log('- progressText:', progressText.length);
            console.log('- recognitionLoading:', recognitionLoading.length);
            console.log('- uploadMessage:', uploadMessage.length);

            // Reset tất cả về trạng thái ban đầu
            resultContainer.empty();

            // ẨN tất cả trước
            recognitionLoading.hide();
            progressContainer.hide();
            uploadMessage.hide();

            // Set lại progress về 0
            progressBar.css('width', '0%').attr('aria-valuenow', 0);
            progressBar.removeClass('progress-bar-striped progress-bar-animated');
            progressText.text('0% (0 KB / 0 KB)');

            console.log('Reset complete');

            // HIỂN THỊ progress container - thử nhiều cách
            console.log('Attempting to show progress...');

            // Cách 1: show()
            progressContainer.show();
            uploadMessage.show();

            // Cách 2: css display
            progressContainer.css('display', 'block');
            uploadMessage.css('display', 'block');

            // Cách 3: removeClass nếu có class ẩn
            progressContainer.removeClass('d-none');
            uploadMessage.removeClass('d-none');

            // Cách 4: attr style
            progressContainer.attr('style', 'display: block !important;');
            uploadMessage.attr('style', 'display: block !important;');

            console.log('After show attempts:');
            console.log('- progressContainer display:', progressContainer.css('display'));
            console.log('- progressContainer visible:', progressContainer.is(':visible'));
            console.log('- uploadMessage display:', uploadMessage.css('display'));
            console.log('- uploadMessage visible:', uploadMessage.is(':visible'));

            // Vô hiệu hóa nút Save
            $('.btn-save').prop('disabled', true).text('Uploading...');

            xhr = new XMLHttpRequest();
            xhr.open('POST', '/Video/CreateEditVideo', true);
            console.log('XHR initialized');

                    xhr.upload.onprogress = function (event) {
            if (event.lengthComputable) {
                const percentComplete = Math.round((event.loaded / event.total) * 100);

                // Thêm class animating
                if (!progressBar.hasClass('animating')) {
                    progressBar.addClass('animating');
                }

                progressBar.css('width', percentComplete + '%');
                progressText.text(`${percentComplete}% (${formatBytes(event.loaded)} / ${formatBytes(event.total)})`);
            }
        };

        xhr.upload.onloadend = function () {
            // Xóa animation
            progressBar.removeClass('animating');

            progressContainer.hide();
            uploadMessage.hide();
            recognitionLoading.show();
            $('.btn-save').text('Processing...');
        };

            // Xử lý phản hồi từ server
            xhr.onload = function () {
                console.log('=== XHR COMPLETE ===');
                console.log('Status:', xhr.status);
                console.log('Response:', xhr.responseText.substring(0, 200));

                recognitionLoading.hide();

                if (xhr.status === 200) {
                    try {
                        const contentType = xhr.getResponseHeader('Content-Type');
                        console.log('Content-Type:', contentType);

                        if (contentType && contentType.includes('application/json')) {
                            const response = JSON.parse(xhr.responseText);
                            if (response.redirectUrl) {
                                console.log('Redirecting to:', response.redirectUrl);
                                window.location.href = response.redirectUrl;
                                return;
                            }
                        }
                        console.log('Redirecting to default: /Channel/Index');
                        window.location.href = '/Channel/Index';
                    } catch (e) {
                        console.error('Parse error:', e);
                        window.location.href = '/Channel/Index';
                    }
                } else if (xhr.status === 302) {
                    const redirectUrl = xhr.getResponseHeader('Location') || '/Channel/Index';
                    console.log('302 Redirect to:', redirectUrl);
                    window.location.href = redirectUrl;
                } else {
                    console.error('Error status:', xhr.status);
                    resultContainer.html(`<p class="text-danger"><i class="fas fa-exclamation-circle"></i> Lỗi upload: ${xhr.statusText} (Mã: ${xhr.status})</p>`);
                    $('.btn-save').prop('disabled', false).text('Save');
                }
            };

            xhr.onerror = function () {
                console.error('=== XHR ERROR ===');
                progressContainer.hide();
                uploadMessage.hide();
                recognitionLoading.hide();
                resultContainer.html('<p class="text-danger"><i class="fas fa-exclamation-circle"></i> Có lỗi kết nối mạng.</p>');
                $('.btn-save').prop('disabled', false).text('Save');
            };

            console.log('Sending XHR request...');
            xhr.send(formData);
        });

        // Hủy upload
        $('#cancelUpload').on('click', function (e) {
            e.preventDefault();
            console.log('Upload cancelled by user');
            if (xhr) {
                xhr.abort();
            }
            $('#progressContainer').hide();
            $('#uploadMessage').hide();
            $('#recognitionLoading').hide();
            $('#resultContainer').html('<p class="text-warning"><i class="fas fa-times-circle"></i> Upload đã bị hủy.</p>');
            $('.btn-save').prop('disabled', false).text('Save');
        });

        // Format bytes
        function formatBytes(bytes) {
            if (bytes === 0) return '0 KB';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }
    </script>
}