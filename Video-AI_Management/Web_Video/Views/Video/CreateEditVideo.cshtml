@model Web_Video.ViewModels.Video.VideoAddEditViewModel

@{
    ViewData["CurrentPage"] = "Upload Video";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Css {
    <!-- Summernote CSS -->
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-bs4.min.css" rel="stylesheet">
    <!-- YouTube Theme CSS -->
    <link href="/css_new/youtube-theme.css" rel="stylesheet" />

    <style>
        /* ===== YOUTUBE STUDIO LIGHT MODE ===== */
        body {
            background-color: #f9f9f9;
        }

        /* ===== MAIN CONTAINER ===== */
        .upload-studio-wrapper {
            max-width: 1400px;
            margin: 24px auto;
            padding: 0 24px;
        }

        .studio-header {
            margin-bottom: 24px;
        }

        .studio-title {
            font-size: 24px;
            font-weight: 500;
            color: #0f0f0f;
            margin: 0;
        }

        /* ===== LAYOUT 2 CỘT ===== */
        .upload-layout {
            display: grid;
            grid-template-columns: 380px 1fr;
            gap: 32px;
            align-items: start;
        }

        @@media (max-width: 1024px) {
            .upload-layout

        {
            grid-template-columns: 1fr;
        }

        }

        /* ===== CỘT TRÁI: PREVIEW & UPLOAD FILES ===== */
        .upload-preview-section {
            background: #fff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 20px;
            position: sticky;
            top: 80px;
        }

        .preview-label {
            font-size: 14px;
            font-weight: 500;
            color: #606060;
            margin-bottom: 12px;
            display: block;
        }

        .thumbnail-preview-box {
            width: 100%;
            aspect-ratio: 16/9;
            background: #f1f1f1;
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

            .thumbnail-preview-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .thumbnail-preview-box.empty::before {
                content: "📷";
                font-size: 48px;
                opacity: 0.3;
            }

        .file-upload-group {
            margin-bottom: 16px;
        }

        .file-upload-label {
            font-size: 13px;
            font-weight: 500;
            color: #0f0f0f;
            margin-bottom: 6px;
            display: block;
        }

        .file-upload-input {
            width: 100%;
            padding: 10px 12px;
            font-size: 13px;
            border: 1px solid #d0d0d0;
            border-radius: 4px;
            background-color: #fff;
            cursor: pointer;
            transition: border-color 0.2s;
        }

            .file-upload-input:hover {
                border-color: #909090;
            }

            .file-upload-input:focus {
                outline: none;
                border-color: #065fd4;
            }

        /* ===== CỘT PHẢI: METADATA FORM ===== */
        .upload-metadata-section {
            background: #fff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 32px;
        }

        .form-section {
            margin-bottom: 24px;
        }

        .form-label {
            font-size: 14px;
            font-weight: 500;
            color: #0f0f0f;
            margin-bottom: 8px;
            display: block;
        }

        .form-input,
        .form-select,
        .form-textarea {
            width: 100%;
            padding: 10px 12px;
            font-size: 14px;
            border: 1px solid #d0d0d0;
            border-radius: 4px;
            background-color: #fff;
            color: #0f0f0f;
            font-family: 'Roboto', Arial, sans-serif;
            transition: border-color 0.2s;
        }

            .form-input:focus,
            .form-select:focus,
            .form-textarea:focus {
                outline: none;
                border-color: #065fd4;
                box-shadow: 0 0 0 2px rgba(6, 95, 212, 0.1);
            }

        .form-textarea {
            min-height: 120px;
            resize: vertical;
        }

        /* ===== AI TOGGLE SECTION ===== */
        .ai-toggle-section {
            background: #f9f9f9;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 16px;
            margin-top: 20px;
        }

        .custom-switch {
            display: flex;
            align-items: center;
            cursor: pointer;
        }

        .custom-control-input {
            width: 40px;
            height: 20px;
            margin-right: 12px;
        }

        .custom-control-label {
            font-size: 14px;
            font-weight: 500;
            color: #0f0f0f;
            cursor: pointer;
        }

        .ai-toggle-hint {
            font-size: 12px;
            color: #606060;
            margin-top: 8px;
            line-height: 1.5;
        }

        /* ===== PROGRESS BAR - ĐỎ YOUTUBE ===== */
        #progressContainer {
            margin-top: 24px;
            padding: 24px;
            background: #fff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            display: none;
        }

        .custom-progress-wrapper {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

        .custom-progress {
            flex: 1;
            height: 6px;
            background: #f1f1f1;
            border-radius: 3px;
            overflow: hidden;
            position: relative;
        }

        .custom-progress-bar {
            height: 100%;
            background: linear-gradient(90deg, #ff0000 0%, #cc0000 100%);
            width: 0%;
            transition: width 0.3s ease;
            position: relative;
            border-radius: 3px;
        }

            /* Shimmer effect - ĐỎ */
            .custom-progress-bar.animating::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient( 90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.6) 50%, rgba(255, 255, 255, 0) 100% );
                animation: shimmerMove 1.5s infinite;
            }

        @@keyframes shimmerMove {
            0%

        {
            left: -100%;
        }

        100% {
            left: 200%;
        }

        }

        .custom-close-btn {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ff0000;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
            border-radius: 50%;
            transition: all 0.2s ease;
            flex-shrink: 0;
        }

            .custom-close-btn:hover {
                background: #cc0000;
                transform: scale(1.1);
                color: white;
                text-decoration: none;
            }

        #progressText {
            display: block;
            font-size: 13px;
            color: #606060;
            font-weight: 500;
            text-align: center;
        }

        #uploadMessage {
            font-size: 13px;
            color: #606060;
            margin-top: 16px;
            display: none;
            padding: 12px 16px;
            background: #fff9e6;
            border-left: 4px solid #ffc107;
            border-radius: 4px;
        }

        /* ===== AI LOADING SPINNER - ĐỎ YOUTUBE ===== */
        #recognitionLoading {
            margin-top: 24px;
            text-align: center;
            display: none;
            padding: 40px 24px;
            background: #fff;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
        }

        .face-recognition-container {
            position: relative;
            width: 120px;
            height: 120px;
            margin: 0 auto 24px;
        }

        /* Main face icon - ĐỎ */
        .face-icon {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 70px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #ff0000 0%, #cc0000 100%);
            border-radius: 50%;
            box-shadow: 0 4px 16px rgba(255, 0, 0, 0.3);
            animation: facePulse 2s infinite;
        }

            .face-icon svg {
                width: 40px;
                height: 40px;
                fill: white;
            }

        @@keyframes facePulse {
            0%, 100%

        {
            transform: translate(-50%, -50%) scale(1);
        }

        50% {
            transform: translate(-50%, -50%) scale(1.05);
        }

        }

        /* Rotating rings - ĐỎ */
        .scan-ring {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            border-radius: 50%;
            border: 3px solid transparent;
        }

        .scan-ring-1 {
            width: 100%;
            height: 100%;
            border-top-color: #ff0000;
            border-right-color: #ff0000;
            animation: rotateScan 2s linear infinite;
        }

        .scan-ring-2 {
            width: 85%;
            height: 85%;
            border-bottom-color: #cc0000;
            border-left-color: #cc0000;
            animation: rotateScan 1.5s linear infinite reverse;
        }

        @@keyframes rotateScan {
            0%

        {
            transform: translate(-50%, -50%) rotate(0deg);
        }

        100% {
            transform: translate(-50%, -50%) rotate(360deg);
        }

        }

        /* Corner brackets - ĐỎ */
        .corner-bracket {
            position: absolute;
            width: 24px;
            height: 24px;
            border: 3px solid #ff0000;
            animation: cornerBlink 1.5s infinite;
        }

            .corner-bracket.top-left {
                top: 0;
                left: 0;
                border-right: none;
                border-bottom: none;
                border-radius: 6px 0 0 0;
            }

            .corner-bracket.top-right {
                top: 0;
                right: 0;
                border-left: none;
                border-bottom: none;
                border-radius: 0 6px 0 0;
            }

            .corner-bracket.bottom-left {
                bottom: 0;
                left: 0;
                border-right: none;
                border-top: none;
                border-radius: 0 0 0 6px;
            }

            .corner-bracket.bottom-right {
                bottom: 0;
                right: 0;
                border-left: none;
                border-top: none;
                border-radius: 0 0 6px 0;
            }

        @@keyframes cornerBlink {
            0%, 100%

        {
            opacity: 0.3;
        }

        50% {
            opacity: 1;
        }

        }

        #recognitionLoading p {
            margin: 0;
            font-size: 14px;
            color: #606060;
            font-weight: 500;
        }

        .loading-dots::after {
            content: '';
            animation: dots 1.5s steps(4, end) infinite;
        }

        @@keyframes dots {
            0%, 20%

        {
            content: '';
        }

        40% {
            content: '.';
        }

        60% {
            content: '..';
        }

        80%, 100% {
            content: '...';
        }

        }

        /* ===== RESULT MESSAGES ===== */
        #resultContainer {
            margin-top: 16px;
        }

            #resultContainer p {
                padding: 12px 16px;
                border-radius: 4px;
                display: flex;
                align-items: center;
                gap: 10px;
                margin: 0;
                font-size: 13px;
                font-weight: 500;
            }

            #resultContainer .text-danger {
                color: #d32f2f;
                background: #ffebee;
                border-left: 4px solid #d32f2f;
            }

            #resultContainer .text-warning {
                color: #f57c00;
                background: #fff3e0;
                border-left: 4px solid #f57c00;
            }

            #resultContainer .text-success {
                color: #388e3c;
                background: #e8f5e9;
                border-left: 4px solid #388e3c;
            }

        /* ===== ACTION BUTTONS ===== */
        .action-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 32px;
            padding-top: 24px;
            border-top: 1px solid #e0e0e0;
        }

        .btn-studio-save {
            background-color: #cc0000;
            color: white;
            border: none;
            padding: 10px 24px;
            font-size: 14px;
            border-radius: 4px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
        }

            .btn-studio-save:hover {
                background-color: #b30000;
            }

            .btn-studio-save:disabled {
                background-color: #cccccc;
                cursor: not-allowed;
            }

        .btn-studio-back {
            background-color: transparent;
            color: #065fd4;
            border: 1px solid #065fd4;
            padding: 10px 24px;
            font-size: 14px;
            border-radius: 4px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-block;
        }

            .btn-studio-back:hover {
                background-color: rgba(6, 95, 212, 0.05);
                text-decoration: none;
            }

        /* ===== SUMMERNOTE OVERRIDE ===== */
        .note-editor.note-frame {
            border: 1px solid #d0d0d0;
            border-radius: 4px;
        }

            .note-editor.note-frame .note-editing-area .note-editable {
                background: #fff;
                color: #0f0f0f;
            }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 768px) {
            .upload-studio-wrapper

        {
            padding: 0 16px;
            margin: 16px auto;
        }

        .upload-layout {
            gap: 20px;
        }

        .upload-metadata-section {
            padding: 20px;
        }

        .studio-title {
            font-size: 20px;
        }

        .action-buttons {
            flex-direction: column-reverse;
        }

        .btn-studio-save,
        .btn-studio-back {
            width: 100%;
        }

        }
    </style>
}

<div class="upload-studio-wrapper">
    <!-- Header -->
    <div class="studio-header">
        <h1 class="studio-title">@(Model.Id != Guid.Empty ? "Edit Video" : "Upload Video")</h1>
    </div>
    <form id="videoAddEditForm" asp-action="CreateEditVideo" enctype="multipart/form-data">
    <!-- Layout 2 Cột -->
    <div class="upload-layout">
        <!-- CỘT TRÁI: Preview & Upload Files -->
        <div class="upload-preview-section">
            <span class="preview-label">Thumbnail Preview</span>
            <div class="thumbnail-preview-box empty" id="previewImage"></div>

            <div class="file-upload-group">
                <label class="file-upload-label" asp-for="ImageUpload">Thumbnail Image</label>
                <input id="imageUpload" asp-for="ImageUpload" type="file"
                       class="file-upload-input" accept="@Model.ImageContentTypes" />
                <span asp-validation-for="ImageUpload" class="text-danger"></span>
            </div>

            <div class="file-upload-group">
                <label class="file-upload-label" asp-for="VideoUpload">Video File</label>
                <input id="videoUpload" asp-for="VideoUpload" type="file"
                       class="file-upload-input" accept="@Model.VideoContentTypes" />
                <span asp-validation-for="VideoUpload" class="text-danger"></span>
            </div>
        </div>

        <!-- CỘT PHẢI: Metadata Form -->
        <div class="upload-metadata-section">
            
                <input id="videoId" hidden asp-for="Id" />
                <input id="imageUrl" asp-for="ImageUrl" hidden />

                <!-- Title -->
                <div class="form-section">
                    <label class="form-label" asp-for="Title">Video Title</label>
                    <input asp-for="Title" class="form-input" placeholder="Enter a descriptive title" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="form-section">
                    <label class="form-label" asp-for="Description">Description</label>
                    <textarea asp-for="Description" class="form-textarea" id="Description"
                              placeholder="Tell viewers about your video"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Category -->
                <div class="form-section">
                    <label class="form-label" asp-for="CategoryId">Category</label>
                    <select asp-for="CategoryId" asp-items="Model.CategoryDropdown" class="form-select">
                        <option disabled selected>Select a category</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <!-- AI Toggle -->
                <div class="ai-toggle-section">
                    <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="hasCelebToggle" asp-for="HasCelebrity">
                        <label class="custom-control-label" for="hasCelebToggle">
                            Enable AI face recognition (Video contains celebrities)
                        </label>
                    </div>
                    <div class="ai-toggle-hint">
                        <i class="fas fa-info-circle"></i>
                        If <strong>enabled</strong>: Processing may take several minutes.
                        If <strong>disabled</strong>: Video will be published immediately.
                    </div>
                </div>

                <!-- Progress Bar -->
                <div id="progressContainer">
                    <div class="custom-progress-wrapper">
                        <div class="custom-progress">
                            <div id="progressBar" class="custom-progress-bar"></div>
                        </div>
                        <a href="#" id="cancelUpload" class="custom-close-btn">✕</a>
                    </div>
                    <span id="progressText">
                        <span id="progressPercentage">0%</span>
                        (<span id="progressLoaded">0 KB</span> / <span id="progressTotal">0 KB</span>)
                    </span>
                </div>

                <!-- Upload Message -->
                <div id="uploadMessage">
                    ⚠️ Your video is uploading, please keep this page open until it's done.
                </div>

                <!-- AI Recognition Loading -->
                <div id="recognitionLoading">
                    <div class="face-recognition-container">
                        <!-- Rotating scan rings -->
                        <div class="scan-ring scan-ring-1"></div>
                        <div class="scan-ring scan-ring-2"></div>

                        <!-- Corner brackets -->
                        <div class="corner-bracket top-left"></div>
                        <div class="corner-bracket top-right"></div>
                        <div class="corner-bracket bottom-left"></div>
                        <div class="corner-bracket bottom-right"></div>

                        <!-- Center face icon -->
                        <div class="face-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                            </svg>
                        </div>
                    </div>
                    <p>🔍 Analyzing faces<span class="loading-dots"></span></p>
                </div>

                <!-- Result Container -->
                <div id="resultContainer"></div>

                <!-- Action Buttons -->
                <div class="action-buttons">
                    <a class="btn-studio-back" asp-controller="Channel" asp-action="Index">Cancel</a>
                    <button class="btn-studio-save" type="submit">Save</button>
                </div>
            
        </div>
    </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-bs4.min.js"></script>

    <script>
        $(document).ready(function () {
            $('#Description').summernote({
                height: 150,
                toolbar: [
                    ['style', ['bold', 'italic', 'underline']],
                    ['para', ['ul', 'ol']],
                    ['insert', ['link']]
                ]
            });
        });

        $(function () {
            const videoId = $('#videoId').val();
            if (videoId && videoId !== "00000000-0000-0000-0000-000000000000") {
                $('#videoUpload').prop("disabled", true);
                const url = $('#imageUrl').val();
                $('#previewImage').removeClass('empty').append(`<img src="${url}" class="preview-image" />`);
            }
        });

        $('#imageUpload').on('change', function () {
            if (this.files && this.files[0]) {
                $('#previewImage').removeClass('empty').empty();
                var reader = new FileReader();
                reader.onload = function (event) {
                    $('#previewImage').append(`<img src="${event.target.result}" />`);
                }
                reader.readAsDataURL(this.files[0]);
            }
        });

        let xhr;

        $('#videoAddEditForm').on('submit', function (e) {
            e.preventDefault();

        const form = this;
        const fileInput = document.getElementById('videoUpload');

        // SỬA 1: Kiểm tra độ dài mảng files thay vì kiểm tra biến object
        const hasFile = fileInput.files && fileInput.files.length > 0;
        const videoId = $('#videoId').val();

        // Kiểm tra validate: Nếu là tạo mới VÀ chưa chọn file
        if ((!videoId || videoId === "00000000-0000-0000-0000-000000000000") && !hasFile) {
            resultContainer.html('<p class="text-danger"><i class="fas fa-exclamation-circle"></i> Vui lòng chọn file video.</p>');
            $('.btn-studio-save').prop('disabled', false).text('Save');
            return;
        }

        // Khởi tạo FormData
        // new FormData(form) đã tự động lấy input có name="VideoUpload" rồi.
        const formData = new FormData(form);
            const progressContainer = $('#progressContainer');
            const progressBar = $('#progressBar');
            const recognitionLoading = $('#recognitionLoading');
            const resultContainer = $('#resultContainer');
            const uploadMessage = $('#uploadMessage');

            // Reset UI
            resultContainer.empty();
            recognitionLoading.hide();
            progressContainer.hide();
            uploadMessage.hide();
            progressBar.css('width', '0%').removeClass('animating');
            $('#progressPercentage').text('0%');

            const hasCeleb = $('#hasCelebToggle').is(':checked');

            // Show Progress
            progressContainer.show();
            uploadMessage.show();
            $('.btn-studio-save').prop('disabled', true).text('Uploading...');

            xhr = new XMLHttpRequest();
            xhr.open('POST', '/Video/CreateEditVideo', true);

            xhr.upload.onprogress = function (event) {
                if (event.lengthComputable) {
                    const percentComplete = Math.round((event.loaded / event.total) * 100);
                    if (!progressBar.hasClass('animating')) progressBar.addClass('animating');
                    progressBar.css('width', percentComplete + '%');
                    $('#progressPercentage').text(percentComplete + '%');
                    $('#progressLoaded').text(formatBytes(event.loaded));
                    $('#progressTotal').text(formatBytes(event.total));
                }
            };

            xhr.upload.onloadend = function () {
                progressBar.removeClass('animating');
                if (hasCeleb) {
                    progressContainer.hide();
                    uploadMessage.hide();
                    recognitionLoading.show();
                    $('.btn-studio-save').text('Running AI...');
                } else {
                    $('#uploadMessage').html('<i class="fas fa-save"></i> Saving video, please wait...');
                    $('.btn-studio-save').text('Saving...');
                }
            };

            xhr.onload = function () {
            recognitionLoading.hide();
            if (xhr.status === 200) {
                try {
                    const response = JSON.parse(xhr.responseText);

                    // CHỈ CHUYỂN HƯỚNG KHI IS_SUCCESS LÀ TRUE HOẶC CÓ redirectUrl
                    if (response.isSuccess === true) {
                        // Dùng redirectUrl nếu có, nếu không thì dùng mặc định /Channel/Index
                        window.location.href = response.redirectUrl || '/Channel/Index';
                    }
                    else if (response.isSuccess === false) {
                        // Nếu server trả về lỗi nghiệp vụ (ví dụ: thiếu video)
                        const message = response.message || 'Dữ liệu không hợp lệ.';
                        resultContainer.html(`<p class="text-danger"><i class="fas fa-exclamation-circle"></i> Lỗi: ${message}</p>`);
                        $('.btn-studio-save').prop('disabled', false).text('Save');
                    }
                    else {
                        // Trường hợp response không chứa isSuccess, coi là lỗi
                        resultContainer.html(`<p class="text-danger"><i class="fas fa-exclamation-circle"></i> Lỗi xử lý phản hồi (Cấu trúc JSON không rõ ràng).</p>`);
                        $('.btn-studio-save').prop('disabled', false).text('Save');
                    }

                } catch (e) {
                    // Xử lý khi parse JSON thất bại (server trả về HTML hoặc response rỗng)
                    console.error("Lỗi parse JSON:", e);
                    resultContainer.html(`<p class="text-danger"><i class="fas fa-exclamation-circle"></i> Lỗi nghiêm trọng: Server không trả về JSON hợp lệ.</p>`);
                    $('.btn-studio-save').prop('disabled', false).text('Save');
                }
            } else {
                // Xử lý các lỗi HTTP non-200 (ví dụ: 500 Internal Server Error)
                resultContainer.html(`<p class="text-danger"><i class="fas fa-exclamation-circle"></i> Lỗi: ${xhr.statusText || 'Lỗi mạng'}</p>`);
                $('.btn-studio-save').prop('disabled', false).text('Save');
            }
        };

            xhr.onerror = function () {
                recognitionLoading.hide();
                resultContainer.html(`<p class="text-danger"><i class="fas fa-exclamation-circle"></i> Network error.</p>`);
                $('.btn-studio-save').prop('disabled', false).text('Save');
            };

            xhr.send(formData);
        });

        $('#cancelUpload').on('click', function (e) {
            e.preventDefault();
            if (xhr) {
                xhr.abort();
            }
            $('#progressContainer').hide();
            $('#uploadMessage').hide();
            $('#recognitionLoading').hide();
            $('#resultContainer').html(`<p class="text-warning"><i class="fas fa-times-circle"></i> Upload cancelled.</p>`);
            $('.btn-studio-save').prop('disabled', false).text('Save');
        });

        function formatBytes(bytes) {
            if (bytes === 0) return '0 KB';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }
    </script>
}