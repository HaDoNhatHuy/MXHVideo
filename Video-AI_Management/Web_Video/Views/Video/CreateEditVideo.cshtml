@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-bs4.min.js"></script>
    <script>
                $(document).ready(function () {
            $('#Description').summernote();
            console.log('Summernote initialized');

            // Test hiển thị progress bar ngay khi load trang (để debug)
            console.log('Progress container exists:', $('#progressContainer').length);
            console.log('Progress container display:', $('#progressContainer').css('display'));
        });

        $(function () {
            const videoId = $('#videoId').val();
            if (videoId && videoId !== "00000000-0000-0000-0000-000000000000") {
                $('#videoUpload').prop("disabled", true);
                const url = $('#imageUrl').val();
                $('#previewImage').append(`<img src="${url}" class="card-img-top rounded preview-image" />`);
                console.log('Edit mode: Video upload disabled, image preview loaded');
            }
        });

        $('#imageUpload').on('change', function () {
            if (this.files && this.files[0]) {
                $('#previewImage').empty();
                var reader = new FileReader();
                reader.onload = function (event) {
                    $('#previewImage').append(`<img src="${event.target.result}" class="card-img-top rounded preview-image" />`);
                    console.log('Image preview updated');
                }
                reader.readAsDataURL(this.files[0]);
            }
        });

        let xhr;

            $('#videoAddEditForm').on('submit', function (e) {
            e.preventDefault();
            console.log('=== FORM SUBMITTED ===');

            const formData = new FormData(this);
            const progressContainer = $('#progressContainer');
            const progressBar = $('#progressBar');
            const recognitionLoading = $('#recognitionLoading');
            const resultContainer = $('#resultContainer');
            const uploadMessage = $('#uploadMessage');

            // Reset UI
            resultContainer.empty();
            recognitionLoading.hide();
            progressContainer.hide();
            uploadMessage.hide();
            progressBar.css('width', '0%').removeClass('animating');
            $('#progressPercentage').text('0%');

            // Kiểm tra checkbox có được tích không
            const hasCeleb = $('#hasCelebToggle').is(':checked');

            // Hiển thị Progress
            progressContainer.show();
            uploadMessage.show();
            $('.btn-save').prop('disabled', true).text('Uploading...');

            xhr = new XMLHttpRequest();
            xhr.open('POST', '/Video/CreateEditVideo', true);

            // Theo dõi upload
            xhr.upload.onprogress = function (event) {
                if (event.lengthComputable) {
                    const percentComplete = Math.round((event.loaded / event.total) * 100);
                    if (!progressBar.hasClass('animating')) progressBar.addClass('animating');
                    progressBar.css('width', percentComplete + '%');
                    $('#progressPercentage').text(percentComplete + '%');
                    $('#progressLoaded').text(formatBytes(event.loaded));
                    $('#progressTotal').text(formatBytes(event.total));
                }
            };

            // Khi upload xong file lên server
            xhr.upload.onloadend = function () {
                console.log('Upload file complete.');
                progressBar.removeClass('animating');

                if (hasCeleb) {
                    // Nếu CÓ người nổi tiếng -> Hiện loading AI
                    progressContainer.hide();
                    uploadMessage.hide();
                    recognitionLoading.show();
                    $('.btn-save').text('Running AI...');
                } else {
                    // Nếu KHÔNG CÓ -> Hiện thông báo đang lưu
                    $('#uploadMessage').html('<i class="fas fa-save"></i> Đang lưu video, vui lòng đợi...');
                    $('.btn-save').text('Saving...');
                }
            };

            // Nhận kết quả từ Server
            xhr.onload = function () {
                recognitionLoading.hide();
                if (xhr.status === 200) {
                    try {
                        // Nếu server trả về Redirect (JSON hoặc Header)
                        const response = JSON.parse(xhr.responseText);
                        if (response.redirectUrl) {
                            window.location.href = response.redirectUrl;
                        } else {
                            window.location.href = '/Channel/Index';
                        }
                    } catch (e) {
                        window.location.href = '/Channel/Index';
                    }
                } else {
                    resultContainer.html(`<p class="text-danger">Lỗi: ${xhr.statusText}</p>`);
                    $('.btn-save').prop('disabled', false).text('Save');
                }
            };

            xhr.onerror = function () {
                recognitionLoading.hide();
                resultContainer.html(`<p class="text-danger">Lỗi kết nối mạng.</p>`);
                $('.btn-save').prop('disabled', false).text('Save');
            };

            xhr.send(formData);
        });

        // Hủy upload
        $('#cancelUpload').on('click', function (e) {
            e.preventDefault();
            console.log('Upload cancelled by user');

            if (xhr) {
                xhr.abort();
            }

            $('#progressContainer').hide();
            $('#uploadMessage').hide();
            $('#recognitionLoading').hide();
            $('#resultContainer').html(`
                <p class="text-warning">
                    <i class="fas fa-times-circle"></i>
                    Upload đã bị hủy.
                </p>
            `);
            $('.btn-save').prop('disabled', false).text('Save');
        });

        // Format bytes helper function
        function formatBytes(bytes) {
            if (bytes === 0) return '0 KB';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        // Hủy upload
        $('#cancelUpload').on('click', function (e) {
            e.preventDefault();
            console.log('Upload cancelled by user');
            if (xhr) {
                xhr.abort();
            }
            $('#progressContainer').hide();
            $('#uploadMessage').hide();
            $('#recognitionLoading').hide();
            $('#resultContainer').html('<p class="text-warning"><i class="fas fa-times-circle"></i> Upload đã bị hủy.</p>');
            $('.btn-save').prop('disabled', false).text('Save');
        });

        // Format bytes
        function formatBytes(bytes) {
            if (bytes === 0) return '0 KB';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }
    </script>
}