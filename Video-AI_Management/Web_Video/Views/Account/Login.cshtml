@model Web_Video.ViewModels.Account.LoginViewModel
@{
    ViewData["CurrentPage"] = "Login";
}

<section class="login-main-wrapper">
    <div class="row no-gutters">
        <!-- Cột trái: Form đăng nhập -->
        <div class="col-md-5 p-5 bg-white full-height">
            <div class="login-main-left">
                <div class="text-center mb-5 login-main-left-header pt-4">
                    <a href="/" class="youtube-logo d-flex align-items-center justify-content-center text-decoration-none">
                        <i class="bi bi-youtube text-danger me-1" style="font-size: 32px;"></i>
                        <span class="fw-bold text-dark" style="font-size: 24px;">YouTube Clone</span>
                    </a>
                    <h5 class="mt-3 mb-3">Welcome to YouTube Clone</h5>
                    <p>It is a long established fact that a reader <br> will be distracted by the readable.</p>
                </div>
                <form asp-action="Login" method="post">
                    <input hidden type="text" asp-for="ReturnUrl" />
                    <div class="form-group">
                        <label asp-for="UserName">Tên người dùng hoặc Email</label>
                        <input asp-for="UserName" placeholder="Enter username or email" class="form-control" />
                        <span asp-validation-for="UserName" class="text-danger d-block mt-1" style="font-size: 14px;"></span>
                    </div>
                    <div class="form-group password-wrapper">
                        <label asp-for="Password">Mật khẩu</label>
                        <input asp-for="Password" type="password" placeholder="Password" class="form-control password-input" id="loginPassword" />
                        <span class="toggle-password" onclick="togglePassword('loginPassword')">
                            <i class="bi bi-eye-slash toggle-icon"></i>
                        </span>
                        <span asp-validation-for="Password" class="text-danger d-block mt-1" style="font-size: 14px;"></span>
                    </div>
                    <div class="form-group">
                        <div asp-validation-summary="All" class="text-danger" style="font-size: 14px;"></div>
                    </div>
                    <div class="mt-4">
                        <div class="row">
                            <div class="col-12">
                                <button type="submit" class="btn btn-outline-primary btn-block btn-lg">Đăng nhập</button>
                            </div>
                        </div>
                    </div>
                    <div class="text-center mt-5">
                        <p class="light-gray">Chưa có tài khoản? <a href="/Account/Register">Đăng ký ngay</a></p>
                    </div>
                </form>
            </div>
        </div>
        <!-- Cột phải: Carousel -->
        <div class="col-md-7">
            <div class="login-main-right bg-white p-5 mt-5 mb-5">
                <div class="owl-carousel owl-carousel-login">
                    <div class="item">
                        <div class="carousel-login-card text-center">
                            <img src="/img/login.png" class="img-fluid" alt="Watch videos offline">
                            <h5 class="mt-5 mb-3">Watch videos offline</h5>
                            <p class="mb-4">when an unknown printer took a galley of type and scrambled<br> it to make a type specimen book. It has survived not <br>only five centuries</p>
                        </div>
                    </div>
                    <div class="item">
                        <div class="carousel-login-card text-center">
                            <img src="/img/login.png" class="img-fluid" alt="Download videos">
                            <h5 class="mt-5 mb-3">Download videos effortlessly</h5>
                            <p class="mb-4">when an unknown printer took a galley of type and scrambled<br> it to make a type specimen book. It has survived not <br>only five centuries</p>
                        </div>
                    </div>
                    <div class="item">
                        <div class="carousel-login-card text-center">
                            <img src="/img/login.png" class="img-fluid" alt="Create GIFs">
                            <h5 class="mt-5 mb-3">Create GIFs</h5>
                            <p class="mb-4">when an unknown printer took a galley of type and scrambled<br> it to make a type specimen book. It has survived not <br>only five centuries</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="/vendor/owl-carousel/owl.carousel.js"></script>
    <script>
        function togglePassword(inputId) {
            const passwordInput = document.getElementById(inputId);
            const toggleIcon = passwordInput.nextElementSibling.querySelector('.toggle-icon');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            }
        }

        $(document).ready(function () {
            $('.owl-carousel-login').owlCarousel({
                loop: true,
                margin: 10,
                nav: false,
                dots: true,
                items: 1,
                autoplay: true,
                autoplayTimeout: 3000,
                autoplayHoverPause: true
            });
        });
    </script>
}

@section Css {
    <link rel="stylesheet" href="/vendor/owl-carousel/owl.carousel.css" />
    <link rel="stylesheet" href="/vendor/owl-carousel/owl.theme.css" />
    <style>
        .login-main-body {
            background-color: #f9f9f9;
        }

        .login-main-wrapper {
            min-height: 100vh;
        }

        .login-main-left {
            max-width: 400px;
            margin: 0 auto;
        }

        .login-main-left-header img {
            width: 60px;
            height: 60px;
        }

        .login-main-left-header h5 {
            font-size: 20px;
            font-weight: 600;
            color: #333;
        }

        .login-main-left-header p {
            font-size: 14px;
            color: #606060;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                font-size: 14px;
                font-weight: 500;
                color: #333;
                margin-bottom: 8px;
            }

        .form-control {
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 10px;
            font-size: 14px;
            height: auto;
        }

        .password-wrapper {
            position: relative;
        }

        .password-input {
            padding-right: 40px !important;
        }

        .toggle-password {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #606060;
            font-size: 16px;
        }

        .btn-outline-primary {
            border-color: #ff0000;
            color: #ff0000;
            font-weight: 500;
            font-size: 16px;
        }

            .btn-outline-primary:hover {
                background-color: #ff0000;
                color: #fff;
            }

        .light-gray {
            color: #606060;
            font-size: 14px;
        }

        .login-main-right {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .carousel-login-card img {
            width: 150px;
            margin: 0 auto;
        }

        .carousel-login-card h5 {
            font-size: 18px;
            font-weight: 600;
            color: #333;
        }

        .carousel-login-card p {
            font-size: 14px;
            color: #606060;
        }
    </style>
}