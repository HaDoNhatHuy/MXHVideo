<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - YouTube Clone</title>
    <!-- Favicon Icon -->
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <!-- Bootstrap core CSS-->
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom fonts for this template-->
    <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <!-- Custom styles for this template-->
    <link href="/css_new/osahan.css" rel="stylesheet" asp-append-version="true">
    <!-- Owl Carousel -->
    <link rel="stylesheet" href="/vendor/owl-carousel/owl.carousel.css">
    <link rel="stylesheet" href="/vendor/owl-carousel/owl.theme.css">
    @await RenderSectionAsync("Css", false)
    <style>
        #sidebarOverlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 998;
        }

            #sidebarOverlay.active {
                display: block;
            }

        .sidebar.hidden {
            display: none;
        }

        .youtube-content.full-width {
            width: 100%;
            padding-left: 0 !important;
        }

        #searchSuggestions {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: #fff;
            border: 1px solid #ddd;
            border-top: none;
            max-height: 200px;
            overflow-y: auto;
            display: none;
            z-index: 1000;
        }

        .suggestion-item {
            padding: 5px 10px;
            cursor: pointer;
        }

            .suggestion-item:hover {
                background-color: #f5f5f5;
            }

        #voiceSearchBtn.recording {
            background-color: #ff4444;
            color: #fff;
        }

        .dropdown-menu {
            z-index: 1000;
            min-width: 200px;
        }

        .dropdown-menu-right {
            right: 0;
            left: auto;
        }

        .user-dropdown-link {
            display: flex;
            align-items: center;
            color: #333;
        }

            .user-dropdown-link img {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                margin-right: 8px;
            }

        /* Đảm bảo modal hiển thị đúng */
        .modal {
            z-index: 1050;
        }

        .modal-backdrop {
            z-index: 1040;
        }
    </style>
</head>
<body id="page-top" data-page="@ViewData["CurrentPage"]">
    <div id="sidebarOverlay"></div>
    <nav class="navbar navbar-expand navbar-light bg-white static-top osahan-nav sticky-top">
        &nbsp;&nbsp;
        <button class="btn btn-link btn-sm text-secondary order-1 order-sm-0" id="toggleSidebarBtn">
            <i class="fas fa-bars"></i>
        </button> &nbsp;&nbsp;
        <a class="navbar-brand mr-1" asp-controller="Home" asp-action="Index"><img class="img-fluid" alt="" src="/img/logo.png"></a>
        <!-- Navbar Search -->
        <form class="d-none d-md-inline-block form-inline ml-auto mr-0 mr-md-5 my-2 my-md-0 osahan-navbar-search" id="searchForm" asp-controller="Search" asp-action="Index" method="get">
            <div class="input-group">
                <input type="text" class="form-control" id="searchInput" name="query" placeholder="Search for...">
                <div class="input-group-append">
                    <button class="btn btn-light" type="button" id="searchBtn">
                        <i class="fas fa-search"></i>
                    </button>
                    <button type="button" class="btn btn-light" id="voiceSearchBtn">
                        <i class="fas fa-microphone"></i>
                    </button>
                </div>
                <div id="searchSuggestions"></div>
            </div>
        </form>
        <!-- Navbar -->
        <ul class="navbar-nav ml-auto ml-md-0 osahan-right-navbar">
            <li class="nav-item mx-1">
                <a class="nav-link" asp-controller="Video" asp-action="CreateEditVideo">
                    <i class="fas fa-plus-circle fa-fw"></i>
                    Upload Video
                </a>
            </li>
            <li class="nav-item dropdown no-arrow mx-1">
                <a class="nav-link dropdown-toggle" href="#" id="alertsDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fas fa-bell fa-fw"></i>
                    <span class="badge badge-danger">9+</span>
                </a>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="alertsDropdown">
                    <a class="dropdown-item" href="#"><i class="fas fa-fw fa-edit"></i> &nbsp; Action</a>
                    <a class="dropdown-item" href="#"><i class="fas fa-fw fa-headphones-alt"></i> &nbsp; Another action</a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="#"><i class="fas fa-fw fa-star"></i> &nbsp; Something else here</a>
                </div>
            </li>
            <li class="nav-item dropdown no-arrow mx-1">
                <a class="nav-link dropdown-toggle" href="#" id="messagesDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fas fa-envelope fa-fw"></i>
                    <span class="badge badge-success">7</span>
                </a>
                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="messagesDropdown">
                    <a class="dropdown-item" href="#"><i class="fas fa-fw fa-edit"></i> &nbsp; Action</a>
                    <a class="dropdown-item" href="#"><i class="fas fa-fw fa-headphones-alt"></i> &nbsp; Another action</a>
                    <div class="dropdown-divider"></div>
                    <a class="dropdown-item" href="#"><i class="fas fa-fw fa-star"></i> &nbsp; Something else here</a>
                </div>
            </li>
            @if (User.Identity.IsAuthenticated)
            {
                <li class="nav-item dropdown no-arrow osahan-right-navbar-user">
                    <a class="nav-link dropdown-toggle user-dropdown-link" href="#" id="userDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <img alt="Avatar" src="/avatarUser/avt-default.jpg">
                        @User.Identity.Name
                    </a>
                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="userDropdown">
                        <a class="dropdown-item" asp-controller="Channel" asp-action="Index"><i class="fas fa-fw fa-user-circle"></i> &nbsp; My Account</a>
                        <a class="dropdown-item" asp-controller="Home" asp-action="Subscriptions"><i class="fas fa-fw fa-video"></i> &nbsp; Subscriptions</a>
                        <a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="fas fa-fw fa-cog"></i> &nbsp; Settings</a>
                        @if (User.IsInRole(SD.AdminRole))
                        {
                            <div class="dropdown-divider"></div>
                            <h6>Admin Panel</h6>
                            <a class="dropdown-item" asp-controller="Admin" asp-action="Category"><i class="fas fa-fw fa-list"></i> &nbsp; Category</a>
                            <a class="dropdown-item" asp-controller="Admin" asp-action="AddEditUser"><i class="fas fa-fw fa-user-shield"></i> &nbsp; User Management</a>
                            <a class="dropdown-item" asp-controller="Admin" asp-action="AllUsers"><i class="fas fa-fw fa-user-shield"></i> &nbsp; All User</a>                            
                        }
                        @if (User.IsInRole(SD.ModeratorRole))
                        {
                            <div class="dropdown-divider"></div>
                            <h6>Moderator Panel</h6>
                            <a class="dropdown-item" asp-controller="Moderator" asp-action="AllVideos"><i class="fas fa-fw fa-video"></i> &nbsp; Video Management</a>
                            <div class="dropdown-divider"></div>
                        }
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="#" data-toggle="modal" data-target="#logoutModal"><i class="fas fa-fw fa-sign-out-alt"></i> &nbsp; Logout</a>
                    </div>
                </li>
            }
            else
            {
                <li class="nav-item m-2">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-secondary border-none">Đăng nhập</a>
                </li>
            }
        </ul>
    </nav>
    <div id="wrapper" class="youtube-content">
        <!-- Sidebar -->
        <ul class="sidebar navbar-nav" id="sidebarMenu">
            <li class="nav-item @(ViewData["CurrentPage"] == "Home" ? "active" : "")">
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-fw fa-home"></i>
                    <span>Home</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-fw fa-file-video"></i>
                    <span>Shorts</span>
                </a>
            </li>
            @if (User.Identity.IsAuthenticated)
            {
                <li class="nav-item @(ViewData["CurrentPage"] == "Subscriptions" ? "active" : "")">
                    <a class="nav-link" asp-controller="Home" asp-action="Subscriptions">
                        <i class="fas fa-fw fa-chalkboard-teacher"></i>
                        <span>Subscriptions</span>
                    </a>
                </li>
                <li class="nav-item channel-sidebar-list">
                    <h6>YOU ></h6>
                </li>
                <li class="nav-item @(ViewData["CurrentPage"] == "History" ? "active" : "")">
                    <a class="nav-link" asp-controller="Home" asp-action="History">
                        <i class="fas fa-fw fa-history"></i>
                        <span>History</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Video" asp-action="CreateEditVideo">
                        <i class="fas fa-fw fa-list"></i>
                        <span>Playlists</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Video" asp-action="CreateEditVideo">
                        <i class="fas fa-fw fa-clock"></i>
                        <span>Watch Later</span>
                    </a>
                </li>
                <li class="nav-item @(ViewData["CurrentPage"] == "Liked" ? "active" : "")">
                    <a class="nav-link" asp-controller="Home" asp-action="Liked">
                        <i class="fas fa-fw fa-thumbs-up"></i>
                        <span>Like Videos</span>
                    </a>
                </li>
                <li class="nav-item channel-sidebar-list">
                    <h6>SUBSCRIPTIONS</h6>
                    <ul>
                        <li>
                            <a asp-controller="Subscriptions" asp-action="Index">
                                <img class="img-fluid" alt="" src="/img/s1.png"> Your Life
                            </a>
                        </li>
                    </ul>
                </li>
            }
            <li class="nav-item channel-sidebar-list">
                <h6>EXPLORE</h6>
                <ul>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Subscriptions" asp-action="Index">
                            <i class="fas fa-fw fa-music"></i> <span>Music</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Subscriptions" asp-action="Index">
                            <i class="fas fa-fw fa-gamepad"></i> <span>Gaming</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Subscriptions" asp-action="Index">
                            <i class="fas fa-fw fa-newspaper"></i> <span>News</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Subscriptions" asp-action="Index">
                            <i class="fas fa-fw fa-dumbbell"></i> <span>Sports</span>
                        </a>
                    </li>
                </ul>
            </li>
        </ul>
        <div id="content-wrapper">
            <div class="container-fluid pb-0">
                @RenderBody()
            </div>
        </div>
    </div>
    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>
    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Logout">Logout</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Bootstrap core JavaScript-->
    @* <script src="/vendor/jquery/jquery.min.js"></script> *@
    <!-- Bootstrap core JavaScript-->
    @* <script src="/lib/jquery/dist/jquery.min.js"></script> *@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>
    <!-- Owl Carousel -->
    <script src="/vendor/owl-carousel/owl.carousel.js"></script>
    <!-- Custom scripts for all pages-->
    <script src="/js_new/custom.js" asp-append-version="true"></script>   
    <script>
        $(document).ready(function () {
            const sidebar = $('#sidebarMenu');
            const content = $('.youtube-content');
            const toggleBtn = $('#toggleSidebarBtn');
            const overlay = $('#sidebarOverlay');

            // Kiểm tra trang hiện tại từ ViewData
            const currentPage = '@ViewData["CurrentPage"]';

            // Ẩn sidebar trên Watch, Login, Register ở màn hình lớn
            if (currentPage === 'Watch' || currentPage === 'Login' || currentPage === 'Register') {
                sidebar.addClass('hidden');
                content.addClass('full-width');
            } else {
                sidebar.removeClass('hidden');
                content.removeClass('full-width');
            }

            // Toggle sidebar
            toggleBtn.on('click', function () {
                if ($(window).width() >= 992) {
                    sidebar.toggleClass('hidden');
                    content.toggleClass('full-width');
                } else {
                    sidebar.toggleClass('active');
                    overlay.toggleClass('active');
                }
            });

            // Đóng sidebar trên mobile khi nhấn overlay
            overlay.on('click', function () {
                sidebar.removeClass('active');
                overlay.removeClass('active');
            });

            // Đóng sidebar khi click link trên mobile
            sidebar.find('.nav-link').on('click', function () {
                if ($(window).width() < 992) {
                    sidebar.removeClass('active');
                    overlay.removeClass('active');
                }
            });

            // Xử lý khi thay đổi kích thước màn hình
            $(window).on('resize', function () {
                if ($(window).width() >= 992) {
                    sidebar.removeClass('active');
                    overlay.removeClass('active');
                    if (currentPage === 'Watch' || currentPage === 'Login' || currentPage === 'Register') {
                        sidebar.addClass('hidden');
                        content.addClass('full-width');
                    } else {
                        sidebar.removeClass('hidden');
                        content.removeClass('full-width');
                    }
                } else {
                    sidebar.removeClass('hidden');
                    content.removeClass('full-width');
                }
            });

            // Xử lý gợi ý tìm kiếm
            const searchInput = document.getElementById('searchInput');
            const suggestionsContainer = document.getElementById('searchSuggestions');
            const searchBtn = document.getElementById('searchBtn');

            searchInput.addEventListener('input', async function () {
                const query = this.value.trim();
                if (query.length < 2) {
                    suggestionsContainer.style.display = 'none';
                    return;
                }

                try {
                    const response = await fetch(`/api/search/suggestions?q=${encodeURIComponent(query)}`);
                    const suggestions = await response.json();

                    if (suggestions.length > 0) {
                        suggestionsContainer.innerHTML = suggestions
                            .map(s => `<div class="p-2 suggestion-item" role="option">${s}</div>`)
                            .join('');
                        suggestionsContainer.style.display = 'block';
                    } else {
                        suggestionsContainer.style.display = 'none';
                    }
                } catch (error) {
                    console.error('Error fetching suggestions:', error);
                    suggestionsContainer.style.display = 'none';
                }
            });

            suggestionsContainer.addEventListener('click', function (e) {
                if (e.target.classList.contains('suggestion-item')) {
                    searchInput.value = e.target.textContent;
                    suggestionsContainer.style.display = 'none';
                    searchBtn.click();
                }
            });

            document.addEventListener('click', function (e) {
                if (!searchInput.contains(e.target) && !suggestionsContainer.contains(e.target)) {
                    suggestionsContainer.style.display = 'none';
                }
            });

            // Xử lý tìm kiếm bằng giọng nói
            const voiceSearchBtn = document.getElementById('voiceSearchBtn');
            voiceSearchBtn.addEventListener('click', function () {
                if (!('webkitSpeechRecognition' in window)) {
                    alert('Trình duyệt của bạn không hỗ trợ tìm kiếm bằng giọng nói');
                    return;
                }

                const recognition = new webkitSpeechRecognition();
                recognition.continuous = false;
                recognition.interimResults = false;
                recognition.lang = 'vi-VN';

                recognition.onstart = function () {
                    voiceSearchBtn.classList.add('recording');
                };

                recognition.onresult = function (event) {
                    const transcript = event.results[0][0].transcript;
                    searchInput.value = transcript;
                    voiceSearchBtn.classList.remove('recording');
                    searchBtn.click();
                };

                recognition.onerror = function (event) {
                    console.error('Voice recognition error:', event.error);
                    voiceSearchBtn.classList.remove('recording');
                    alert('Có lỗi khi nhận diện giọng nói');
                };

                recognition.onend = function () {
                    voiceSearchBtn.classList.remove('recording');
                };

                recognition.start();
            });

            // Xử lý tìm kiếm khi nhấn nút hoặc Enter
            window.getMyVideos = function () {
                const query = searchInput.value.trim();
                if (query) {
                    window.location.href = `/Search?query=${encodeURIComponent(query)}`;
                }
            };

            searchBtn.addEventListener('click', function () {
                getMyVideos();
            });

            searchInput.addEventListener('keypress', function (event) {
                if (event.key === 'Enter' || event.keyCode === 13) {
                    getMyVideos();
                }
            });

            // Debug click trên "Logout"
            $('[data-target="#logoutModal"]').on('click', function () {
                console.log('Logout item clicked');
                $('#logoutModal').modal('show');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>