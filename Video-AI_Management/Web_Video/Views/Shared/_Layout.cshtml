<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - YouTube Clone</title>
    <!-- Favicon Icon -->
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <!-- Bootstrap core CSS-->
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <!-- Custom fonts for this template-->
    <link href="/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <!-- Custom styles for this template-->
    @* <link href="/css_new/osahan.css" rel="stylesheet" asp-append-version="true"> *@
    <link href="/css_new/youtube-theme.css" rel="stylesheet" asp-append-version="true">
    @* <link href="/css/site.css" rel="stylesheet" asp-append-version="true"> *@
    <!-- Owl Carousel -->
    @* <link rel="stylesheet" href="/vendor/owl-carousel/owl.carousel.css"> *@
    @* <link rel="stylesheet" href="/vendor/owl-carousel/owl.theme.css"> *@
    @await RenderSectionAsync("Css", false)
    <style>
        /* ========================================
           YOUTUBE MODERN THEME - LAYOUT STYLES
           ======================================== */

        :root {
            --yt-black: #0f0f0f;
            --yt-dark-bg: #0f0f0f;
            --yt-sidebar-bg: #0f0f0f;
            --yt-hover-bg: #272727;
            --yt-hover-bg-secondary: #eee;
            --yt-text-primary: #f1f1f1;
            --yt-text-secondary: #aaaaaa;
            --yt-text-black: #0f0f0f;
            --yt-border: #3f3f3f;
            --yt-blue: #3ea6ff;
            --yt-white: #ffffff;
            --yt-header-height: 56px;
            --yt-sidebar-width: 240px;
            --yt-sidebar-collapsed: 72px;
        }

        /* === BODY & MAIN LAYOUT === */
        body {
            /* background-color: var(--yt-dark-bg); */
            background-color: var(--yt-white);
            color: var(--yt-text-primary);
            font-family: "Roboto", Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        #wrapper {
            display: flex;
            min-height: calc(100vh - var(--yt-header-height));
            padding-top: var(--yt-header-height);
        }

        /* === HEADER/NAVBAR === */
        .navbar.osahan-nav {
            background-color: var(--yt-white) !important;
            /* border-bottom: 1px solid var(--yt-border); */
            height: var(--yt-header-height);
            padding: 0 16px;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .navbar .navbar-brand img {
            height: 20px;
            width: auto;
        }

        .navbar #toggleSidebarBtn {
            color: var(--yt-text-primary);
            background: transparent;
            border: none;
            padding: 8px;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .navbar #toggleSidebarBtn:hover {
                background-color: var(--yt-hover-bg-secondary);
            }

        /* === SEARCH BAR === */
        .osahan-navbar-search {
            flex: 0 1 732px;
            max-width: 732px;
            margin: 0 auto;
        }

            .osahan-navbar-search .input-group {
                background: transparent;
                border: 1px solid #ccc;
                border-radius: 40px;
                overflow: hidden;
                height: 40px;
            }

            .osahan-navbar-search .form-control {
                background-color: transparent;
                border: none;
                color: var(--yt-text-primary);
                padding: 0 16px;
                height: 100%;
                font-size: 16px;
            }

                .osahan-navbar-search .form-control:focus {
                    outline: none;
                    box-shadow: none;
                    border: none;
                }

                .osahan-navbar-search .form-control::placeholder {
                    color: var(--yt-text-secondary);
                }

            .osahan-navbar-search .input-group-append {
                display: flex;
            }

            .osahan-navbar-search .btn {
                background-color: var(--yt-hover-bg-secondary);
                border: none;
                color: var(--yt-black);
                padding: 0 20px;
                border-radius: 0;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .osahan-navbar-search .btn:hover {
                    background-color: #3f3f3f;
                }

                .osahan-navbar-search .btn:first-child {
                    border-left: 1px solid var(--yt-border);
                }

        /* === NAVBAR RIGHT === */
        .osahan-right-navbar {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .osahan-right-navbar .nav-link {
                color: var(--yt-text-primary);
                padding: 8px;
                border-radius: 50%;
                width: 40px;
                height: 40px;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
            }

                .osahan-right-navbar .nav-link:hover {
                    background-color: var(--yt-hover-bg-secondary);
                }

            .osahan-right-navbar .badge {
                position: absolute;
                top: 4px;
                right: 4px;
                font-size: 10px;
                padding: 2px 5px;
            }

        .user-dropdown-link img {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            object-fit: cover;
        }

        /* === SIDEBAR === */
        .sidebar {
            width: var(--yt-sidebar-width);
            background-color: var(--yt-white);
            height: calc(100vh - var(--yt-header-height));
            position: fixed;
            top: var(--yt-header-height);
            left: 0;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 12px 0;
            transition: transform 0.3s ease, width 0.3s ease;
            z-index: 999;
        }

            .sidebar::-webkit-scrollbar {
                width: 8px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background-color: var(--yt-border);
                border-radius: 4px;
            }

            .sidebar.hidden {
                width: var(--yt-sidebar-collapsed);
            }

            .sidebar .nav-item {
                list-style: none;
            }

            .sidebar .nav-link {
                display: flex;
                align-items: center;
                padding: 10px 24px;
                color: var(--yt-text-black);
                text-decoration: none;
                border-radius: 10px;
                margin: 0 12px 4px 12px;
                font-size: 14px;
                font-weight: 500;
                transition: background-color 0.2s;
            }

                .sidebar .nav-link:hover {
                    background-color: var(--yt-hover-bg-secondary);
                }

                .sidebar .nav-link i {
                    font-size: 20px;
                    margin-right: 24px;
                    width: 24px;
                    text-align: center;
                }

            .sidebar .nav-item.active .nav-link {
                background-color: var(--yt-hover-bg-secondary);
                font-weight: 600;
            }

            .sidebar.hidden .nav-link span {
                display: none;
            }

            .sidebar.hidden .nav-link {
                justify-content: center;
                padding: 16px 0;
            }

                .sidebar.hidden .nav-link i {
                    margin-right: 0;
                }

            .sidebar h6 {
                color: var(--yt-text-secondary);
                font-size: 14px;
                font-weight: 600;
                padding: 8px 24px;
                margin: 16px 0 8px 0;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .sidebar.hidden h6 {
                display: none;
            }

        /* Channel subscription list */
        .channel-sidebar-list ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .channel-sidebar-list ul li a img {
                width: 24px;
                height: 24px;
                border-radius: 50%;
                margin-right: 12px;
                object-fit: cover;
            }

        /* === CONTENT AREA === */
        #content-wrapper {
            flex: 1;
            /* margin-left: var(--yt-sidebar-width); */
            /* padding: 24px; */
            background-color: var(--yt-white);
            transition: margin-left 0.3s ease;
        }

        .youtube-content.full-width #content-wrapper {
            margin-left: var(--yt-sidebar-collapsed);
        }

        /* === RESPONSIVE === */
       @@media (max-width: 992px) {
            .sidebar

        {
            transform: translateX(-100%);
        }

        .sidebar.active {
            transform: translateX(0);
        }

        #content-wrapper {
            margin-left: 0;
        }

        .osahan-navbar-search {
            max-width: 100%;
        }

        }

        @@media (max-width: 768px) {
            .navbar

        {
            padding: 0 8px;
        }

        .osahan-navbar-search {
            display: none !important;
        }

        #content-wrapper {
            padding: 16px 8px;
        }

        }
    </style>
</head>
