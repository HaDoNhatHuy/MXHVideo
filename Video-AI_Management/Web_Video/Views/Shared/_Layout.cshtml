                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Category" asp-action="Index" asp-route-categoryId="@Guid.Parse("DD488F44-3BCE-4D02-998B-DF48B22B7AED")">
                            <i class="fas fa-fw fa-gamepad"></i> <span>Gaming</span>
                        </a>
                    </li>
                    <li class="nav-item">
