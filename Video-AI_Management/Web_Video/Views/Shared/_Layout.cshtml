    </div>
    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>
    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Logout">Logout</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Bootstrap core JavaScript-->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>
    <!-- Owl Carousel -->
    <script src="/vendor/owl-carousel/owl.carousel.js"></script>
    <!-- Custom scripts for all pages-->
    <script src="/js_new/custom.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            console.log('Document ready, loadingIndicator display:', $('#loadingIndicator').css('display')); // Debug trạng thái ban đầu

            const sidebar = $('#sidebarMenu');
            const content = $('.youtube-content');
            const toggleBtn = $('#toggleSidebarBtn');
            const overlay = $('#sidebarOverlay');
            const subscriptionsList = $('#subscriptionsList');

            // Kiểm tra trạng thái xác thực người dùng
            const isAuthenticated = @Json.Serialize(User.Identity.IsAuthenticated);

            // Kiểm tra trang hiện tại từ ViewData
            const currentPage = '@ViewData["CurrentPage"]';

            // Biến để theo dõi trang hiện tại của subscriptions
            let currentSubPage = 1;
            let totalSubPages = 1;

            // Ẩn sidebar trên Watch, Login, Register ở màn hình lớn
            if (currentPage === 'Watch' || currentPage === 'Login' || currentPage === 'Register') {
                sidebar.addClass('hidden');
                content.addClass('full-width');
            } else {
                sidebar.removeClass('hidden');
                content.removeClass('full-width');
            }

            // Toggle sidebar
            toggleBtn.on('click', function () {
                if ($(window).width() >= 992) {
                    sidebar.toggleClass('hidden');
                    content.toggleClass('full-width');
                } else {
                    sidebar.toggleClass('active');
                    overlay.toggleClass('active');
                }
            });

            // Đóng sidebar trên mobile khi nhấn overlay
            overlay.on('click', function () {
                sidebar.removeClass('active');
                overlay.removeClass('active');
            });

            // Đóng sidebar khi click link trên mobile
            sidebar.find('.nav-link').on('click', function () {
                if ($(window).width() < 992) {
                    sidebar.removeClass('active');
                    overlay.removeClass('active');
                }
            });

            // Xử lý khi thay đổi kích thước màn hình
            $(window).on('resize', function () {
                if ($(window).width() >= 992) {
                    sidebar.removeClass('active');
                    overlay.removeClass('active');
                    if (currentPage === 'Watch' || currentPage === 'Login' || currentPage === 'Register') {
                        sidebar.addClass('hidden');
                        content.addClass('full-width');
                    } else {
                        sidebar.removeClass('hidden');
                        content.removeClass('full-width');
                    }
                } else {
                    sidebar.removeClass('hidden');
                    content.removeClass('full-width');
                }
            });

            // Load danh sách kênh đăng ký
            if (isAuthenticated) {
                console.log('User is authenticated, loading subscriptions');
                loadSubscriptions();
            }

            function loadSubscriptions(page = 1) {
                console.log('Loading subscriptions, page:', page);
                $.ajax({
                    url: `/Home/GetSubscriptions?pageNumber=${page}&pageSize=5`,
                    type: 'GET',
                    success: function (response) {
                        console.log('Subscriptions API response:', response);
                        if (response.statusCode === 200 && response.result && response.result.items) {
                            const items = response.result.items;
                            totalSubPages = response.result.totalPages || 1;
                            currentSubPage = response.result.currentPage || page;

                            if (page === 1) {
                                subscriptionsList.empty();
                            }

                            if (items.length === 0 && page === 1) {
                                subscriptionsList.append('<li><span>No subscriptions found</span></li>');
                            } else {
                                items.forEach(item => {
                                    const channelItem = `
                                        <li>
                                            <a href="/Member/Channel/${item.id}">
                                                <img class="img-fluid" alt="${item.channelName}" src="${item.channelPicture}">
                                                ${item.channelName}
                                            </a>
                                        </li>`;
                                    subscriptionsList.append(channelItem);
                                });
                            }

                            // Thêm hoặc cập nhật nút "Xem thêm"
                            const existingLoadMore = subscriptionsList.find('.load-more-btn');
                            if (existingLoadMore.length > 0) {
                                existingLoadMore.remove();
                            }

                            if (currentSubPage < totalSubPages) {
                                subscriptionsList.append(`
                                    <li class="load-more-btn">
                                        <i class="fas fa-angle-down"></i> Xem thêm
                                    </li>
                                `);
                                subscriptionsList.find('.load-more-btn').on('click', function () {
                                    loadSubscriptions(currentSubPage + 1);
                                });
                            }
                        } else {
                            console.error('Invalid response format:', response);
                            subscriptionsList.append('<li><span>Error loading subscriptions</span></li>');
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('Error loading subscriptions:', error);
                        subscriptionsList.append('<li><span>Error loading subscriptions</span></li>');
                    }
                });
            }

            // Xử lý gợi ý tìm kiếm
            const searchInput = document.getElementById('searchInput');
            const suggestionsContainer = document.getElementById('searchSuggestions');
            const searchBtn = document.getElementById('searchBtn');

            searchInput.addEventListener('input', async function () {
                const query = this.value.trim();
                if (query.length < 2) {
                    suggestionsContainer.style.display = 'none';
                    return;
                }

                try {
                    const response = await fetch(`/api/search/suggestions?q=${encodeURIComponent(query)}`);
                    const suggestions = await response.json();

                    if (suggestions.length > 0) {
                        suggestionsContainer.innerHTML = suggestions
                            .map(s => `<div class="p-2 suggestion-item" role="option">${s}</div>`)
                            .join('');
                        suggestionsContainer.style.display = 'block';
                    } else {
                        suggestionsContainer.style.display = 'none';
                    }
                } catch (error) {
                    console.error('Error fetching suggestions:', error);
                    suggestionsContainer.style.display = 'none';
                }
            });

            suggestionsContainer.addEventListener('click', function (e) {
                if (e.target.classList.contains('suggestion-item')) {
                    searchInput.value = e.target.textContent;
                    suggestionsContainer.style.display = 'none';
                    searchBtn.click();
                }
            });

            document.addEventListener('click', function (e) {
                if (!searchInput.contains(e.target) && !suggestionsContainer.contains(e.target)) {
                    suggestionsContainer.style.display = 'none';
                }
            });

            // Xử lý tìm kiếm bằng giọng nói
            const voiceSearchBtn = document.getElementById('voiceSearchBtn');
            voiceSearchBtn.addEventListener('click', function () {
                if (!('webkitSpeechRecognition' in window)) {
                    alert('Trình duyệt của bạn không hỗ trợ tìm kiếm bằng giọng nói');
                    return;
                }

                const recognition = new webkitSpeechRecognition();
                recognition.continuous = false;
                recognition.interimResults = false;
                recognition.lang = 'vi-VN';

                recognition.onstart = function () {
                    voiceSearchBtn.classList.add('recording');
                };

                recognition.onresult = function (event) {
                    const transcript = event.results[0][0].transcript;
                    searchInput.value = transcript;
                    voiceSearchBtn.classList.remove('recording');
                    searchBtn.click();
                };

                recognition.onerror = function (event) {
                    console.error('Voice recognition error:', event.error);
                    voiceSearchBtn.classList.remove('recording');
                    alert('Có lỗi khi nhận diện giọng nói');
                };

                recognition.onend = function () {
                    voiceSearchBtn.classList.remove('recording');
                };

                recognition.start();
            });

            // Xử lý tìm kiếm khi nhấn nút hoặc Enter
            window.getMyVideos = function () {
                const query = searchInput.value.trim();
                if (query) {
                    window.location.href = `/Search?query=${encodeURIComponent(query)}`;
                }
            };

            searchBtn.addEventListener('click', function () {
                getMyVideos();
            });

            searchInput.addEventListener('keypress', function (event) {
                if (event.key === 'Enter' || event.keyCode === 13) {
                    getMyVideos();
                }
            });

            // Xử lý tìm kiếm bằng hình ảnh
            const imageUpload = $('#imageUpload');
            const selectImageBtn = $('#selectImageBtn');
            const submitImageBtn = $('#submitImageBtn');
            const dropzone = $('#dropzone');
            const previewContainer = $('#previewContainer');
            const previewImage = $('#previewImage');

            // Mở trình chọn file khi nhấp vào nút "Chọn ảnh"
            selectImageBtn.on('click', function () {
                console.log('Select image button clicked');
                imageUpload.click();
            });

            // Xử lý khi chọn file
            imageUpload.on('change', function (e) {
                console.log('Image selected via input');
                handleImageSelect(e.target.files);
            });

            // Xử lý kéo thả
            dropzone.on('dragover', function (e) {
                e.preventDefault();
                e.stopPropagation();
                dropzone.addClass('dragover');
                console.log('Dragover on dropzone');
            });

            dropzone.on('dragleave', function (e) {
                e.preventDefault();
                e.stopPropagation();
                dropzone.removeClass('dragover');
                console.log('Dragleave on dropzone');
            });

            dropzone.on('drop', function (e) {
                e.preventDefault();
                e.stopPropagation();
                dropzone.removeClass('dragover');
                const files = e.originalEvent.dataTransfer.files;
                console.log('Image dropped:', files);
                handleImageSelect(files);
            });

            // Hàm xử lý file ảnh
            function handleImageSelect(files) {
                if (files && files.length > 0) {
                    const file = files[0];
                    if (!file.type.startsWith('image/')) {
                        alert('Vui lòng chọn một file ảnh (jpg, jpeg, png).');
                        return;
                    }
                    // Hiển thị ảnh xem trước
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        previewImage.attr('src', e.target.result);
                        previewContainer.show();
                        submitImageBtn.prop('disabled', false);
                        console.log('Image preview loaded');
                    };
                    reader.readAsDataURL(file);
                    // Copy file sang input ẩn
                    document.getElementById('hiddenImageInput').files = files;
                }
            }

            // Submit form khi nhấn nút tìm kiếm
            submitImageBtn.on('click', function () {
                if (!document.getElementById('hiddenImageInput').files.length) {
                    alert('Vui lòng chọn một ảnh trước khi tìm kiếm.');
                    return;
                }
                console.log('Submit image search');
                $('#loadingIndicator').show();
                $('#imageSearchModal').modal('hide');
                document.getElementById('imageSearchForm').submit();
            });

            // Ngăn submit form ngoài ý muốn và debug
            $('#imageSearchForm').on('submit', function (e) {
                console.log('imageSearchForm submitting');
                $('#loadingIndicator').show(); // Đảm bảo chỉ hiển thị khi submit
            });

            // Debug click trên "Logout"
            $('[data-target="#logoutModal"]').on('click', function () {
                console.log('Logout item clicked');
                $('#logoutModal').modal('show');
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>