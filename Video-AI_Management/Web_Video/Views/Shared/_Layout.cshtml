                            <i class="fas fa-fw fa-newspaper"></i> <span>News</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Category" asp-action="Index" asp-route-categoryId="@Guid.Parse("B0B863E6-E86C-40A8-9AA1-230122EEFC61")">
