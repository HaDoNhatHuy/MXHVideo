    <!-- Scroll to Top Button-->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>
    <!-- Logout Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="logoutModalLabel">
        <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" style="color:black;">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" asp-controller="Account" asp-action="Logout">Logout</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Bootstrap core JavaScript-->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- Core plugin JavaScript-->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>
    <!-- Owl Carousel -->
    @* <script src="/vendor/owl-carousel/owl.carousel.js"></script> *@
    <!-- Custom scripts for all pages-->
    @* <script src="/js_new/custom.js" asp-append-version="true"></script> *@
    <script>
        $(document).ready(function () {
            console.log('Document ready - Script bắt đầu chạy');

            // Ẩn loading indicator ngay từ đầu
            $('#loadingIndicator').hide().removeClass('active');

            // === BIẾN CƠ BẢN ===
            const sidebar = $('#sidebarMenu');
            const content = $('.youtube-content');
            const toggleBtn = $('#toggleSidebarBtn');
            const overlay = $('#sidebarOverlay');
            const subscriptionsList = $('#subscriptionsList');
            const isAuthenticated = @Json.Serialize(User.Identity.IsAuthenticated);
            const currentPage = '@ViewData["CurrentPage"]';

            let currentSubPage = 1;
            let totalSubPages = 1;

            // === ẨN/HIỆN SIDEBAR THEO TRANG ===
            if (currentPage === 'Watch' || currentPage === 'Login' || currentPage === 'Register') {
                sidebar.addClass('hidden');
                content.addClass('full-width');
            } else {
                sidebar.removeClass('hidden');
                content.removeClass('full-width');
            }

            // === NÚT MỞ/ĐÓNG SIDEBAR ===
            toggleBtn.on('click', function () {
                if ($(window).width() >= 992) {
                    sidebar.toggleClass('hidden');
                    content.toggleClass('full-width');
                } else {
                    sidebar.toggleClass('active');
                    overlay.toggleClass('active');
                }
            });

            // === ĐÓNG SIDEBAR KHI NHẤN NỀN ĐEN (MOBILE) ===
            overlay.on('click', function () {
                sidebar.removeClass('active');
                overlay.removeClass('active');
            });

            // === ĐÓNG SIDEBAR KHI NHẤN LINK (MOBILE) ===
            sidebar.find('.nav-link').on('click', function () {
                if ($(window).width() < 992) {
                    sidebar.removeClass('active');
                    overlay.removeClass('active');
                }
            });

            // === KHI THAY ĐỔI KÍCH THƯỚC MÀN HÌNH ===
            $(window).on('resize', function () {
                if ($(window).width() >= 992) {
                    sidebar.removeClass('active');
                    overlay.removeClass('active');
                    if (currentPage === 'Watch' || currentPage === 'Login' || currentPage === 'Register') {
                        sidebar.addClass('hidden');
                        content.addClass('full-width');
                    } else {
                        sidebar.removeClass('hidden');
                        content.removeClass('full-width');
                    }
                } else {
                    sidebar.removeClass('hidden');
                    content.removeClass('full-width');
                }
            });

            // === LOAD DANH SÁCH KÊNH ĐĂNG KÝ ===
            if (isAuthenticated) {
                console.log('Đang tải danh sách kênh đăng ký...');
                loadSubscriptions();
            }

            function loadSidebarSubscriptions() {
            // Chỉ tải 5 kênh đầu tiên cho Sidebar
            $.ajax({
                url: `/Home/GetSubscriptions?pageNumber=1&pageSize=5`,
                type: 'GET',
                success: function (response) {
                    // Kiểm tra kỹ cấu trúc response để tránh lỗi null
                    if (response.statusCode === 200 && response.result && response.result.items) {
                        const items = response.result.items;
                        subscriptionsList.empty(); // Xóa list cũ

                        if (items.length === 0) {
                            subscriptionsList.append('<li class="nav-item"><span class="nav-link">Chưa đăng ký kênh nào</span></li>');
                        } else {
                            items.forEach(item => {
                                const channelItem = `
                                <li class="nav-item">
                                    <a class="nav-link" href="/Member/Channel/${item.id}">
                                        <img class="img-fluid rounded-circle mr-2" alt="${item.channelName}" src="${item.thumbnail || '/avatarUser/avt-default.jpg'}"
                                        style="width:24px;height:24px;object-fit:cover;">
                                        <span>${item.channelName}</span>
                                    </a>
                                </li>`;
                                subscriptionsList.append(channelItem);
                            });

                            // Link xem tất cả
                            subscriptionsList.append(`
                                <li class="nav-item">
                                    <a class="nav-link" href="/Home/Subscriptions">
                                        <i class="fas fa-angle-down mr-2"></i>
                                        <span>Xem tất cả</span>
                                    </a>
                                </li>
                            `);
                        }
                    }
                },
                error: function () {
                    console.log("Không tải được danh sách đăng ký (Sidebar)");
                }
            });
        }

            // === TÌM KIẾM GỢI Ý ===
            const searchInput = document.getElementById('searchInput');
            const suggestionsContainer = document.getElementById('searchSuggestions');
            const searchBtn = document.getElementById('searchBtn');

            searchInput.addEventListener('input', async function () {
                const query = this.value.trim();
                if (query.length < 2) {
                    suggestionsContainer.style.display = 'none';
                    return;
                }

                try {
                    const response = await fetch(`/api/search/suggestions?q=${encodeURIComponent(query)}`);
                    const suggestions = await response.json();

                    if (suggestions.length > 0) {
                        suggestionsContainer.innerHTML = suggestions
                            .map(s => `<div class="p-2 suggestion-item" style="cursor:pointer;">${s}</div>`)
                            .join('');
                        suggestionsContainer.style.display = 'block';
                    } else {
                        suggestionsContainer.style.display = 'none';
                    }
                } catch (error) {
                    suggestionsContainer.style.display = 'none';
                }
            });

            suggestionsContainer.addEventListener('click', function (e) {
                if (e.target.classList.contains('suggestion-item')) {
                    searchInput.value = e.target.textContent;
                    suggestionsContainer.style.display = 'none';
                    searchBtn.click();
                }
            });

            document.addEventListener('click', function (e) {
                if (!searchInput.contains(e.target) && !suggestionsContainer.contains(e.target)) {
                    suggestionsContainer.style.display = 'none';
                }
            });

            // === TÌM KIẾM BẰNG GIỌNG NÓI ===
            const voiceSearchBtn = document.getElementById('voiceSearchBtn');
            voiceSearchBtn.addEventListener('click', function () {
                if (!('webkitSpeechRecognition' in window)) {
                    alert('Trình duyệt không hỗ trợ giọng nói');
                    return;
                }

                const recognition = new webkitSpeechRecognition();
                recognition.lang = 'vi-VN';
                recognition.continuous = false;

                recognition.onstart = () => voiceSearchBtn.classList.add('recording');
                recognition.onresult = (event) => {
                    searchInput.value = event.results[0][0].transcript;
                    voiceSearchBtn.classList.remove('recording');
                    searchBtn.click();
                };
                recognition.onerror = () => {
                    voiceSearchBtn.classList.remove('recording');
                    alert('Lỗi nhận diện giọng nói');
                };
                recognition.onend = () => voiceSearchBtn.classList.remove('recording');

                recognition.start();
            });

            // === TÌM KIẾM KHI NHẤN NÚT HOẶC ENTER ===
            window.getMyVideos = function () {
                const query = searchInput.value.trim();
                if (query) {
                    window.location.href = `/Search?query=${encodeURIComponent(query)}`;
                }
            };

            searchBtn.addEventListener('click', getMyVideos);
            searchInput.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') getMyVideos();
            });

            // === HIỂN THỊ / ẨN LOADING ===
            function showLoading() {
                const indicator = document.getElementById('loadingIndicator');
                indicator.style.display = 'flex';
                indicator.classList.add('active');
            }

            function hideLoading() {
                const indicator = document.getElementById('loadingIndicator');
                if (indicator) { // Thêm kiểm tra null
                    indicator.classList.remove('active');
                    setTimeout(() => {
                        indicator.style.display = 'none';
                    }, 300);
                }
            }

            // === TÌM KIẾM BẰNG HÌNH ẢNH ===
            const imageUpload = $('#imageUpload');
            const selectImageBtn = $('#selectImageBtn');
            const submitImageBtn = $('#submitImageBtn');
            const dropzone = $('#dropzone');
            const previewContainer = $('#previewContainer');
            const previewImage = $('#previewImage');
            const removeImageBtn = $('#removeImageBtn');

            selectImageBtn.on('click', () => imageUpload.click());

            imageUpload.on('change', function (e) {
                handleImageSelect(e.target.files);
            });

            dropzone.on('dragover', function (e) {
                e.preventDefault();
                dropzone.addClass('dragover');
            });

            dropzone.on('dragleave', function (e) {
                e.preventDefault();
                dropzone.removeClass('dragover');
            });

            dropzone.on('drop', function (e) {
                e.preventDefault();
                dropzone.removeClass('dragover');
                handleImageSelect(e.originalEvent.dataTransfer.files);
            });

            function handleImageSelect(files) {
                if (!files || files.length === 0) return;

                const file = files[0];
                if (!file.type.startsWith('image/')) {
                    alert('Vui lòng chọn file ảnh!');
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (e) {
                    previewImage.attr('src', e.target.result);
                    previewContainer.addClass('show');
                    submitImageBtn.prop('disabled', false);
                    document.getElementById('hiddenImageInput').files = files;
                };
                reader.readAsDataURL(file);
            }

            removeImageBtn.on('click', function () {
                previewContainer.removeClass('show');
                submitImageBtn.prop('disabled', true);
                imageUpload.val('');
                document.getElementById('hiddenImageInput').files = null;
            });

            submitImageBtn.on('click', function () {
                if (!document.getElementById('hiddenImageInput').files.length) {
                    alert('Vui lòng chọn ảnh!');
                    return;
                }
                showLoading();
                $('#imageSearchModal').modal('hide');
                document.getElementById('imageSearchForm').submit();
            });

            $('#imageSearchForm').on('submit', showLoading);
            window.addEventListener('load', hideLoading);

            // === FIX: XÓA BACKDROP KHI ĐÓNG MODAL ===
            $(document).on('hidden.bs.modal', '.modal', function () {
                $('.modal-backdrop').remove();
                $('body').removeClass('modal-open').css({
                    overflow: '',
                    paddingRight: ''
                });
            });

            // === LOGOUT MODAL – CHỈ DÙNG 1 LẦN ===
            $('#logoutModal').on('shown.bs.modal', function () {
                $(this).find('[data-dismiss="modal"]').focus();
            });

            // === ĐÓNG MODAL KHI NHẤN ESC ===
            $(document).on('keydown', function (e) {
                if (e.key === 'Escape') {
                    $('.modal.show').modal('hide');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>